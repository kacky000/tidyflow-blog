</style>

<script>
  const initialInput = document.getElementById('initial-investment') as HTMLInputElement;
  const monthlyInput = document.getElementById('monthly-contribution') as HTMLInputElement;
  const returnInput = document.getElementById('annual-return') as HTMLInputElement;
  const yearsInput = document.getElementById('invest-years') as HTMLInputElement;
  const resultsSection = document.getElementById('results-section')!;

  function formatCurrency(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function calculate() {
    const initial = parseFloat(initialInput.value) || 0;
    const monthly = parseFloat(monthlyInput.value) || 0;
    const annualReturn = parseFloat(returnInput.value) || 0;
    const years = parseInt(yearsInput.value) || 0;

    if (years <= 0 || (initial <= 0 && monthly <= 0)) {
      resultsSection.style.display = 'none';
      return;
    }

    resultsSection.style.display = 'block';

    const monthlyRate = annualReturn / 100 / 12;
    const totalMonths = years * 12;

    // Build year-by-year data
    const yearData: { year: number; startBalance: number; contributions: number; interest: number; endBalance: number }[] = [];
    let balance = initial;
    let totalContributions = initial;
    let totalInterest = 0;

    for (let y = 1; y <= years; y++) {
      const startBalance = balance;
      let yearContributions = 0;
      let yearInterest = 0;

      for (let m = 0; m < 12; m++) {
        const interest = balance * monthlyRate;
        yearInterest += interest;
        balance += interest + monthly;
        yearContributions += monthly;
      }

      totalContributions += yearContributions;
      totalInterest += yearInterest;

      yearData.push({
        year: y,
        startBalance: startBalance,
        contributions: yearContributions,
        interest: yearInterest,
        endBalance: balance
      });
    }

    const totalValue = balance;
    const contribTotal = initial + monthly * totalMonths;
    const returnsTotal = totalValue - contribTotal;

    // Stats
    document.getElementById('stat-total')!.textContent = formatCurrency(Math.round(totalValue));
    document.getElementById('stat-contributions')!.textContent = formatCurrency(Math.round(contribTotal));
    document.getElementById('stat-returns')!.textContent = formatCurrency(Math.round(returnsTotal));

    // Growth bar
    const contribPct = totalValue > 0 ? (contribTotal / totalValue) * 100 : 50;
    const returnPct = 100 - contribPct;
    const contribBar = document.getElementById('growth-bar-contrib') as HTMLElement;
    const returnBar = document.getElementById('growth-bar-return') as HTMLElement;
    contribBar.style.width = Math.max(contribPct, 8) + '%';
    returnBar.style.width = Math.max(returnPct, 8) + '%';
    document.getElementById('growth-bar-contrib-label')!.textContent = 'Contributions ' + formatCurrency(Math.round(contribTotal));
    document.getElementById('growth-bar-return-label')!.textContent = 'Returns ' + formatCurrency(Math.round(returnsTotal));

    // Year-by-year table
    const tbody = document.getElementById('year-tbody')!;
    const isMilestone = (y: number) => y === 1 || y === years || y === Math.round(years / 2) || y % 10 === 0;

    tbody.innerHTML = yearData.map(row => {
      const highlight = isMilestone(row.year) ? 'highlight-row' : '';
      return `<tr class="${highlight}">
        <td>${row.year}</td>
        <td>${formatCurrency(Math.round(row.startBalance))}</td>
        <td>${formatCurrency(Math.round(row.contributions))}</td>
        <td>${formatCurrency(Math.round(row.interest))}</td>
        <td>${formatCurrency(Math.round(row.endBalance))}</td>
      </tr>`;
    }).join('');

    // Tip
    const tipCard = document.getElementById('tip-card')!;
    const tipText = document.getElementById('tip-text')!;
    tipCard.style.display = 'flex';

    if (returnsTotal > contribTotal) {
      tipText.innerHTML = `Your investment returns (<strong>${formatCurrency(Math.round(returnsTotal))}</strong>) exceed your total contributions (<strong>${formatCurrency(Math.round(contribTotal))}</strong>). This is the power of compound interest — your money is working harder than you are.`;
    } else if (years < 10) {
      const extraYears = 10;
      let extraBalance = balance;
      for (let m = 0; m < extraYears * 12; m++) {
        extraBalance = extraBalance * (1 + monthlyRate) + monthly;
      }
      tipText.innerHTML = `If you extend your investment period by ${extraYears} more years, your balance could grow to <strong>${formatCurrency(Math.round(extraBalance))}</strong>. Time is your greatest asset in investing.`;
    } else if (monthly > 0) {
      const doubleMonthly = monthly * 2;
      let doubleBalance = initial;
      for (let m = 0; m < totalMonths; m++) {
        doubleBalance = doubleBalance * (1 + monthlyRate) + doubleMonthly;
      }
      tipText.innerHTML = `Doubling your monthly contribution to <strong>${formatCurrency(doubleMonthly)}</strong> would grow your portfolio to <strong>${formatCurrency(Math.round(doubleBalance))}</strong> — that is <strong>${formatCurrency(Math.round(doubleBalance - totalValue))}</strong> more.`;
    } else {
      tipText.innerHTML = `Even adding <strong>$100/month</strong> in contributions would significantly boost your returns thanks to compound growth. Start small and increase over time.`;
    }
  }

  [initialInput, monthlyInput, returnInput, yearsInput].forEach(el => {
    el.addEventListener('input', calculate);
    el.addEventListener('change', calculate);
  });
</script>
