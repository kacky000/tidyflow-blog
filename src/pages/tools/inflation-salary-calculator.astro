    font-size: 1.5rem;
    font-weight: 700;
    color: #4f46e5;
  }
  .pct-symbol {
    position: absolute;
    right: 1.25rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: #4f46e5;
  }
  .input-hint {
    font-size: 0.85rem;
    color: #888;
    margin: 0.5rem 0 0;
  }
  .calc-card input[type="number"] {
    width: 100%;
    padding: 1rem 1rem 1rem 2.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    transition: border-color 0.2s;
    outline: none;
    font-family: inherit;
    color: #1a1a2e;
  }
