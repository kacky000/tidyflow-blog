    flex: 1;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
    background: #f8f9fb;
    color: #666;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    font-family: inherit;
  }
  .toggle-btn.active {
    background: #4f46e5;
    color: #fff;
  }
  .toggle-btn:hover:not(.active) {
    background: #eef2ff;
  }

  .calc-button {
    width: 100%;
    padding: 1rem;
    font-size: 1.15rem;
    font-weight: 700;
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    color: #fff;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    font-family: inherit;
  }
  .calc-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(79,70,229,0.3);
  }

  .headline-result {
    text-align: center;
    padding: 2.5rem 2rem;
    border-radius: 16px;
    margin-bottom: 1.5rem;
    background: #fff;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }
  .headline-result.positive {
    background: linear-gradient(135deg, #ecfdf5, #d1fae5);
    border: 2px solid #6ee7b7;
  }
  .headline-result.negative {
    background: linear-gradient(135deg, #fef2f2, #fee2e2);
    border: 2px solid #fca5a5;
  }
  .headline-label {
    font-size: 1.1rem;
    color: #666;
    margin: 0 0 0.25rem;
  }
