    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    margin: 0 0 0.5rem;
    line-height: 1.1;
  }
  .headline-result.positive .headline-number { color: #059669; }
  .headline-result.negative .headline-number { color: #dc2626; }
  .headline-sub {
    font-size: 1.05rem;
    color: #555;
    margin: 0;
    line-height: 1.5;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .comparison-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    text-align: center;
  }
  .comparison-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.5rem;
  }
  .comparison-label {
    font-size: 0.9rem;
    color: #666;
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }
  .comparison-value {
