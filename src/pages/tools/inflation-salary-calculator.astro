    background: #f8f9fb;
    border-radius: 10px;
  }
  .fun-emoji {
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  .fun-text {
    font-size: 0.9rem;
    color: #444;
    line-height: 1.4;
  }

  .tool-cta {
    padding: 2.5rem 1.5rem;
    background: #fff;
  }
  .cta-card {
    max-width: 800px;
    margin: 0 auto;
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    border-radius: 20px;
    padding: 2.5rem;
    text-align: center;
    color: #fff;
  }
  .cta-card h2 {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
    font-weight: 800;
  }
  .cta-card p {
    margin: 0 0 1.5rem;
    opacity: 0.92;
    line-height: 1.6;
  }
  .cta-button {
    display: inline-block;
    background: #fff;
    color: #4f46e5;
    font-weight: 700;
    padding: 0.85rem 2rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  .tool-content {
    padding: 3rem 1.5rem 4rem;
    background: #f8f9fb;
  }
  .content-narrow {
    max-width: 720px;
    margin: 0 auto;
  }
  .tool-content h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #1a1a2e;
    margin: 2.5rem 0 0.75rem;
  }
  .tool-content h2:first-child {
    margin-top: 0;
  }
  .tool-content p,
  .tool-content li {
    font-size: 1.02rem;
    line-height: 1.7;
    color: #444;
  }
  .tool-content ul,
  .tool-content ol {
    padding-left: 1.25rem;
    margin: 0.5rem 0 1rem;
  }
  .tool-content li {
    margin-bottom: 0.35rem;
  }
  .tool-content a {
    color: #4f46e5;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .tool-content details {
    background: #fff;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
  }
  .tool-content summary {
    font-weight: 600;
    cursor: pointer;
    color: #1a1a2e;
    font-size: 1.02rem;
  }
  .tool-content details p {
    margin: 0.75rem 0 0;
  }
  .inflation-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.95rem;
  }
  .inflation-table th,
  .inflation-table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
  }
  .inflation-table th {
    background: #4f46e5;
    color: #fff;
    font-weight: 600;
  }
  .inflation-table th:first-child {
    border-radius: 8px 0 0 0;
  }
  .inflation-table th:last-child {
    border-radius: 0 8px 0 0;
  }
  .inflation-table tr:nth-child(even) td {
    background: #f8f9fb;
  }
  .inflation-table td {
    color: #444;
  }

  @media (max-width: 640px) {
    .comparison-grid {
      grid-template-columns: 1fr;
    }
    .fun-grid {
      grid-template-columns: 1fr;
    }
    .bar-row {
      flex-wrap: wrap;
    }
    .bar-label {
      min-width: 100%;
    }
    .bar-value {
      min-width: auto;
    }
    .cta-card {
      padding: 2rem 1.5rem;
    }
    .detail-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>

<script>
  const currentSalaryInput = document.getElementById('current-salary') as HTMLInputElement;
  const lastSalaryInput = document.getElementById('last-salary') as HTMLInputElement;
  const raisePctInput = document.getElementById('raise-pct') as HTMLInputElement;
  const inflationInput = document.getElementById('inflation-rate') as HTMLInputElement;
  const toggleSalary = document.getElementById('toggle-salary') as HTMLButtonElement;
  const toggleRaise = document.getElementById('toggle-raise') as HTMLButtonElement;
  const salaryGroup = document.getElementById('salary-input-group') as HTMLElement;
  const raiseGroup = document.getElementById('raise-input-group') as HTMLElement;
  const calcBtn = document.getElementById('calc-btn') as HTMLButtonElement;
  const resultsSection = document.getElementById('results-section') as HTMLElement;

  let mode: 'salary' | 'raise' = 'salary';

  toggleSalary.addEventListener('click', () => {
    mode = 'salary';
    toggleSalary.classList.add('active');
    toggleSalary.setAttribute('aria-checked', 'true');
    toggleRaise.classList.remove('active');
    toggleRaise.setAttribute('aria-checked', 'false');
    salaryGroup.style.display = 'block';
    raiseGroup.style.display = 'none';
  });

  toggleRaise.addEventListener('click', () => {
    mode = 'raise';
    toggleRaise.classList.add('active');
    toggleRaise.setAttribute('aria-checked', 'true');
    toggleSalary.classList.remove('active');
    toggleSalary.setAttribute('aria-checked', 'false');
    salaryGroup.style.display = 'none';
    raiseGroup.style.display = 'block';
  });

  function fmt(n: number): string {
    return '$' + Math.round(n).toLocaleString('en-US');
  }

  function fmtPct(n: number): string {
    const sign = n >= 0 ? '+' : '';
    return sign + n.toFixed(2) + '%';
  }

  calcBtn.addEventListener('click', () => {
    const currentSalary = parseFloat(currentSalaryInput.value) || 0;
    const inflationRate = (parseFloat(inflationInput.value) || 0) / 100;

    if (currentSalary <= 0) return;

    let lastSalary: number;
    if (mode === 'salary') {
      lastSalary = parseFloat(lastSalaryInput.value) || 0;
      if (lastSalary <= 0) return;
    } else {
      const raisePct = parseFloat(raisePctInput.value) || 0;
      lastSalary = currentSalary / (1 + raisePct / 100);
    }

    const nominalRaisePct = ((currentSalary - lastSalary) / lastSalary) * 100;
    const realRaisePct = nominalRaisePct - (inflationRate * 100);
    const adjustedLastSalary = lastSalary * (1 + inflationRate);
    const purchasingPowerChange = currentSalary - adjustedLastSalary;
    const salaryNeeded = lastSalary * (1 + inflationRate);

    const headlineCard = document.getElementById('headline-card') as HTMLElement;
    const headlineNumber = document.getElementById('headline-number') as HTMLElement;
    const headlineSub = document.getElementById('headline-sub') as HTMLElement;

    headlineCard.classList.remove('positive', 'negative');
    if (realRaisePct >= 0) {
      headlineCard.classList.add('positive');
      headlineNumber.textContent = fmtPct(realRaisePct);
      headlineSub.textContent = 'Your raise beats inflation. Your purchasing power is growing.';
    } else {
      headlineCard.classList.add('negative');
      headlineNumber.textContent = fmtPct(realRaisePct);
      headlineSub.textContent = `You effectively took a ${Math.abs(realRaisePct).toFixed(2)}% pay cut. You need ${fmt(salaryNeeded)} to keep up.`;
    }

    (document.getElementById('adjusted-last-salary') as HTMLElement).textContent = fmt(adjustedLastSalary);
    (document.getElementById('current-display') as HTMLElement).textContent = fmt(currentSalary);

    (document.getElementById('nominal-raise') as HTMLElement).textContent = fmtPct(nominalRaisePct);
    (document.getElementById('display-inflation') as HTMLElement).textContent = (inflationRate * 100).toFixed(2) + '%';
    (document.getElementById('real-raise') as HTMLElement).textContent = fmtPct(realRaisePct);
    (document.getElementById('pp-yearly') as HTMLElement).textContent = (purchasingPowerChange >= 0 ? '+' : '') + fmt(purchasingPowerChange);
    (document.getElementById('pp-monthly') as HTMLElement).textContent = (purchasingPowerChange >= 0 ? '+' : '') + fmt(purchasingPowerChange / 12);
    (document.getElementById('salary-needed') as HTMLElement).textContent = fmt(salaryNeeded);

    const realValue = currentSalary / (1 + inflationRate);
    const maxVal = Math.max(currentSalary, realValue);
    (document.getElementById('bar-nominal') as HTMLElement).style.width = ((currentSalary / maxVal) * 100) + '%';
    (document.getElementById('bar-real') as HTMLElement).style.width = ((realValue / maxVal) * 100) + '%';
    (document.getElementById('bar-nominal-val') as HTMLElement).textContent = fmt(currentSalary);
    (document.getElementById('bar-real-val') as HTMLElement).textContent = fmt(realValue);

    const monthlyDiff = Math.abs(purchasingPowerChange / 12);
    const coffeePrice = 5.50;
    const groceryTrip = 150;
    const streamingSub = 15;
    const gasTank = 60;

    const coffees = Math.round(monthlyDiff / coffeePrice);
    const groceries = (monthlyDiff / groceryTrip).toFixed(1);
    const streaming = Math.round(monthlyDiff / streamingSub);
    const gasTanks = (monthlyDiff / gasTank).toFixed(1);

    const direction = purchasingPowerChange >= 0 ? 'extra' : 'fewer';
    const funGrid = document.getElementById('fun-grid') as HTMLElement;
    funGrid.innerHTML = `
      <div class="fun-item"><span class="fun-emoji">&#9749;</span><span class="fun-text">${coffees} ${direction} cups of coffee per month</span></div>
      <div class="fun-item"><span class="fun-emoji">&#128722;</span><span class="fun-text">${groceries} ${direction} grocery trips per month</span></div>
      <div class="fun-item"><span class="fun-emoji">&#127909;</span><span class="fun-text">${streaming} ${direction} streaming subscriptions</span></div>
      <div class="fun-item"><span class="fun-emoji">&#9981;</span><span class="fun-text">${gasTanks} ${direction} gas tank fill-ups per month</span></div>
    `;

    resultsSection.style.display = 'block';
    headlineCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>
