    font-weight: 800;
    color: #1a1a2e;
    margin: 0;
  }

  .detail-card,
  .bars-card,
  .fun-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    margin-bottom: 1.5rem;
  }
  .detail-card h3,
  .bars-card h3,
  .fun-card h3 {
    margin: 0 0 1.25rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a1a2e;
  }
  .detail-grid {
    display: grid;
    gap: 0.75rem;
  }
  .detail-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: #f8f9fb;
    border-radius: 10px;
  }
  .detail-label {
    font-size: 0.9rem;
    color: #666;
  }
  .detail-value {
    font-weight: 700;
    color: #1a1a2e;
