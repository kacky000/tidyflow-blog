    padding-left: 1.25rem;
    padding-right: 2.75rem;
  }

  .toggle-group {
    display: flex;
    gap: 0;
    margin-bottom: 1.5rem;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid #e2e8f0;
  }
