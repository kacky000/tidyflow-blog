  const personalityTypes: Record<string, PersonalityType> = {
    planner: {
      name: "The Planner",
      icon: "📊",
      description: "You are methodical, detail-oriented, and always in control of your finances. You track every dollar, love spreadsheets, and rarely make impulse purchases. Your organized approach means you always know where your money goes and you hit your financial goals consistently.",
      strengths: [
        "You always know exactly where your money goes — no surprises",
        "You reach financial goals faster than most because you plan ahead",
        "Your disciplined approach protects you from debt and overspending"
      ],
      improvements: [
        "Loosen up occasionally — it's okay to splurge on something unplanned once in a while",
        "Avoid spending more time tracking money than actually living your life",
        "Be careful not to let financial anxiety control your decisions"
      ],
      tools: [
        { name: "50/30/20 Budget Calculator — Perfect for your structured approach", url: "/tools/budget-calculator" },
        { name: "Subscription Calculator — Track every recurring expense", url: "/tools/subscription-calculator" },
        { name: "Savings Goal Calculator — Set and crush your savings targets", url: "/tools/savings-goal-calculator" }
      ]
    },
    minimalist: {
      name: "The Minimalist",
      icon: "🌿",
      description: "You believe less is more — and that includes spending. You focus on essentials, save aggressively, and find genuine satisfaction in simplicity. Your frugal mindset means you build wealth quickly and rarely stress about money. Financial independence isn't a dream — it's your plan.",
      strengths: [
        "You build wealth rapidly thanks to your high savings rate",
        "You are resilient in financial emergencies — always prepared",
        "You find happiness in experiences and relationships, not material things"
      ],
      improvements: [
        "Allow yourself to enjoy the money you earn — you've earned it",
        "Being too frugal can strain relationships if others feel judged for spending",
        "Invest in quality items that last rather than always choosing the cheapest option"
      ],
      tools: [
        { name: "Savings Rate Calculator — See how fast you'll reach FIRE", url: "/tools/savings-rate-calculator" },
        { name: "Emergency Fund Calculator — Make sure your safety net is right-sized", url: "/tools/emergency-fund-calculator" },
        { name: "Investment Return Calculator — Put your savings to work", url: "/tools/investment-return-calculator" }
      ]
    },
    spontaneous: {
      name: "The Spontaneous Spender",
      icon: "🎉",
      description: "You live in the moment and believe money is meant to be enjoyed. You are generous, experience-driven, and drawn to things that bring immediate happiness. Your spontaneity makes you fun to be around, but it can sometimes leave your bank account feeling the aftereffects of your enthusiasm.",
      strengths: [
        "You enjoy life fully and create memorable experiences",
        "Your generosity strengthens your relationships and social connections",
        "You are adaptable and comfortable making quick financial decisions"
      ],
      improvements: [
        "Set up automatic savings so future-you is protected from present-you",
        "Try the 24-hour rule for purchases over $50 to reduce impulse buying",
        "Build a small emergency fund — even $1,000 changes everything"
      ],
      tools: [
        { name: "Budget Calculator — Start with a simple spending framework", url: "/tools/budget-calculator" },
        { name: "Subscription Calculator — Find hidden spending you forgot about", url: "/tools/subscription-calculator" },
        { name: "Debt Payoff Calculator — Make a plan to clear any debt", url: "/tools/debt-payoff-calculator" }
      ]
    },
    balanced: {
      name: "The Balanced Spender",
      icon: "⚖️",
      description: "You have found the sweet spot between saving and spending. You set budgets but leave room for enjoyment. You save consistently without feeling deprived and adjust your habits as life changes. Your pragmatic approach means you build wealth steadily while still living a fulfilling life.",
      strengths: [
        "You maintain financial health without sacrificing quality of life",
        "You adapt well to changing circumstances and unexpected expenses",
        "You set a great example for others seeking a healthy money mindset"
      ],
      improvements: [
        "Consider increasing your savings rate during high-income periods",
        "Set specific long-term goals to give your balanced approach more direction",
        "Track spending periodically to make sure your balance hasn't drifted"
      ],
      tools: [
        { name: "50/30/20 Calculator — Fine-tune your balanced approach", url: "/tools/50-30-20-calculator" },
        { name: "Savings Goal Calculator — Set your next financial milestone", url: "/tools/savings-goal-calculator" },
        { name: "Net Worth Calculator — See your overall financial picture", url: "/tools/net-worth-calculator" }
      ]
    }
  };

  let currentQuestion = 0;
  const scores: Record<string, number> = { planner: 0, minimalist: 0, spontaneous: 0, balanced: 0 };

  const quizCard = document.getElementById('quiz-card')!;
  const resultCard = document.getElementById('result-card')!;
  const progressBar = document.getElementById('progress-bar')!;
  const progressText = document.getElementById('progress-text')!;
  const questionText = document.getElementById('question-text')!;
  const optionsContainer = document.getElementById('options-container')!;
  const retakeButton = document.getElementById('retake-button')!;

  function renderQuestion(): void {
    const q = questions[currentQuestion];
    progressBar.style.width = `${((currentQuestion + 1) / questions.length) * 100}%`;
    progressText.textContent = `Question ${currentQuestion + 1} of ${questions.length}`;
    questionText.textContent = q.text;

    optionsContainer.innerHTML = '';
    q.options.forEach((opt) => {
      const btn = document.createElement('button');
      btn.className = 'option-button';
      btn.innerHTML = `<span class="option-label">${opt.label}</span>${opt.text}`;
      btn.addEventListener('click', () => selectAnswer(opt.type));
      optionsContainer.appendChild(btn);
    });
  }

  function selectAnswer(type: string): void {
    scores[type]++;
    currentQuestion++;

    if (currentQuestion < questions.length) {
      renderQuestion();
    } else {
      showResults();
    }
  }

  function showResults(): void {
    quizCard.style.display = 'none';
    resultCard.style.display = 'block';

    let maxType = 'balanced';
    let maxScore = 0;
    for (const [type, score] of Object.entries(scores)) {
      if (score > maxScore) {
        maxScore = score;
        maxType = type;
      }
    }

    const result = personalityTypes[maxType];

    document.getElementById('result-icon')!.textContent = result.icon;
    document.getElementById('result-type-name')!.textContent = result.name;
    document.getElementById('result-description')!.textContent = result.description;

    const strengthsList = document.getElementById('result-strengths')!;
    strengthsList.innerHTML = '';
    result.strengths.forEach((s) => {
      const li = document.createElement('li');
      li.textContent = s;
      strengthsList.appendChild(li);
    });

    const improvementsList = document.getElementById('result-improvements')!;
    improvementsList.innerHTML = '';
    result.improvements.forEach((s) => {
      const li = document.createElement('li');
      li.textContent = s;
      improvementsList.appendChild(li);
    });

    const toolsContainer = document.getElementById('result-tools')!;
    toolsContainer.innerHTML = '';
    result.tools.forEach((t) => {
      const a = document.createElement('a');
      a.href = t.url;
      a.textContent = t.name;
      toolsContainer.appendChild(a);
    });
  }

  function resetQuiz(): void {
    currentQuestion = 0;
    scores.planner = 0;
    scores.minimalist = 0;
    scores.spontaneous = 0;
    scores.balanced = 0;

    resultCard.style.display = 'none';
    quizCard.style.display = 'block';
    renderQuestion();
  }

  retakeButton.addEventListener('click', resetQuiz);
  renderQuestion();
</script>
