  }
  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  /* Content */
  .tool-content {
    padding: 3rem 1.5rem 4rem;
    background: #f8f9fb;
  }
  .content-narrow {
    max-width: 720px;
    margin: 0 auto;
  }
  .tool-content h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #1a1a2e;
    margin: 2.5rem 0 0.75rem;
  }
  .tool-content h2:first-child {
    margin-top: 0;
  }
  .tool-content p,
  .tool-content li {
    font-size: 1.02rem;
    line-height: 1.7;
    color: #444;
  }
  .tool-content ul,
  .tool-content ol {
    padding-left: 1.25rem;
    margin: 0.5rem 0 1rem;
  }
  .tool-content li {
    margin-bottom: 0.35rem;
  }
  .tool-content a {
    color: #f5576c;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .tool-content details {
    background: #fff;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
  }
  .tool-content summary {
    font-weight: 600;
    cursor: pointer;
    color: #1a1a2e;
    font-size: 1.02rem;
  }
  .tool-content details p {
    margin: 0.75rem 0 0;
  }

  @media (max-width: 640px) {
    .quiz-card {
      padding: 1.5rem 1rem;
    }
    .question-text {
      font-size: 1.1rem;
    }
    .result-card-main {
      padding: 2rem 1.25rem;
    }
    .result-section {
