</style>

<script>
  interface Question {
    text: string;
    options: { label: string; text: string; type: string }[];
  }

  interface PersonalityType {
    name: string;
    icon: string;
    description: string;
    strengths: string[];
    improvements: string[];
    tools: { name: string; url: string }[];
  }

  const questions: Question[] = [
    {
      text: "When you get your paycheck, what's your first instinct?",
      options: [
        { label: "A", text: "Open my budget spreadsheet and allocate every dollar", type: "planner" },
        { label: "B", text: "Transfer most of it to savings immediately", type: "minimalist" },
        { label: "C", text: "Check what's on sale — time to treat myself!", type: "spontaneous" },
        { label: "D", text: "Pay bills, save a set amount, then enjoy the rest guilt-free", type: "balanced" }
      ]
    },
    {
      text: "How do you handle a surprise $500 expense?",
      options: [
        { label: "A", text: "Pull from my emergency fund — that's exactly what it's for", type: "planner" },
        { label: "B", text: "No problem. I keep months of expenses in reserve", type: "minimalist" },
        { label: "C", text: "Put it on my credit card and figure it out later", type: "spontaneous" },
        { label: "D", text: "Adjust this month's fun budget to cover it", type: "balanced" }
      ]
    },
    {
      text: "Your friend invites you to an expensive dinner. You...",
      options: [
        { label: "A", text: "Check my dining-out budget to see if I can afford it", type: "planner" },
        { label: "B", text: "Suggest a cheaper alternative — why overspend on food?", type: "minimalist" },
        { label: "C", text: "Say yes instantly — life is too short to miss out!", type: "spontaneous" },
        { label: "D", text: "Go and enjoy it, but maybe skip coffee runs next week", type: "balanced" }
      ]
    },
    {
      text: "How do you feel about subscription services?",
      options: [
        { label: "A", text: "I track all of them in a spreadsheet and review quarterly", type: "planner" },
        { label: "B", text: "I keep only one or two — most are a waste of money", type: "minimalist" },
        { label: "C", text: "I have more than I can count but they all bring me joy", type: "spontaneous" },
        { label: "D", text: "I keep the ones I use regularly and cancel the rest", type: "balanced" }
      ]
    },
    {
      text: "When shopping online, you typically...",
      options: [
        { label: "A", text: "Compare prices across 5 sites and wait for the best deal", type: "planner" },
        { label: "B", text: "Only buy if it's truly necessary — my cart stays empty for weeks", type: "minimalist" },
        { label: "C", text: "Add things to my cart as I browse and checkout on impulse", type: "spontaneous" },
        { label: "D", text: "Have a wishlist and buy when the price feels right", type: "balanced" }
      ]
    },
    {
      text: "What does your savings account look like?",
      options: [
        { label: "A", text: "Multiple accounts labeled for specific goals with auto-transfers", type: "planner" },
        { label: "B", text: "Very healthy — I save 40%+ of my income", type: "minimalist" },
        { label: "C", text: "I have one, but it doesn't grow much. I'll start saving later", type: "spontaneous" },
        { label: "D", text: "Steady growth — I hit my savings target most months", type: "balanced" }
      ]
    },
    {
      text: "How do you plan for vacations?",
      options: [
        { label: "A", text: "Create a detailed budget months in advance with a sinking fund", type: "planner" },
        { label: "B", text: "Travel cheap — hostels, off-season, and packed lunches", type: "minimalist" },
        { label: "C", text: "Book the trip first, worry about money later — YOLO!", type: "spontaneous" },
        { label: "D", text: "Set a total budget and enjoy the trip within that limit", type: "balanced" }
      ]
    },
    {
      text: "When you see something on sale, you...",
      options: [
        { label: "A", text: "Check if it's in my planned purchases list before buying", type: "planner" },
        { label: "B", text: "A sale doesn't matter — if I don't need it, I don't buy it", type: "minimalist" },
        { label: "C", text: "Stock up! A deal this good won't last forever", type: "spontaneous" },
        { label: "D", text: "Buy it if I was already considering it, skip if not", type: "balanced" }
      ]
    },
    {
      text: "How often do you check your bank balance?",
      options: [
        { label: "A", text: "Daily — I reconcile every transaction in my tracker", type: "planner" },
        { label: "B", text: "Weekly, but I already know roughly what it should be", type: "minimalist" },
        { label: "C", text: "Only when I'm worried I might be running low", type: "spontaneous" },
        { label: "D", text: "A few times a week — enough to stay aware", type: "balanced" }
      ]
    },
    {
      text: "What's your approach to grocery shopping?",
      options: [
        { label: "A", text: "Meal plan for the week, make a list, stick to it exactly", type: "planner" },
        { label: "B", text: "Buy basics in bulk — rice, beans, frozen veggies. No extras", type: "minimalist" },
        { label: "C", text: "Wander the aisles and grab whatever looks good", type: "spontaneous" },
        { label: "D", text: "Have a rough list but allow a treat or two if something catches my eye", type: "balanced" }
      ]
    }
