<script>
  const loanBalance = document.getElementById('loan-balance') as HTMLInputElement;
  const interestRate = document.getElementById('interest-rate') as HTMLInputElement;
  const loanTerm = document.getElementById('loan-term') as HTMLSelectElement;
  const extraPayment = document.getElementById('extra-payment') as HTMLInputElement;
  const resultsGrid = document.getElementById('results-grid')!;
  const extraSavings = document.getElementById('extra-savings')!;
  const amortSummary = document.getElementById('amortization-summary')!;

  function formatCurrency(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function formatCurrencyCents(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function formatDate(date: Date): string {
    return date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  }

  function calcMonthlyPayment(principal: number, monthlyRate: number, totalPayments: number): number {
    if (monthlyRate === 0) return principal / totalPayments;
    const factor = Math.pow(1 + monthlyRate, totalPayments);
    return principal * (monthlyRate * factor) / (factor - 1);
  }

  function simulateLoan(principal: number, monthlyRate: number, basePayment: number, extra: number) {
    let balance = principal;
    let totalInterest = 0;
    let months = 0;
    const yearlyData: { principal: number; interest: number; balance: number }[] = [];
    let yearPrincipal = 0;
    let yearInterest = 0;

    while (balance > 0.01 && months < 600) {
      const interestCharge = balance * monthlyRate;
      const totalMonthlyPayment = Math.min(basePayment + extra, balance + interestCharge);
      const principalPayment = totalMonthlyPayment - interestCharge;

      balance -= principalPayment;
      if (balance < 0) balance = 0;
      totalInterest += interestCharge;
      yearPrincipal += principalPayment;
      yearInterest += interestCharge;
      months++;

      if (months % 12 === 0 || balance <= 0.01) {
        yearlyData.push({
          principal: yearPrincipal,
          interest: yearInterest,
          balance: Math.max(balance, 0)
        });
        yearPrincipal = 0;
        yearInterest = 0;
      }
    }

    return { totalInterest, months, yearlyData };
  }

  function calculate() {
    const principal = parseFloat(loanBalance.value) || 0;
    const annualRate = parseFloat(interestRate.value) || 0;
    const years = parseInt(loanTerm.value) || 10;
    const extra = parseFloat(extraPayment.value) || 0;

    if (principal <= 0 || annualRate <= 0) {
      resultsGrid.style.display = 'none';
      extraSavings.style.display = 'none';
      amortSummary.style.display = 'none';
      return;
    }

    const r = annualRate / 100 / 12;
    const n = years * 12;
    const basePayment = calcMonthlyPayment(principal, r, n);

    // Simulate with extra payment
    const result = simulateLoan(principal, r, basePayment, extra);
    const totalCost = principal + result.totalInterest;

    // Payoff date
    const now = new Date();
    const payoffDate = new Date(now.getFullYear(), now.getMonth() + result.months, 1);

    resultsGrid.style.display = 'grid';
    amortSummary.style.display = 'block';

    document.getElementById('monthly-payment')!.textContent = formatCurrencyCents(basePayment);
    document.getElementById('total-interest')!.textContent = formatCurrency(Math.round(result.totalInterest));
    document.getElementById('total-cost')!.textContent = formatCurrency(Math.round(totalCost));
    document.getElementById('payoff-date')!.textContent = formatDate(payoffDate);

    // Bar widths
    const interestRatio = result.totalInterest / totalCost * 100;
    (document.getElementById('bar-payment') as HTMLElement).style.width = '100%';
    (document.getElementById('bar-interest') as HTMLElement).style.width = interestRatio.toFixed(1) + '%';
    (document.getElementById('bar-total') as HTMLElement).style.width = '100%';
    const timeRatio = (result.months / n) * 100;
    (document.getElementById('bar-payoff') as HTMLElement).style.width = timeRatio.toFixed(1) + '%';

    // Extra payment savings
    if (extra > 0) {
      const baseResult = simulateLoan(principal, r, basePayment, 0);
      const monthsSaved = baseResult.months - result.months;
      const interestSaved = baseResult.totalInterest - result.totalInterest;

      extraSavings.style.display = 'block';

      if (monthsSaved >= 12) {
        const yearsSaved = Math.floor(monthsSaved / 12);
        const remainingMonths = monthsSaved % 12;
        let timeStr = yearsSaved + (yearsSaved === 1 ? ' year' : ' years');
        if (remainingMonths > 0) {
          timeStr += ' ' + remainingMonths + (remainingMonths === 1 ? ' month' : ' months');
        }
        document.getElementById('time-saved')!.textContent = timeStr;
      } else {
        document.getElementById('time-saved')!.textContent = monthsSaved + (monthsSaved === 1 ? ' month' : ' months');
      }
      document.getElementById('interest-saved')!.textContent = formatCurrency(Math.round(interestSaved));
    } else {
      extraSavings.style.display = 'none';
    }

    // Amortization table
    const tbody = document.getElementById('amort-tbody')!;
    tbody.innerHTML = '';
    result.yearlyData.forEach((row, i) => {
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td>' + (i + 1) + '</td>' +
        '<td>' + formatCurrency(Math.round(row.principal)) + '</td>' +
        '<td>' + formatCurrency(Math.round(row.interest)) + '</td>' +
        '<td>' + formatCurrency(Math.round(row.balance)) + '</td>';
      tbody.appendChild(tr);
    });
  }

  loanBalance.addEventListener('input', calculate);
  interestRate.addEventListener('input', calculate);
  loanTerm.addEventListener('change', calculate);
  extraPayment.addEventListener('input', calculate);
</script>
