    margin-bottom: 0.4rem;
    color: #1a1a2e;
  }
  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .currency-symbol {
    position: absolute;
    left: 1rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #ed8936;
  }
  .calc-card input[type="number"] {
