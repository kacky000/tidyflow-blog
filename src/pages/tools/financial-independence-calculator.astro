    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
  }
  .tool-content summary {
    font-weight: 600;
    cursor: pointer;
    color: #1a1a2e;
    font-size: 1.02rem;
  }
  .tool-content details p {
    margin: 0.75rem 0 0;
  }

  @media (max-width: 640px) {
    .input-row {
      grid-template-columns: 1fr;
    }
    .results-grid {
      grid-template-columns: 1fr;
    }
    .budget-split {
      flex-direction: column;
      gap: 1rem;
    }
    .split-divider {
      display: none;
    }
    .cta-card {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  const ageInput = document.getElementById('age-input') as HTMLInputElement;
  const incomeInput = document.getElementById('income-input') as HTMLInputElement;
  const expensesInput = document.getElementById('expenses-input') as HTMLInputElement;
  const savingsInput = document.getElementById('savings-input') as HTMLInputElement;
  const returnInput = document.getElementById('return-input') as HTMLInputElement;
  const swrInput = document.getElementById('swr-input') as HTMLInputElement;
  const resultsSection = document.getElementById('results-section')!;
  const warningCard = document.getElementById('warning-card')!;

  function fmt(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function calculateYearsToFI(currentSavings: number, annualSaving: number, annualReturn: number, fireNumber: number): number {
    if (currentSavings >= fireNumber) return 0;
    if (annualSaving <= 0) return 999;

    const r = annualReturn / 100;
    let balance = currentSavings;
    let years = 0;
    const maxYears = 100;

    while (balance < fireNumber && years < maxYears) {
      balance = balance * (1 + r) + annualSaving;
      years++;
    }
    return years >= maxYears ? 999 : years;
  }

  function calculate() {
    const age = parseFloat(ageInput.value) || 0;
    const income = parseFloat(incomeInput.value) || 0;
    const expenses = parseFloat(expensesInput.value) || 0;
    const currentSavings = parseFloat(savingsInput.value) || 0;
    const annualReturn = parseFloat(returnInput.value) || 7;
    const swr = parseFloat(swrInput.value) || 4;

    if (income <= 0 || expenses <= 0) {
      resultsSection.style.display = 'none';
      warningCard.style.display = 'none';
      return;
    }

    if (expenses >= income) {
      resultsSection.style.display = 'none';
      warningCard.style.display = 'block';
      document.getElementById('warning-text')!.textContent =
        'Your expenses are equal to or exceed your income. To reach FIRE, you need to save a portion of your income. Try reducing expenses or increasing income.';
      return;
    }

    warningCard.style.display = 'none';

    const annualSaving = income - expenses;
    const savingsRate = (annualSaving / income) * 100;
    const fireNumber = expenses / (swr / 100);
    const yearsToFI = calculateYearsToFI(currentSavings, annualSaving, annualReturn, fireNumber);

    resultsSection.style.display = 'block';

    // FIRE number
    document.getElementById('fire-number')!.textContent = fmt(Math.round(fireNumber));
    document.getElementById('fire-tip')!.textContent =
      `${fmt(Math.round(expenses))}/yr expenses ÷ ${swr}% withdrawal rate`;

    // Years to FI
    if (yearsToFI >= 999) {
      document.getElementById('years-result')!.textContent = '99+';
      document.getElementById('fi-age-tip')!.textContent = 'At current rates, FI is very far away. Consider increasing savings.';
    } else if (yearsToFI === 0) {
      document.getElementById('years-result')!.textContent = 'Now!';
      document.getElementById('fi-age-tip')!.textContent = 'You\'ve already reached your FIRE number!';
    } else {
      document.getElementById('years-result')!.textContent = yearsToFI.toFixed(0);
      const fiAge = age > 0 ? age + yearsToFI : 0;
      document.getElementById('fi-age-tip')!.textContent =
        age > 0 ? `You'll reach FI at age ${fiAge.toFixed(0)}` : `${yearsToFI} years from now`;
    }

    // Savings rate
    document.getElementById('savings-rate-result')!.textContent = savingsRate.toFixed(1) + '%';
    let rateMsg = '';
    if (savingsRate >= 70) rateMsg = 'Exceptional! You\'re on the fast track.';
    else if (savingsRate >= 50) rateMsg = 'Great! This is a strong FIRE savings rate.';
    else if (savingsRate >= 30) rateMsg = 'Good. Consider optimizing expenses further.';
    else if (savingsRate >= 15) rateMsg = 'Average. Increasing this would accelerate FI significantly.';
    else rateMsg = 'Below average. Small increases make a big difference.';
    document.getElementById('rate-tip')!.textContent = rateMsg;

    // Progress bar
    const pct = Math.min((currentSavings / fireNumber) * 100, 100);
    (document.getElementById('progress-bar') as HTMLElement).style.width = `${pct}%`;
    document.getElementById('progress-current')!.textContent = `${fmt(Math.round(currentSavings))} saved`;
    document.getElementById('progress-target')!.textContent = `${fmt(Math.round(fireNumber))} goal`;
    document.getElementById('progress-pct')!.textContent = `${pct.toFixed(1)}% there`;

    // Impact table
    const tbody = document.getElementById('impact-tbody')!;
    tbody.innerHTML = '';
    const rates = [10, 20, 30, 40, 50, 60, 70, 80];
    const currentRateRounded = Math.round(savingsRate / 5) * 5;

    rates.forEach(rate => {
      const annSave = income * (rate / 100);
      const annExp = income - annSave;
      const fn = annExp / (swr / 100);
      const yrs = calculateYearsToFI(currentSavings, annSave, annualReturn, fn);

      const tr = document.createElement('tr');
      if (Math.abs(rate - currentRateRounded) < 5 || rate === currentRateRounded) {
        tr.className = 'current-row';
      }
      tr.innerHTML = `
        <td>${rate}%${rate === currentRateRounded ? ' (you)' : ''}</td>
        <td>${fmt(Math.round(annSave / 12))}</td>
        <td>${yrs >= 999 ? '99+' : yrs + ' yrs'}</td>
        <td>${age > 0 ? (yrs >= 999 ? '—' : (age + yrs).toString()) : '—'}</td>
      `;
      tbody.appendChild(tr);
    });

    // Monthly breakdown
    document.getElementById('monthly-savings')!.textContent = fmt(Math.round(annualSaving / 12));
    document.getElementById('monthly-expenses')!.textContent = fmt(Math.round(expenses / 12));

    // Chart
    drawChart(currentSavings, annualSaving, annualReturn, fireNumber, yearsToFI);
  }

  function drawChart(currentSavings: number, annualSaving: number, annualReturn: number, fireNumber: number, yearsToFI: number) {
    const container = document.getElementById('chart-container')!;
    container.innerHTML = '';

    const r = annualReturn / 100;
    const chartYears = Math.min(Math.max(yearsToFI + 5, 15), 50);
    const data: { year: number; contributions: number; total: number }[] = [];

    let balance = currentSavings;
    let totalContributions = currentSavings;

    data.push({ year: 0, contributions: totalContributions, total: balance });

    for (let y = 1; y <= chartYears; y++) {
      balance = balance * (1 + r) + annualSaving;
      totalContributions += annualSaving;
      data.push({ year: y, contributions: totalContributions, total: balance });
    }

    const maxVal = Math.max(data[data.length - 1].total, fireNumber) * 1.1;

    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 800 210');
    svg.setAttribute('preserveAspectRatio', 'none');
    svg.style.width = '100%';
    svg.style.height = '100%';

    const xScale = 780 / chartYears;
    const yScale = 200 / maxVal;
    const offsetX = 10;

    // FIRE line
    const fireY = 210 - fireNumber * yScale;
    const fireLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    fireLine.setAttribute('x1', '0');
    fireLine.setAttribute('y1', fireY.toString());
    fireLine.setAttribute('x2', '800');
    fireLine.setAttribute('y2', fireY.toString());
    fireLine.setAttribute('stroke', '#e53e3e');
    fireLine.setAttribute('stroke-width', '2');
    fireLine.setAttribute('stroke-dasharray', '8 4');
    svg.appendChild(fireLine);

    // FIRE label
    const fireLabel = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    fireLabel.setAttribute('x', '790');
    fireLabel.setAttribute('y', (fireY - 6).toString());
    fireLabel.setAttribute('text-anchor', 'end');
    fireLabel.setAttribute('fill', '#e53e3e');
    fireLabel.setAttribute('font-size', '11');
    fireLabel.setAttribute('font-weight', '700');
    fireLabel.textContent = 'FIRE';
    svg.appendChild(fireLabel);

    // Contributions area
    let contribPath = `M ${offsetX} 210`;
    data.forEach(d => {
      contribPath += ` L ${offsetX + d.year * xScale} ${210 - d.contributions * yScale}`;
    });
    contribPath += ` L ${offsetX + chartYears * xScale} 210 Z`;
    const contribArea = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    contribArea.setAttribute('d', contribPath);
    contribArea.setAttribute('fill', 'rgba(237,137,54,0.3)');
    svg.appendChild(contribArea);

    // Total area
    let totalPath = `M ${offsetX} 210`;
    data.forEach(d => {
      totalPath += ` L ${offsetX + d.year * xScale} ${210 - d.total * yScale}`;
    });
    totalPath += ` L ${offsetX + chartYears * xScale} 210 Z`;
    const totalArea = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    totalArea.setAttribute('d', totalPath);
    totalArea.setAttribute('fill', 'rgba(102,126,234,0.2)');
    svg.appendChild(totalArea);

    // Total line
    let totalLinePath = `M ${offsetX} ${210 - data[0].total * yScale}`;
    for (let i = 1; i < data.length; i++) {
      totalLinePath += ` L ${offsetX + data[i].year * xScale} ${210 - data[i].total * yScale}`;
    }
    const totalLine = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    totalLine.setAttribute('d', totalLinePath);
    totalLine.setAttribute('fill', 'none');
    totalLine.setAttribute('stroke', '#667eea');
    totalLine.setAttribute('stroke-width', '3');
    svg.appendChild(totalLine);

    // Contributions line
    let contribLinePath = `M ${offsetX} ${210 - data[0].contributions * yScale}`;
    for (let i = 1; i < data.length; i++) {
      contribLinePath += ` L ${offsetX + data[i].year * xScale} ${210 - data[i].contributions * yScale}`;
    }
    const contribLine = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    contribLine.setAttribute('d', contribLinePath);
    contribLine.setAttribute('fill', 'none');
    contribLine.setAttribute('stroke', '#ed8936');
    contribLine.setAttribute('stroke-width', '3');
    svg.appendChild(contribLine);

    container.appendChild(svg);
  }

  [ageInput, incomeInput, expensesInput, savingsInput, returnInput, swrInput].forEach(el => {
    el.addEventListener('input', calculate);
  });
</script>
