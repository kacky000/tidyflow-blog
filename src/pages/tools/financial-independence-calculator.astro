---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'FIRE Calculator 2026 | Financial Independence & Early Retirement';
const description = "Calculate your path to financial independence. See your FIRE number, years to FI, and how savings rate impacts your retirement timeline.";
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "FIRE Calculator — Financial Independence",
      "url": "https://gettidyflow.com/tools/financial-independence-calculator",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": description
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the FIRE number?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your FIRE number is the amount of money you need invested to live off the returns. It's typically 25 times your annual expenses, based on the 4% safe withdrawal rate. For example, if you spend $40,000 per year, your FIRE number is $1,000,000."
          }
        },
        {
          "@type": "Question",
          "name": "What is a good savings rate for FIRE?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 50%+ savings rate can get you to financial independence in about 17 years. At 70%, you could reach FI in roughly 8.5 years. The average American saves about 5-10%, which means working 40+ years. The higher your savings rate, the faster you reach FI — and the less you need to save because you're accustomed to living on less."
          }
        },
        {
          "@type": "Question",
          "name": "Is the 4% rule still valid?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The 4% rule (Trinity Study) showed that a 4% withdrawal rate survived 95% of 30-year periods historically. For early retirees with 40-50+ year horizons, many experts suggest using 3.25-3.5% for extra safety. This calculator lets you adjust the withdrawal rate to see the impact."
          }
        }
      ]
    })} />
  </Fragment>

  <section class="tool-hero">
    <div class="tool-hero-inner">
      <span class="tool-badge">Free Tool — No Signup Required</span>
      <h1>Financial Independence <span class="gradient-text">Calculator</span></h1>
      <p class="tool-subtitle">Find your FIRE number and see exactly how many years until you can retire early. Discover how your savings rate is the most powerful lever for financial freedom.</p>
    </div>
  </section>

  <section class="tool-app">
    <div class="tool-container">
      <div class="calc-card">
        <div class="input-row">
          <div class="input-group">
            <label for="age-input" class="input-label">Current Age</label>
            <div class="input-wrapper">
              <input type="number" id="age-input" placeholder="30" min="18" max="80" step="1" aria-label="Current age" />
            </div>
          </div>

          <div class="input-group">
            <label for="income-input" class="input-label">Annual Income (after tax)</label>
            <div class="input-wrapper">
              <span class="currency-symbol">$</span>
              <input type="number" id="income-input" placeholder="60,000" min="0" step="1000" aria-label="Annual income after tax" />
            </div>
          </div>
        </div>

        <div class="input-row">
          <div class="input-group">
            <label for="expenses-input" class="input-label">Annual Expenses</label>
            <div class="input-wrapper">
              <span class="currency-symbol">$</span>
              <input type="number" id="expenses-input" placeholder="36,000" min="0" step="1000" aria-label="Annual expenses" />
            </div>
          </div>

          <div class="input-group">
            <label for="savings-input" class="input-label">Current Savings / Investments</label>
            <div class="input-wrapper">
              <span class="currency-symbol">$</span>
              <input type="number" id="savings-input" placeholder="50,000" min="0" step="1000" value="0" aria-label="Current total savings and investments" />
            </div>
          </div>
        </div>

        <div class="input-row">
          <div class="input-group">
            <label for="return-input" class="input-label">Expected Annual Return</label>
            <div class="input-wrapper">
              <span class="currency-symbol">%</span>
              <input type="number" id="return-input" placeholder="7" min="0" max="20" step="0.5" value="7" aria-label="Expected annual return rate" />
            </div>
            <span class="input-hint">S&P 500 historical avg: ~7% after inflation</span>
          </div>

          <div class="input-group">
            <label for="swr-input" class="input-label">Safe Withdrawal Rate</label>
            <div class="input-wrapper">
              <span class="currency-symbol">%</span>
              <input type="number" id="swr-input" placeholder="4" min="2" max="6" step="0.25" value="4" aria-label="Safe withdrawal rate" />
            </div>
            <span class="input-hint">Traditional: 4% (Trinity Study)</span>
          </div>
        </div>
      </div>

      <!-- Results -->
      <div id="results-section" style="display:none;">
        <div class="results-grid">
          <div class="result-card fire-card">
            <div class="result-header">
              <span class="result-icon">&#128293;</span>
              <div>
                <h3>Your FIRE Number</h3>
                <p class="result-amount" id="fire-number">$0</p>
              </div>
            </div>
            <p class="result-tip" id="fire-tip">Amount needed to retire, based on the 4% rule.</p>
          </div>

          <div class="result-card years-card">
            <div class="result-header">
              <span class="result-icon">&#9200;</span>
              <div>
                <h3>Years to FIRE</h3>
                <p class="result-amount" id="years-result">0</p>
              </div>
            </div>
            <p class="result-tip" id="fi-age-tip">You'll reach FI at age —</p>
          </div>

          <div class="result-card rate-card">
            <div class="result-header">
              <span class="result-icon">&#128176;</span>
              <div>
                <h3>Your Savings Rate</h3>
                <p class="result-amount" id="savings-rate-result">0%</p>
              </div>
            </div>
            <p class="result-tip" id="rate-tip">Higher savings rate = faster FI</p>
          </div>
        </div>

        <!-- Progress bar -->
        <div class="progress-card">
          <h3>Progress to FIRE</h3>
          <div class="progress-bar-container">
            <div class="progress-bar" id="progress-bar"></div>
          </div>
          <div class="progress-labels">
            <span id="progress-current">$0 saved</span>
            <span id="progress-target">$0 goal</span>
          </div>
          <p class="progress-pct" id="progress-pct">0% there</p>
        </div>

        <!-- Savings rate impact -->
        <div class="impact-card">
          <h3>Savings Rate Impact</h3>
          <p class="impact-desc">See how different savings rates change your timeline to financial independence:</p>
          <div class="impact-table-wrapper">
            <table class="impact-table" id="impact-table">
              <thead>
                <tr>
                  <th>Savings Rate</th>
                  <th>Monthly Savings</th>
                  <th>Years to FI</th>
                  <th>FI Age</th>
                </tr>
              </thead>
              <tbody id="impact-tbody"></tbody>
            </table>
          </div>
        </div>

        <!-- Net Worth Projection Chart -->
        <div class="chart-card">
          <h3>Net Worth Projection</h3>
          <div class="chart-container" id="chart-container"></div>
          <div class="chart-legend">
            <span class="legend-item"><span class="legend-dot contrib-dot"></span> Contributions</span>
            <span class="legend-item"><span class="legend-dot growth-dot"></span> Investment Growth</span>
            <span class="legend-item"><span class="legend-dot fire-line-dot"></span> FIRE Number</span>
          </div>
        </div>

        <!-- Monthly breakdown -->
        <div class="breakdown-card">
          <h3>Your Monthly Budget Split</h3>
          <div class="budget-split">
            <div class="split-item save-split">
              <span class="split-amount" id="monthly-savings">$0</span>
              <span class="split-label">Saved / Invested</span>
            </div>
            <div class="split-divider">vs</div>
            <div class="split-item spend-split">
              <span class="split-amount" id="monthly-expenses">$0</span>
              <span class="split-label">Spent</span>
            </div>
          </div>
        </div>
      </div>

      <div id="warning-card" style="display:none;" class="warning-card">
        <p id="warning-text"></p>
      </div>
    </div>
  </section>

  <section class="tool-cta">
    <div class="tool-container">
      <div class="cta-card">
        <h2>Track Your Path to Financial Independence</h2>
        <p>Knowing your FIRE number is just the start. Track your net worth, savings rate, and investment growth monthly with our <strong>free Net Worth Tracker</strong>.</p>
        <a href="https://gettidyflow.gumroad.com" target="_blank" rel="noopener" class="cta-button">Get Free Net Worth Tracker &rarr;</a>
      </div>
    </div>
  </section>

  <section class="tool-content">
    <div class="tool-container content-narrow">
      <h2>How This FIRE Calculator Works</h2>
      <p>Enter your income, expenses, current savings, and expected investment returns. The calculator determines your FIRE number (the portfolio size needed to cover your expenses indefinitely using the safe withdrawal rate), then projects year-by-year growth to show when you'll reach financial independence.</p>

      <h2>What Is FIRE?</h2>
      <p>FIRE stands for <strong>Financial Independence, Retire Early</strong>. The core idea is simple: save and invest aggressively so your investment returns can cover your living expenses — freeing you from needing a paycheck. There are several variations:</p>
      <ul>
        <li><strong>Lean FIRE</strong> — reaching FI on minimal expenses (under $40k/year)</li>
        <li><strong>Regular FIRE</strong> — standard FI with comfortable but not lavish spending</li>
        <li><strong>Fat FIRE</strong> — FI with a higher lifestyle ($100k+/year)</li>
        <li><strong>Barista FIRE</strong> — partial FI where you work part-time for benefits and small income</li>
      </ul>

      <h2>Why Savings Rate Matters More Than Income</h2>
      <p>Your savings rate is the single most important factor in reaching FIRE. Here's why:</p>
      <ul>
        <li><strong>At 10% savings rate</strong>, you'll work ~51 years before FI</li>
        <li><strong>At 25% savings rate</strong>, it drops to ~32 years</li>
        <li><strong>At 50% savings rate</strong>, you're looking at ~17 years</li>
        <li><strong>At 75% savings rate</strong>, you could reach FI in ~7 years</li>
      </ul>
      <p>A higher savings rate works double: you save more AND you prove you can live on less — meaning your FIRE number is lower. Use our <a href="/tools/savings-rate-calculator">Savings Rate Calculator</a> to find yours.</p>

      <h2>The 4% Rule Explained</h2>
      <p>The 4% rule (from the Trinity Study) states that if you withdraw 4% of your portfolio in year one and adjust for inflation each year after, your money has a 95%+ chance of lasting 30 years. For early retirees planning for 40-50+ years, consider a more conservative 3.25-3.5% withdrawal rate.</p>

      <h2>Related Tools</h2>
      <ul>
        <li><a href="/tools/savings-rate-calculator">Savings Rate Calculator</a></li>
        <li><a href="/tools/investment-return-calculator">Investment Return Calculator</a></li>
        <li><a href="/tools/compound-interest-calculator">Compound Interest Calculator</a></li>
        <li><a href="/tools/retirement-savings-calculator">Retirement Savings Calculator</a></li>
        <li><a href="/tools/net-worth-calculator">Net Worth Calculator</a></li>
      </ul>

      <h2>Frequently Asked Questions</h2>
      <details>
        <summary>What is the FIRE number?</summary>
        <p>Your FIRE number is the amount of money you need invested to live off the returns. It's typically 25 times your annual expenses, based on the 4% safe withdrawal rate. For example, if you spend $40,000 per year, your FIRE number is $1,000,000.</p>
      </details>
      <details>
        <summary>What is a good savings rate for FIRE?</summary>
        <p>A 50%+ savings rate can get you to financial independence in about 17 years. At 70%, you could reach FI in roughly 8.5 years. The average American saves about 5-10%, which means working 40+ years. The higher your savings rate, the faster you reach FI — and the less you need to save because you're accustomed to living on less.</p>
      </details>
      <details>
        <summary>Is the 4% rule still valid?</summary>
        <p>The 4% rule (Trinity Study) showed that a 4% withdrawal rate survived 95% of 30-year periods historically. For early retirees with 40-50+ year horizons, many experts suggest using 3.25-3.5% for extra safety. This calculator lets you adjust the withdrawal rate to see the impact.</p>
      </details>
    </div>
  </section>
</BaseLayout>

<style>
  .tool-hero {
    background: linear-gradient(135deg, #f6ad55 0%, #ed8936 50%, #dd6b20 100%);
    padding: 4rem 1.5rem 3rem;
    text-align: center;
    color: #fff;
  }
  .tool-hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .tool-badge {
    display: inline-block;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(4px);
    padding: 0.35rem 1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }
  .tool-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1rem;
  }
  .gradient-text {
    background: linear-gradient(90deg, #fefcbf, #fff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .tool-subtitle {
    font-size: 1.1rem;
    opacity: 0.92;
    line-height: 1.6;
    margin: 0;
  }

  .tool-app {
    padding: 2.5rem 1.5rem;
    background: #f8f9fb;
  }
  .tool-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .calc-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    margin-bottom: 2rem;
  }
  .input-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .input-group {
    margin-bottom: 0.5rem;
  }
  .input-label {
    display: block;
