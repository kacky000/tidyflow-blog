<script>
  const challengeSelect = document.getElementById('challenge-type') as HTMLSelectElement;
  const startingInput = document.getElementById('starting-amount') as HTMLInputElement;
  const incrementInput = document.getElementById('increment') as HTMLInputElement;
  const incrementLabel = document.getElementById('increment-label')!;
  const startingHint = document.getElementById('starting-hint')!;
  const incrementHint = document.getElementById('increment-hint')!;
  const infoText = document.getElementById('info-text')!;
  const resultsSection = document.getElementById('results-section')!;

  let showFull = false;

  function formatCurrency(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function formatCurrencyShort(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  interface PeriodData {
    period: number;
    label: string;
    amount: number;
    cumulative: number;
  }

  const challengeConfig: Record<string, { defaultStart: number; defaultIncrement: number; startLabel: string; startHint: string; incLabel: string; incHint: string; info: string }> = {
    '52-week': {
      defaultStart: 1, defaultIncrement: 1,
      startLabel: 'Week 1 Amount', startHint: 'Amount you save in week 1',
      incLabel: 'Weekly Increment', incHint: 'How much more you save each week',
      info: '<strong>52-Week Challenge:</strong> Start by saving $1 in week 1, then $2 in week 2, increasing by $1 each week. By week 52 you save $52. Total with defaults: <strong>$1,378</strong>. Simple, effective, and builds the habit gradually.'
    },
    '52-week-reverse': {
      defaultStart: 52, defaultIncrement: 1,
      startLabel: 'Week 1 Amount', startHint: 'Start with the biggest amount',
      incLabel: 'Weekly Decrease', incHint: 'How much less you save each week',
      info: '<strong>52-Week Reverse:</strong> Save the biggest amount first ($52 in week 1) and decrease by $1 each week. Same $1,378 total, but front-loads the hard part when motivation is highest. Holiday season becomes easy.'
    },
    '365-penny': {
      defaultStart: 0.01, defaultIncrement: 0.01,
      startLabel: 'Day 1 Amount', startHint: 'Amount you save on day 1',
      incLabel: 'Daily Increment', incHint: 'How much more you save each day',
      info: '<strong>365-Day Penny Challenge:</strong> Save 1 cent on day 1, 2 cents on day 2, up to $3.65 on day 365. Total with defaults: <strong>$667.95</strong>. Ultra-low barrier to start — perfect for beginners.'
    },
    'no-spend': {
      defaultStart: 15, defaultIncrement: 0,
      startLabel: 'Per No-Spend Day', startHint: 'Amount saved each no-spend day',
      incLabel: 'No-Spend Days/Week', incHint: 'How many no-spend days per week (1-7)',
      info: '<strong>No-Spend Challenge:</strong> Choose 2-3 days per week where you spend nothing beyond essentials. Transfer a fixed amount to savings on each no-spend day. 3 days/week at $15/day = <strong>$2,340/year</strong>.'
    },
    'round-up': {
      defaultStart: 1.50, defaultIncrement: 0,
      startLabel: 'Avg. Daily Round-Up', startHint: 'Average spare change per day',
      incLabel: 'Transactions/Day', incHint: 'Average number of daily purchases',
      info: '<strong>Round-Up Challenge:</strong> Round every purchase to the next dollar and save the difference. With 3-5 transactions/day and an average round-up of $0.50, you save <strong>$550-900/year</strong> without even noticing.'
    },
    'biweekly': {
      defaultStart: 100, defaultIncrement: 0,
      startLabel: 'Bi-Weekly Amount', startHint: 'Fixed amount every 2 weeks',
      incLabel: 'Increase per Period', incHint: 'Optional: raise amount each period',
      info: '<strong>Bi-Weekly Challenge:</strong> Save a fixed amount every 2 weeks (26 pay periods/year). At $100 per period, you save <strong>$2,600/year</strong>. Aligns perfectly with most paycheck schedules.'
    }
  };

  function updateUI() {
    const type = challengeSelect.value;
    const config = challengeConfig[type];
    startingInput.placeholder = String(config.defaultStart);
    incrementInput.placeholder = String(config.defaultIncrement);
    startingHint.textContent = config.startHint;
    incrementLabel.textContent = config.incLabel;
    incrementHint.textContent = config.incHint;
    infoText.innerHTML = config.info;
  }

  function generateData(type: string, start: number, increment: number): PeriodData[] {
    const data: PeriodData[] = [];
    let cumulative = 0;

    if (type === '52-week') {
      for (let w = 1; w <= 52; w++) {
        const amount = start + (w - 1) * increment;
        cumulative += amount;
        data.push({ period: w, label: `Week ${w}`, amount, cumulative });
      }
    } else if (type === '52-week-reverse') {
      for (let w = 1; w <= 52; w++) {
        const amount = Math.max(start - (w - 1) * increment, 0);
        cumulative += amount;
        data.push({ period: w, label: `Week ${w}`, amount, cumulative });
      }
    } else if (type === '365-penny') {
      for (let d = 1; d <= 365; d++) {
        const amount = start + (d - 1) * increment;
        cumulative += amount;
        data.push({ period: d, label: `Day ${d}`, amount, cumulative });
      }
    } else if (type === 'no-spend') {
      const daysPerWeek = Math.min(Math.max(increment || 3, 1), 7);
      for (let w = 1; w <= 52; w++) {
        const amount = start * daysPerWeek;
        cumulative += amount;
        data.push({ period: w, label: `Week ${w}`, amount, cumulative });
      }
    } else if (type === 'round-up') {
      const txPerDay = Math.max(increment || 3, 1);
      const dailyAmount = start * txPerDay;
      for (let w = 1; w <= 52; w++) {
        const amount = dailyAmount * 7;
        cumulative += amount;
        data.push({ period: w, label: `Week ${w}`, amount, cumulative });
      }
    } else if (type === 'biweekly') {
      for (let p = 1; p <= 26; p++) {
        const amount = start + (p - 1) * increment;
        cumulative += amount;
        data.push({ period: p, label: `Period ${p}`, amount, cumulative });
      }
    }

    return data;
  }

  function calculate() {
    const type = challengeSelect.value;
    const config = challengeConfig[type];
    const start = parseFloat(startingInput.value) || config.defaultStart;
    const increment = parseFloat(incrementInput.value) || config.defaultIncrement;

    const data = generateData(type, start, increment);

    if (data.length === 0) {
      resultsSection.style.display = 'none';
      return;
    }

    resultsSection.style.display = 'block';

    const total = data[data.length - 1].cumulative;
    const weeks = type === '365-penny' ? 52 : (type === 'biweekly' ? 52 : data.length);
    const avgPerWeek = total / weeks;

    let durationText = '';
    if (type === '365-penny') durationText = '365 days';
    else if (type === 'biweekly') durationText = '26 periods';
    else durationText = `${data.length} weeks`;

    document.getElementById('stat-total')!.textContent = formatCurrencyShort(Math.round(total));
    document.getElementById('stat-duration')!.textContent = durationText;
    document.getElementById('stat-avg')!.textContent = formatCurrency(avgPerWeek);

    // Monthly bar chart
    const monthBars = document.getElementById('month-bars')!;
    const monthlyTotals: { label: string; amount: number }[] = [];

    if (type === '365-penny') {
      for (let m = 0; m < 12; m++) {
        const startDay = m * 30 + 1;
        const endDay = Math.min((m + 1) * 30, 365);
        let monthTotal = 0;
        for (let d = startDay; d <= endDay; d++) {
          if (d <= data.length) monthTotal += data[d - 1].amount;
        }
        monthlyTotals.push({ label: `Month ${m + 1}`, amount: monthTotal });
      }
      // Remaining days
      let remaining = 0;
      for (let d = 361; d <= 365; d++) {
        if (d <= data.length) remaining += data[d - 1].amount;
      }
      if (monthlyTotals.length === 12) monthlyTotals[11].amount += remaining;
    } else {
      const weeksPerMonth = type === 'biweekly' ? 2 : 4;
      const periods = data.length;
      const months = type === 'biweekly' ? 13 : 12;
      for (let m = 0; m < months; m++) {
        const startIdx = m * weeksPerMonth;
        const endIdx = Math.min((m + 1) * weeksPerMonth, periods);
        let monthTotal = 0;
        for (let i = startIdx; i < endIdx; i++) {
          monthTotal += data[i].amount;
        }
        if (monthTotal > 0) {
          monthlyTotals.push({ label: `Month ${m + 1}`, amount: monthTotal });
        }
      }
    }

    const maxMonthly = Math.max(...monthlyTotals.map(m => m.amount), 1);
    monthBars.innerHTML = monthlyTotals.map(m => {
      const pct = (m.amount / maxMonthly) * 100;
      return `<div class="month-bar-row">
        <span class="month-bar-label">${m.label}</span>
        <div class="month-bar-track">
          <div class="month-bar-fill" style="width:${pct}%"></div>
        </div>
        <span class="month-bar-amount">${formatCurrencyShort(Math.round(m.amount))}</span>
      </div>`;
    }).join('');

    // Table
    renderTable(data, type);

    // Tip
    const tipCard = document.getElementById('tip-card')!;
    const tipText = document.getElementById('tip-text')!;
    tipCard.style.display = 'flex';

    if (total > 2000) {
      tipText.innerHTML = `This challenge will save you <strong>${formatCurrencyShort(Math.round(total))}</strong> — that is enough for an emergency fund starter, a vacation, or a serious dent in your debt. Put it in a high-yield savings account to earn an extra 4-5% on top.`;
    } else if (total > 1000) {
      tipText.innerHTML = `<strong>${formatCurrencyShort(Math.round(total))}</strong> in savings is a solid emergency fund starter. Want to save more? Try increasing the starting amount or combining this with a no-spend challenge.`;
    } else {
      tipText.innerHTML = `Every dollar counts. <strong>${formatCurrencyShort(Math.round(total))}</strong> is a great start. Once you complete this challenge, level up to a higher starting amount or try stacking multiple challenges together.`;
    }
  }

  function renderTable(data: PeriodData[], type: string) {
    const thead = document.getElementById('breakdown-thead')!;
    const tbody = document.getElementById('breakdown-tbody')!;

    thead.innerHTML = `<tr><th>${type === '365-penny' ? 'Day' : (type === 'biweekly' ? 'Period' : 'Week')}</th><th>Amount</th><th>Cumulative</th></tr>`;

    let rows = data;
    if (!showFull) {
      // Show summary: first 4, ... , last 4, plus milestones
      if (data.length > 16) {
        const milestoneIndices = new Set<number>();
        milestoneIndices.add(0);
        milestoneIndices.add(1);
        milestoneIndices.add(2);
        milestoneIndices.add(3);
        milestoneIndices.add(Math.floor(data.length * 0.25));
        milestoneIndices.add(Math.floor(data.length * 0.5));
        milestoneIndices.add(Math.floor(data.length * 0.75));
        milestoneIndices.add(data.length - 4);
        milestoneIndices.add(data.length - 3);
        milestoneIndices.add(data.length - 2);
        milestoneIndices.add(data.length - 1);

        const sorted = Array.from(milestoneIndices).sort((a, b) => a - b);
        rows = sorted.map(i => data[i]);
      }
    }

    tbody.innerHTML = rows.map((row, idx) => {
      const isLast = row.period === data[data.length - 1].period;
      const highlight = isLast ? 'highlight-row' : '';
      return `<tr class="${highlight}">
        <td>${row.label}</td>
        <td>${formatCurrency(row.amount)}</td>
        <td>${formatCurrency(row.cumulative)}</td>
      </tr>`;
    }).join('');
  }

  // Toggle buttons
  document.getElementById('btn-summary')!.addEventListener('click', () => {
    showFull = false;
    document.getElementById('btn-summary')!.classList.add('active');
    document.getElementById('btn-full')!.classList.remove('active');
    calculate();
  });

  document.getElementById('btn-full')!.addEventListener('click', () => {
    showFull = true;
    document.getElementById('btn-full')!.classList.add('active');
    document.getElementById('btn-summary')!.classList.remove('active');
    calculate();
  });

  challengeSelect.addEventListener('change', () => {
    updateUI();
    calculate();
  });

  [startingInput, incrementInput].forEach(el => {
    el.addEventListener('input', calculate);
    el.addEventListener('change', calculate);
  });

  // Initial
  updateUI();
  calculate();
</script>
