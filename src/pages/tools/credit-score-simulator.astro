  .action-item.negative:has(input:checked) { border-color: #fca5a5; background: #fef2f2; }
  .action-check { margin-right: 0.75rem; width: 18px; height: 18px; accent-color: #667eea; }
  .action-info { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
  .action-name { font-weight: 600; font-size: 1.02rem; color: #1a1a2e; }
  .action-impact { font-size: 0.9rem; font-weight: 700; }
  .positive-text { color: #16a34a; }
  .negative-text { color: #dc2626; }
  .action-desc { font-size: 0.88rem; color: #888; margin: 0.4rem 0 0; line-height: 1.45; }
  .results-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 2rem; }
  .result-card { background: #fff; border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border-left: 5px solid transparent; }
  .result-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; }
  .result-icon { font-size: 2rem; line-height: 1; }
  .result-header h3 { margin: 0; font-size: 1rem; font-weight: 600; color: #555; }
  .result-amount { margin: 0.15rem 0 0; font-size: 1.75rem; font-weight: 800; color: #1a1a2e; }
  .result-tip { font-size: 0.9rem; color: #666; line-height: 1.55; margin: 0; }
  .score-comparison { display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem; }
  .comparison-row { display: flex; align-items: center; gap: 1rem; }
  .comparison-label { font-weight: 700; font-size: 0.95rem; color: #555; width: 50px; text-align: right; }
  .comparison-row .score-bar { flex: 1; }
  .comparison-value { font-weight: 800; font-size: 1.1rem; color: #1a1a2e; width: 45px; }
  .tool-cta { padding: 2.5rem 1.5rem; background: #fff; }
  .cta-card { max-width: 800px; margin: 0 auto; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 20px; padding: 2.5rem; text-align: center; color: #fff; }
  .cta-card h2 { margin: 0 0 0.75rem; font-size: 1.5rem; font-weight: 800; }
  .cta-card p { margin: 0 0 1.5rem; opacity: 0.92; line-height: 1.6; }
  .cta-button { display: inline-block; background: #fff; color: #667eea; font-weight: 700; padding: 0.85rem 2rem; border-radius: 999px; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
  .cta-button:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.15); }
  .tool-content { padding: 3rem 1.5rem 4rem; background: #f8f9fb; }
  .content-narrow { max-width: 720px; margin: 0 auto; }
  .tool-content h2 { font-size: 1.4rem; font-weight: 800; color: #1a1a2e; margin: 2.5rem 0 0.75rem; }
  .tool-content h2:first-child { margin-top: 0; }
  .tool-content p, .tool-content li { font-size: 1.02rem; line-height: 1.7; color: #444; }
  .tool-content ul, .tool-content ol { padding-left: 1.25rem; margin: 0.5rem 0 1rem; }
  .tool-content li { margin-bottom: 0.35rem; }
  .tool-content a { color: #667eea; text-decoration: underline; text-underline-offset: 2px; }
  .tool-content details { background: #fff; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 0.75rem; box-shadow: 0 1px 4px rgba(0,0,0,0.04); }
  .tool-content summary { font-weight: 600; cursor: pointer; color: #1a1a2e; font-size: 1.02rem; }
  .tool-content details p { margin: 0.75rem 0 0; }
  @media (max-width: 640px) { .results-grid { grid-template-columns: 1fr; } .cta-card { padding: 2rem 1.5rem; } .action-info { flex-direction: column; align-items: flex-start; } .score-input-row { flex-direction: column; align-items: flex-start; } }
</style>

<script>
  const scoreInput = document.getElementById('current-score') as HTMLInputElement;
  const scoreRangeLabel = document.getElementById('current-range')!;
  const scoreFillCurrent = document.getElementById('score-fill-current')!;
  const simResults = document.getElementById('sim-results')!;
  const checkboxes = document.querySelectorAll('.action-check');

  interface ScoreRange { label: string; color: string; bg: string; }

  function getRange(score: number): ScoreRange {
    if (score >= 800) return { label: 'Excellent', color: '#667eea', bg: '#f0f3ff' };
    if (score >= 740) return { label: 'Very Good', color: '#22c55e', bg: '#f0fdf4' };
    if (score >= 670) return { label: 'Good', color: '#84cc16', bg: '#f7fee7' };
    if (score >= 580) return { label: 'Fair', color: '#f59e0b', bg: '#fffbeb' };
    return { label: 'Poor', color: '#ef4444', bg: '#fef2f2' };
  }

  function getRangeText(score: number): string {
    if (score >= 800) return 'Excellent (800-850)';
    if (score >= 740) return 'Very Good (740-799)';
    if (score >= 670) return 'Good (670-739)';
    if (score >= 580) return 'Fair (580-669)';
    return 'Poor (300-579)';
  }

  function scoreToPercent(score: number): number {
    return Math.max(0, Math.min(100, ((score - 300) / 550) * 100));
  }

  function updateCurrentScore() {
    const score = Math.max(300, Math.min(850, parseInt(scoreInput.value) || 300));
    const range = getRange(score);
    scoreRangeLabel.textContent = range.label;
    scoreRangeLabel.style.color = range.color;
    scoreRangeLabel.style.background = range.bg;
    scoreFillCurrent.style.width = scoreToPercent(score) + '%';
  }

  function simulate() {
    const currentScore = Math.max(300, Math.min(850, parseInt(scoreInput.value) || 300));
    let totalMin = 0;
    let totalMax = 0;
    let hasNegative = false;
    let selectedCount = 0;

    checkboxes.forEach(cb => {
      const input = cb as HTMLInputElement;
      if (input.checked) {
        selectedCount++;
        const min = parseInt(input.dataset.min || '0');
        const max = parseInt(input.dataset.max || '0');
        totalMin += min;
        totalMax += max;
        if (input.dataset.type === 'negative') hasNegative = true;
      }
    });

    if (selectedCount === 0) {
      simResults.style.display = 'none';
      return;
    }

    simResults.style.display = 'block';

    // Use midpoint of range for estimated score
    const avgChange = Math.round((totalMin + totalMax) / 2);
    const newScore = Math.max(300, Math.min(850, currentScore + avgChange));

    const currentRange = getRange(currentScore);
    const newRange = getRange(newScore);

    document.getElementById('res-current')!.textContent = String(currentScore);
    document.getElementById('res-current-range')!.textContent = getRangeText(currentScore);

    document.getElementById('res-new')!.textContent = String(newScore);
    document.getElementById('res-new-range')!.textContent = getRangeText(newScore);
    document.getElementById('res-new-range')!.style.color = newRange.color;

    const changeEl = document.getElementById('res-change')!;
    changeEl.textContent = (avgChange >= 0 ? '+' : '') + avgChange + ' pts';
    changeEl.style.color = avgChange >= 0 ? '#16a34a' : '#dc2626';

    const changeDesc = document.getElementById('res-change-desc')!;
    changeDesc.textContent = `Range: ${totalMin >= 0 ? '+' : ''}${totalMin} to ${totalMax >= 0 ? '+' : ''}${totalMax} points.`;

    const recoveryEl = document.getElementById('res-recovery')!;
    const recoveryDesc = document.getElementById('res-recovery-desc')!;
    if (hasNegative) {
      if (totalMin < -50) {
        recoveryEl.textContent = '6-12 mo';
        recoveryDesc.textContent = 'Major negative actions take 6-12 months to recover from with consistent positive behavior.';
      } else if (totalMin < -20) {
        recoveryEl.textContent = '3-6 mo';
        recoveryDesc.textContent = 'Moderate negative impact. Focus on on-time payments and low utilization to recover.';
      } else {
        recoveryEl.textContent = '1-3 mo';
        recoveryDesc.textContent = 'Minor negative impact. Should recover naturally within a few billing cycles.';
      }
    } else {
      recoveryEl.textContent = 'N/A';
      recoveryDesc.textContent = 'No negative actions selected. Your score should improve!';
    }

    // Update visual bars
    document.getElementById('bar-before')!.style.width = scoreToPercent(currentScore) + '%';
    document.getElementById('bar-before')!.style.background = currentRange.color;
    document.getElementById('val-before')!.textContent = String(currentScore);

    document.getElementById('bar-after')!.style.width = scoreToPercent(newScore) + '%';
    document.getElementById('bar-after')!.style.background = newRange.color;
    document.getElementById('val-after')!.textContent = String(newScore);

    // Color the new score result card border
    const newCardColor = avgChange >= 0 ? '#43e97b' : '#ef4444';
    document.getElementById('res-new-card')!.style.borderLeftColor = newCardColor;
  }

  scoreInput.addEventListener('input', () => { updateCurrentScore(); simulate(); });
  checkboxes.forEach(cb => cb.addEventListener('change', simulate));

  // Initialize
  updateCurrentScore();
</script>
