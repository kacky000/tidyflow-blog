---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Credit Score Simulator — See How Actions Affect Your Score';
const description = 'Free credit score simulator. Enter your current score, select financial actions, and instantly see how they could impact your credit score. No signup required.';
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Credit Score Simulator",
      "url": "https://gettidyflow.com/tools/credit-score-simulator",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": description
    })} />
  </Fragment>

  <section class="tool-hero">
    <div class="tool-hero-inner">
      <span class="tool-badge">Free Tool — No Signup Required</span>
      <h1>Credit Score <span class="gradient-text">Simulator</span></h1>
      <p class="tool-subtitle">Enter your current credit score, select actions you're considering, and see how each one could affect your score — before you make a move.</p>
    </div>
  </section>

  <section class="tool-app">
    <div class="tool-container">
      <div class="calc-card">
        <label for="current-score" class="input-label">Your Current Credit Score</label>
        <div class="score-input-row">
          <div class="input-wrapper" style="max-width:220px;">
            <span class="currency-symbol">#</span>
            <input type="number" id="current-score" placeholder="720" min="300" max="850" step="1" value="700" class="calc-input" />
          </div>
          <div class="score-range-label" id="current-range">Good</div>
        </div>
        <div class="score-bar-container">
          <div class="score-bar">
            <div class="score-fill" id="score-fill-current" style="width:55%;"></div>
          </div>
          <div class="score-labels">
            <span>300</span><span>Poor</span><span>Fair</span><span>Good</span><span>Very Good</span><span>Excellent</span><span>850</span>
          </div>
        </div>
      </div>

      <div class="calc-card">
        <h3 class="section-title">Select Actions to Simulate</h3>
        <p class="section-desc">Toggle the actions you're considering. Each shows an estimated score impact based on typical credit scoring models.</p>

        <div class="actions-list" id="actions-list">
          <label class="action-item positive">
            <input type="checkbox" class="action-check" data-min="20" data-max="50" data-type="positive" />
            <div class="action-info">
              <span class="action-name">Pay off credit card debt</span>
              <span class="action-impact positive-text">+20 to +50 pts</span>
            </div>
            <p class="action-desc">Reducing your credit utilization ratio is one of the fastest ways to boost your score.</p>
          </label>

          <label class="action-item positive">
            <input type="checkbox" class="action-check" data-min="10" data-max="20" data-type="positive" />
            <div class="action-info">
              <span class="action-name">Request a credit limit increase</span>
              <span class="action-impact positive-text">+10 to +20 pts</span>
            </div>
            <p class="action-desc">Higher limit with same spending lowers your utilization ratio. May involve a soft or hard pull.</p>
          </label>

          <label class="action-item positive">
            <input type="checkbox" class="action-check" data-min="5" data-max="15" data-type="positive" />
            <div class="action-info">
              <span class="action-name">Pay down mortgage balance</span>
              <span class="action-impact positive-text">+5 to +15 pts</span>
            </div>
            <p class="action-desc">Reducing installment loan balances gradually improves your score over time.</p>
          </label>

          <label class="action-item positive">
            <input type="checkbox" class="action-check" data-min="5" data-max="15" data-type="positive" />
            <div class="action-info">
              <span class="action-name">Become an authorized user on old account</span>
              <span class="action-impact positive-text">+5 to +15 pts</span>
            </div>
            <p class="action-desc">Being added to someone's old, well-managed account can boost your credit history length.</p>
          </label>

          <label class="action-item negative">
            <input type="checkbox" class="action-check" data-min="-10" data-max="-5" data-type="negative" />
            <div class="action-info">
              <span class="action-name">Open a new credit card</span>
              <span class="action-impact negative-text">-5 to -10 pts (short term)</span>
            </div>
            <p class="action-desc">Hard inquiry + lower average account age. Usually recovers in 3-6 months and can help long term.</p>
          </label>

          <label class="action-item negative">
            <input type="checkbox" class="action-check" data-min="-100" data-max="-50" data-type="negative" />
            <div class="action-info">
              <span class="action-name">Miss a payment (30+ days late)</span>
              <span class="action-impact negative-text">-50 to -100 pts</span>
            </div>
            <p class="action-desc">Late payments stay on your report for 7 years. The higher your score, the bigger the drop.</p>
          </label>

          <label class="action-item negative">
            <input type="checkbox" class="action-check" data-min="-25" data-max="-15" data-type="negative" />
            <div class="action-info">
              <span class="action-name">Close your oldest credit card</span>
              <span class="action-impact negative-text">-15 to -25 pts</span>
            </div>
            <p class="action-desc">Reduces total credit limit and average account age. Keep old cards open, even if unused.</p>
          </label>

          <label class="action-item negative">
            <input type="checkbox" class="action-check" data-min="-20" data-max="-10" data-type="negative" />
            <div class="action-info">
              <span class="action-name">Max out a credit card</span>
              <span class="action-impact negative-text">-10 to -20 pts</span>
            </div>
            <p class="action-desc">High utilization (above 30%) signals risk. Maxing out a card can cause an immediate drop.</p>
          </label>

          <label class="action-item negative">
            <input type="checkbox" class="action-check" data-min="-10" data-max="-5" data-type="negative" />
            <div class="action-info">
              <span class="action-name">Apply for an auto or personal loan</span>
              <span class="action-impact negative-text">-5 to -10 pts</span>
            </div>
            <p class="action-desc">Hard inquiry impact. Multiple loan inquiries within 14-45 days usually count as one.</p>
          </label>
        </div>
      </div>

      <!-- Results -->
      <div id="sim-results" style="display:none;">
        <div class="results-grid">
          <div class="result-card" style="border-left-color:#667eea;">
            <div class="result-header">
              <span class="result-icon">📊</span>
              <div><h3>Current Score</h3><p class="result-amount" id="res-current">700</p></div>
            </div>
            <p class="result-tip" id="res-current-range">Good (670-739)</p>
          </div>
          <div class="result-card" id="res-new-card" style="border-left-color:#43e97b;">
            <div class="result-header">
              <span class="result-icon">🎯</span>
              <div><h3>Estimated New Score</h3><p class="result-amount" id="res-new">700</p></div>
            </div>
            <p class="result-tip" id="res-new-range">Good (670-739)</p>
          </div>
          <div class="result-card" style="border-left-color:#f093fb;">
            <div class="result-header">
              <span class="result-icon">📈</span>
              <div><h3>Net Change</h3><p class="result-amount" id="res-change">+0</p></div>
            </div>
            <p class="result-tip" id="res-change-desc">Select actions above to simulate.</p>
          </div>
          <div class="result-card" style="border-left-color:#ffd86e;">
            <div class="result-header">
              <span class="result-icon">⏱️</span>
              <div><h3>Recovery Time</h3><p class="result-amount" id="res-recovery">—</p></div>
            </div>
            <p class="result-tip" id="res-recovery-desc">Estimated time to recover from negative actions.</p>
          </div>
        </div>

        <div class="calc-card" id="score-visual">
          <h3 class="section-title" style="text-align:center;">Score Comparison</h3>
          <div class="score-comparison">
            <div class="comparison-row">
              <span class="comparison-label">Before</span>
              <div class="score-bar"><div class="score-fill" id="bar-before" style="width:55%;background:#667eea;"></div></div>
              <span class="comparison-value" id="val-before">700</span>
            </div>
            <div class="comparison-row">
              <span class="comparison-label">After</span>
              <div class="score-bar"><div class="score-fill" id="bar-after" style="width:55%;background:#43e97b;"></div></div>
              <span class="comparison-value" id="val-after">700</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="tool-cta">
    <div class="tool-container">
      <div class="cta-card">
        <h2>Build a Budget That Builds Your Credit</h2>
        <p>A strong credit score starts with consistent, on-time payments. Track your bills and debt payoff plan with our free budget template.</p>
        <a href="https://gettidyflow.gumroad.com" target="_blank" rel="noopener" class="cta-button">Get the Free Budget Template &rarr;</a>
      </div>
    </div>
  </section>

  <section class="tool-content">
    <div class="tool-container content-narrow">
      <h2>How Credit Scores Work</h2>
      <p>Your credit score (FICO) is calculated from five factors, each with a different weight:</p>
      <ol>
        <li><strong>Payment history (35%)</strong> — have you paid on time? Even one missed payment can cause a significant drop.</li>
        <li><strong>Credit utilization (30%)</strong> — how much of your available credit are you using? Keep this under 30%, ideally under 10%.</li>
        <li><strong>Length of credit history (15%)</strong> — older accounts help. This is why you should keep old cards open.</li>
        <li><strong>Credit mix (10%)</strong> — having different types (credit cards, mortgage, auto loan) shows you can manage various debts.</li>
        <li><strong>New credit (10%)</strong> — too many recent applications signal risk. Each hard inquiry stays for 2 years.</li>
      </ol>

      <h2>Credit Score Ranges</h2>
      <ul>
        <li><strong>Excellent (800-850)</strong> — best rates on everything. Only 21% of Americans score here.</li>
        <li><strong>Very Good (740-799)</strong> — near-best rates. You qualify for most premium credit cards.</li>
        <li><strong>Good (670-739)</strong> — above average. You'll qualify for most loans but may not get the lowest rates.</li>
        <li><strong>Fair (580-669)</strong> — below average. Higher interest rates, fewer options, may need a cosigner.</li>
        <li><strong>Poor (300-579)</strong> — limited options. Focus on secured cards and on-time payments to rebuild.</li>
      </ul>

      <h2>Fastest Ways to Improve Your Credit Score</h2>
      <ol>
        <li><strong>Pay down credit card balances</strong> — the quickest impact. Going from 50% to 10% utilization can add 30-50 points in one billing cycle.</li>
        <li><strong>Set up autopay for minimums</strong> — never miss a payment again. Then pay extra manually.</li>
        <li><strong>Don't close old accounts</strong> — even if you don't use them. They help your average age and total limit.</li>
        <li><strong>Dispute errors on your report</strong> — 25% of credit reports contain errors. Check yours at annualcreditreport.com.</li>
        <li><strong>Become an authorized user</strong> — a family member's old, well-managed card can boost your history length.</li>
      </ol>

      <h2>Related Resources</h2>
      <ul>
        <li><a href="/blog/how-to-create-a-budget">How to Create a Budget from Scratch</a></li>
        <li><a href="/blog/budgeting-mistakes-to-avoid">Common Budgeting Mistakes to Avoid</a></li>
        <li><a href="/blog/monthly-budget-checklist">Monthly Budget Checklist</a></li>
        <li><a href="/tools/debt-payoff-calculator">Debt Payoff Calculator</a></li>
      </ul>

      <h2>Frequently Asked Questions</h2>
      <details>
        <summary>How long do negative marks stay on your credit report?</summary>
        <p>Most negative marks stay for <strong>7 years</strong> from the date of the delinquency. Bankruptcies remain for 7-10 years (Chapter 7 for 10, Chapter 13 for 7). Hard inquiries fall off after <strong>2 years</strong> but only affect your score for about 12 months. The impact of negative marks diminishes over time — a late payment from 5 years ago hurts far less than one from 5 months ago.</p>
      </details>
      <details>
        <summary>What is a good credit score?</summary>
        <p>A <strong>FICO score of 670 or above</strong> is generally considered "good." For the best interest rates on mortgages and auto loans, aim for <strong>740+</strong>. However, "good" depends on your goals — if you're just qualifying for an apartment rental, many landlords accept 620+. For premium rewards credit cards, you typically need 720+.</p>
      </details>
      <details>
        <summary>Does checking my own credit score lower it?</summary>
        <p><strong>No.</strong> Checking your own score is a "soft inquiry" and has zero impact. Only "hard inquiries" — when a lender checks your credit for a lending decision — affect your score. You should check your score regularly to monitor for errors and track progress.</p>
      </details>
      <details>
        <summary>How quickly can I raise my credit score?</summary>
        <p>The fastest method is <strong>paying down credit card balances</strong>, which can show results in 1-2 billing cycles (30-60 days). Getting errors removed takes 30-45 days. Building a thin credit file takes 6-12 months of consistent on-time payments. Recovering from a major negative event (bankruptcy, foreclosure) takes 2-3 years of responsible credit use to see meaningful improvement.</p>
      </details>
      <details>
        <summary>Is this simulator accurate?</summary>
        <p>This tool provides <strong>estimated ranges</strong> based on typical FICO scoring patterns. Actual impacts vary based on your complete credit profile — someone with a 780 score will see a bigger drop from a missed payment than someone with a 620. Use this as a directional guide, not a precise prediction. For your actual score, check with your bank or at annualcreditreport.com.</p>
      </details>
    </div>
  </section>
</BaseLayout>

<style>
  .tool-hero { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 4rem 1.5rem 3rem; text-align: center; color: #fff; }
  .tool-hero-inner { max-width: 720px; margin: 0 auto; }
  .tool-badge { display: inline-block; background: rgba(255,255,255,0.2); backdrop-filter: blur(4px); padding: 0.35rem 1rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 1.25rem; }
  .tool-hero h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; line-height: 1.15; margin: 0 0 1rem; }
  .gradient-text { background: linear-gradient(90deg, #ffd6e0, #ffecd2); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .tool-subtitle { font-size: 1.1rem; opacity: 0.92; line-height: 1.6; margin: 0; }
  .tool-app { padding: 2.5rem 1.5rem; background: #f8f9fb; }
  .tool-container { max-width: 800px; margin: 0 auto; }
  .calc-card { background: #fff; border-radius: 16px; padding: 2rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); margin-bottom: 2rem; }
  .input-label { display: block; font-weight: 700; font-size: 1.05rem; margin-bottom: 0.75rem; color: #1a1a2e; }
  .input-wrapper { position: relative; display: flex; align-items: center; }
  .currency-symbol { position: absolute; left: 1.25rem; font-size: 1.2rem; font-weight: 700; color: #667eea; }
