  .section-desc { font-size: 0.95rem; color: #666; margin: 0 0 1.25rem; line-height: 1.5; }
  .actions-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .action-item { display: block; padding: 1rem 1.25rem; border: 2px solid #e2e8f0; border-radius: 12px; cursor: pointer; transition: all 0.2s; }
  .action-item:hover { border-color: #cbd5e1; background: #fafbfc; }
  .action-item.positive input:checked ~ .action-info .action-name { color: #16a34a; }
  .action-item.negative input:checked ~ .action-info .action-name { color: #dc2626; }
  .action-item input:checked ~ .action-info { font-weight: 700; }
