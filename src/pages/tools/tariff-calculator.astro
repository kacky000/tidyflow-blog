</style>

<script>
  const TARIFF_RATES: Record<string, number> = {
    groceries: 0.026,
    electronics: 0.175,
    clothing: 0.142,
    auto: 0.108,
    home: 0.075,
    toys: 0.163,
  };

  const CATEGORIES = ['groceries', 'electronics', 'clothing', 'auto', 'home', 'toys'] as const;

  function formatCurrency(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function getInputValue(id: string): number {
    return parseFloat((document.getElementById(id) as HTMLInputElement).value) || 0;
  }

  function calculate(): void {
    const annualIncome = getInputValue('annual-income');
    const householdSize = parseInt((document.getElementById('household-size') as HTMLSelectElement).value);

    const spending: Record<string, number> = {};
    const impacts: Record<string, number> = {};
    let totalMonthly = 0;
    let maxImpact = 0;

    for (const cat of CATEGORIES) {
      spending[cat] = getInputValue(`spend-${cat}`);
      impacts[cat] = spending[cat] * TARIFF_RATES[cat];
      totalMonthly += impacts[cat];
      if (impacts[cat] > maxImpact) maxImpact = impacts[cat];
    }

    const totalYearly = totalMonthly * 12;

    // Show results
    const resultsSection = document.getElementById('results-section')!;
    resultsSection.style.display = 'block';

    document.getElementById('total-monthly')!.textContent = formatCurrency(Math.round(totalMonthly));
    document.getElementById('total-yearly')!.textContent = formatCurrency(Math.round(totalYearly));
    document.getElementById('comparison-amount')!.textContent = formatCurrency(Math.round(totalYearly));

    // Category results and bars
    for (const cat of CATEGORIES) {
      document.getElementById(`result-${cat}`)!.textContent = `+${formatCurrency(Math.round(impacts[cat]))}/mo`;
      const barWidth = maxImpact > 0 ? (impacts[cat] / maxImpact) * 100 : 0;
      (document.getElementById(`bar-${cat}`) as HTMLElement).style.width = `${barWidth}%`;
    }

    // Equivalence text
    const weeklyGroceries = spending.groceries > 0 ? spending.groceries / 4.33 : 150;
    const weeksOfGroceries = weeklyGroceries > 0 ? (totalYearly / weeklyGroceries).toFixed(1) : '0';

    let equivalenceHtml = `That's <strong>${weeksOfGroceries} weeks of groceries</strong>`;

    if (annualIncome > 0) {
      const dailyIncome = annualIncome / 365;
      const daysOfWork = (totalYearly / dailyIncome).toFixed(1);
      equivalenceHtml += ` or <strong>${daysOfWork} days of your household income</strong>`;
    }

    equivalenceHtml += ' lost to tariffs every year.';
    document.getElementById('equivalence-text')!.innerHTML = equivalenceHtml;

    // Smooth scroll to results
    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Update default spending when household size changes
  function updateDefaults(): void {
    const size = parseInt((document.getElementById('household-size') as HTMLSelectElement).value);
    const defaults: Record<string, number[]> = {
      // [1, 2, 3, 4, 5, 6, 7, 8] person defaults
      groceries:   [350, 630, 850, 1050, 1250, 1450, 1600, 1800],
      electronics: [100, 150, 170, 200, 220, 240, 260, 280],
      clothing:    [100, 170, 230, 300, 370, 430, 490, 550],
      auto:        [300, 400, 450, 500, 550, 600, 650, 700],
      home:        [80, 120, 140, 170, 190, 210, 230, 250],
      toys:        [0, 60, 100, 140, 180, 210, 240, 270],
    };
    for (const cat of CATEGORIES) {
      (document.getElementById(`spend-${cat}`) as HTMLInputElement).value = String(defaults[cat][size - 1]);
    }
  }

  document.getElementById('household-size')!.addEventListener('change', updateDefaults);
  document.getElementById('calculate-btn')!.addEventListener('click', calculate);

  // Also allow Enter key to trigger calculation
  document.querySelectorAll('input[type="number"]').forEach((input) => {
    input.addEventListener('keydown', (e: Event) => {
      if ((e as KeyboardEvent).key === 'Enter') calculate();
    });
  });
</script>
