<script>
  const input = document.getElementById('income-input') as HTMLInputElement;
  const resultsArea = document.getElementById('results-area')!;

  function formatCurrency(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function buildExamples(amount: number, category: 'needs' | 'wants' | 'savings'): string {
    const examples: Record<string, { name: string; pct: number }[]> = {
      needs: [
        { name: 'Rent / Mortgage', pct: 0.55 },
        { name: 'Groceries', pct: 0.18 },
        { name: 'Utilities (electric, water, gas)', pct: 0.08 },
        { name: 'Transportation', pct: 0.10 },
        { name: 'Insurance (health, car)', pct: 0.06 },
        { name: 'Minimum debt payments', pct: 0.03 },
      ],
      wants: [
        { name: 'Dining out & takeout', pct: 0.30 },
        { name: 'Streaming & subscriptions', pct: 0.10 },
        { name: 'Shopping (clothes, electronics)', pct: 0.25 },
        { name: 'Hobbies & entertainment', pct: 0.15 },
        { name: 'Vacations & travel fund', pct: 0.15 },
        { name: 'Personal care & gym', pct: 0.05 },
      ],
      savings: [
        { name: 'Emergency fund', pct: 0.30 },
        { name: '401(k) / IRA contributions', pct: 0.35 },
        { name: 'Extra debt payments', pct: 0.15 },
        { name: 'Investments (stocks, index funds)', pct: 0.15 },
        { name: 'Short-term savings goals', pct: 0.05 },
      ],
    };

    return examples[category]
      .map(e => `<li><span class="ex-name">${e.name}</span><span class="ex-amount">${formatCurrency(Math.round(amount * e.pct))}</span></li>`)
      .join('');
  }

  function calculate() {
    const income = parseFloat(input.value) || 0;
    if (income <= 0) {
      resultsArea.style.display = 'none';
      return;
    }

    const needs = income * 0.5;
    const wants = income * 0.3;
    const savings = income * 0.2;

    resultsArea.style.display = 'block';

    document.getElementById('needs-amount')!.textContent = formatCurrency(needs);
    document.getElementById('wants-amount')!.textContent = formatCurrency(wants);
    document.getElementById('savings-amount')!.textContent = formatCurrency(savings);

    (document.getElementById('bar-needs') as HTMLElement).style.width = '50%';
    (document.getElementById('bar-wants') as HTMLElement).style.width = '30%';
    (document.getElementById('bar-savings') as HTMLElement).style.width = '20%';

    document.getElementById('needs-examples')!.innerHTML = buildExamples(needs, 'needs');
    document.getElementById('wants-examples')!.innerHTML = buildExamples(wants, 'wants');
    document.getElementById('savings-examples')!.innerHTML = buildExamples(savings, 'savings');

    document.getElementById('yearly-needs')!.textContent = formatCurrency(needs * 12);
    document.getElementById('yearly-wants')!.textContent = formatCurrency(wants * 12);
    document.getElementById('yearly-savings')!.textContent = formatCurrency(savings * 12);
    document.getElementById('yearly-total')!.textContent = formatCurrency(income * 12);

    // Update URL for sharing
    const url = new URL(window.location.href);
    url.searchParams.set('income', String(income));
    window.history.replaceState({}, '', url.toString());
  }

  // Share button
  document.getElementById('share-btn')!.addEventListener('click', () => {
    const income = parseFloat(input.value) || 0;
    if (income <= 0) return;
    const url = new URL(window.location.href);
    url.searchParams.set('income', String(income));
    navigator.clipboard.writeText(url.toString()).then(() => {
      const feedback = document.getElementById('share-feedback')!;
      feedback.style.display = 'inline';
      setTimeout(() => { feedback.style.display = 'none'; }, 2500);
    });
  });

  // Load from URL params on page load
  const urlParams = new URLSearchParams(window.location.search);
  const incomeParam = urlParams.get('income');
  if (incomeParam) {
    input.value = incomeParam;
    calculate();
  }

  input.addEventListener('input', calculate);
</script>
