<script>
  const annualIncomeEl = document.getElementById('annual-income') as HTMLInputElement;
  const monthlyDebtsEl = document.getElementById('monthly-debts') as HTMLInputElement;
  const downPaymentEl = document.getElementById('down-payment') as HTMLInputElement;
  const interestRateEl = document.getElementById('interest-rate') as HTMLInputElement;
  const loanTermEl = document.getElementById('loan-term') as HTMLSelectElement;
  const propertyTaxRateEl = document.getElementById('property-tax-rate') as HTMLInputElement;
  const homeInsuranceEl = document.getElementById('home-insurance') as HTMLInputElement;

  function formatCurrency(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function calculate() {
    const annualIncome = parseFloat(annualIncomeEl.value) || 0;
    const monthlyDebts = parseFloat(monthlyDebtsEl.value) || 0;
    const downPayment = parseFloat(downPaymentEl.value) || 0;
    const annualRate = (parseFloat(interestRateEl.value) || 0) / 100;
    const loanTermYears = parseInt(loanTermEl.value) || 30;
    const propertyTaxRate = (parseFloat(propertyTaxRateEl.value) || 0) / 100;
    const annualInsurance = parseFloat(homeInsuranceEl.value) || 0;

    const monthlyGrossIncome = annualIncome / 12;

    // 28/36 rule
    const maxHousingBy28 = monthlyGrossIncome * 0.28;
    const maxHousingBy36 = monthlyGrossIncome * 0.36 - monthlyDebts;
    const maxMonthlyHousing = Math.max(0, Math.min(maxHousingBy28, maxHousingBy36));

    // We need to solve for homePrice where:
    // maxMonthlyHousing = mortgagePayment + monthlyTax + monthlyIns
    // monthlyTax = homePrice * propertyTaxRate / 12
    // monthlyIns = annualInsurance / 12
    // mortgagePayment = (homePrice - downPayment) * [r(1+r)^n] / [(1+r)^n - 1]
    // where r = monthly rate, n = total months

    const monthlyRate = annualRate / 12;
    const totalMonths = loanTermYears * 12;
    const monthlyInsurance = annualInsurance / 12;

    // Available for mortgage + tax after subtracting insurance
    const availableForMortgageAndTax = maxMonthlyHousing - monthlyInsurance;

    let maxHomePrice = 0;
    let monthlyMortgage = 0;
    let monthlyTax = 0;

    if (availableForMortgageAndTax > 0 && annualIncome > 0) {
      if (monthlyRate > 0) {
        // mortgagePayment = loanAmount * factor
        // where factor = r(1+r)^n / ((1+r)^n - 1)
        const compounded = Math.pow(1 + monthlyRate, totalMonths);
        const factor = (monthlyRate * compounded) / (compounded - 1);

        // availableForMortgageAndTax = (homePrice - downPayment) * factor + homePrice * propertyTaxRate / 12
        // availableForMortgageAndTax = homePrice * factor - downPayment * factor + homePrice * propertyTaxRate / 12
        // availableForMortgageAndTax + downPayment * factor = homePrice * (factor + propertyTaxRate / 12)
        // homePrice = (availableForMortgageAndTax + downPayment * factor) / (factor + propertyTaxRate / 12)

        const denominator = factor + propertyTaxRate / 12;
        if (denominator > 0) {
          maxHomePrice = (availableForMortgageAndTax + downPayment * factor) / denominator;
        }
      } else {
        // 0% interest: mortgagePayment = loanAmount / totalMonths
        // availableForMortgageAndTax = (homePrice - downPayment) / totalMonths + homePrice * propertyTaxRate / 12
        // availableForMortgageAndTax = homePrice / totalMonths - downPayment / totalMonths + homePrice * propertyTaxRate / 12
        // availableForMortgageAndTax + downPayment / totalMonths = homePrice * (1/totalMonths + propertyTaxRate / 12)
        const denominator = 1 / totalMonths + propertyTaxRate / 12;
        if (denominator > 0) {
          maxHomePrice = (availableForMortgageAndTax + downPayment / totalMonths) / denominator;
        }
      }

      // Ensure home price is at least the down payment (loan >= 0)
      maxHomePrice = Math.max(maxHomePrice, 0);

      const loanAmount = Math.max(maxHomePrice - downPayment, 0);

      if (monthlyRate > 0) {
        const compounded = Math.pow(1 + monthlyRate, totalMonths);
        monthlyMortgage = loanAmount * (monthlyRate * compounded) / (compounded - 1);
      } else {
        monthlyMortgage = totalMonths > 0 ? loanAmount / totalMonths : 0;
      }

      monthlyTax = maxHomePrice * propertyTaxRate / 12;
    }

    const totalMonthlyHousing = monthlyMortgage + monthlyTax + monthlyInsurance;

    // Update DOM
    document.getElementById('max-home-price')!.textContent = formatCurrency(Math.round(maxHomePrice));
    document.getElementById('monthly-mortgage')!.textContent = formatCurrency(Math.round(monthlyMortgage));
    document.getElementById('monthly-tax')!.textContent = formatCurrency(Math.round(monthlyTax));
    document.getElementById('monthly-insurance')!.textContent = formatCurrency(Math.round(monthlyInsurance));
    document.getElementById('total-monthly')!.textContent = formatCurrency(Math.round(totalMonthlyHousing));

    // DTI ratios
    const frontEndDTI = monthlyGrossIncome > 0 ? (totalMonthlyHousing / monthlyGrossIncome) * 100 : 0;
    const backEndDTI = monthlyGrossIncome > 0 ? ((totalMonthlyHousing + monthlyDebts) / monthlyGrossIncome) * 100 : 0;

    document.getElementById('dti-front')!.textContent = frontEndDTI.toFixed(1) + '%';
    document.getElementById('dti-back')!.textContent = backEndDTI.toFixed(1) + '%';

    const frontBar = document.getElementById('dti-bar-front') as HTMLElement;
    const backBar = document.getElementById('dti-bar-back') as HTMLElement;
    frontBar.style.width = Math.min(frontEndDTI, 50) * 2 + '%';
    backBar.style.width = Math.min(backEndDTI, 50) * 2 + '%';

    // Color the bars based on level
    if (frontEndDTI <= 28) {
      frontBar.style.background = 'linear-gradient(90deg, #43e97b, #38f9d7)';
    } else if (frontEndDTI <= 33) {
      frontBar.style.background = 'linear-gradient(90deg, #f6d365, #fda085)';
    } else {
      frontBar.style.background = 'linear-gradient(90deg, #f5576c, #ff6b6b)';
    }

    if (backEndDTI <= 33) {
      backBar.style.background = 'linear-gradient(90deg, #43e97b, #38f9d7)';
    } else if (backEndDTI <= 36) {
      backBar.style.background = 'linear-gradient(90deg, #f6d365, #fda085)';
    } else {
      backBar.style.background = 'linear-gradient(90deg, #f5576c, #ff6b6b)';
    }

    // DTI note
    const noteEl = document.getElementById('dti-note')!;
    if (backEndDTI <= 33) {
      noteEl.textContent = 'Your debt levels are conservative. You are in a strong position to qualify for a mortgage with favorable terms.';
    } else if (backEndDTI <= 36) {
      noteEl.textContent = 'Your debt levels are moderate. Most lenders will approve you, but consider paying down some debt for better rates.';
    } else {
      noteEl.textContent = 'Your debt levels are aggressive. Some lenders may still approve you, but this leaves little room for financial flexibility. Consider reducing debts first.';
    }

    // Result note
    const resultNote = document.getElementById('result-note')!;
    if (maxHousingBy36 < maxHousingBy28 && monthlyDebts > 0) {
      resultNote.textContent = 'Limited by the 36% total debt rule (your existing debts reduce borrowing power)';
    } else {
      resultNote.textContent = 'Based on the 28% housing cost rule';
    }
  }

  // Attach listeners to all inputs
  const allInputs = [annualIncomeEl, monthlyDebtsEl, downPaymentEl, interestRateEl, propertyTaxRateEl, homeInsuranceEl];
  allInputs.forEach(el => el.addEventListener('input', calculate));
  loanTermEl.addEventListener('change', calculate);

  // Calculate on page load
  calculate();
</script>
