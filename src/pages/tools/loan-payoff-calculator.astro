<script>
  const balanceInput = document.getElementById('loan-balance') as HTMLInputElement;
  const rateInput = document.getElementById('interest-rate') as HTMLInputElement;
  const paymentInput = document.getElementById('monthly-payment') as HTMLInputElement;
  const extraInput = document.getElementById('extra-payment') as HTMLInputElement;
  const resultsSection = document.getElementById('results-section')!;
  const errorCard = document.getElementById('error-card')!;
  const errorText = document.getElementById('error-text')!;

  let showFullSchedule = false;
  document.getElementById('toggle-schedule')!.addEventListener('click', () => {
    showFullSchedule = !showFullSchedule;
    document.getElementById('toggle-schedule')!.textContent = showFullSchedule ? 'Show Summary' : 'Show Full Schedule';
    calculate();
  });

  function formatCurrency(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function formatCurrencyCents(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function formatMonth(date: Date): string {
    return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  }

  interface AmortRow {
    month: number;
    payment: number;
    principal: number;
    interest: number;
    balance: number;
  }

  function amortize(balance: number, annualRate: number, monthlyPayment: number): AmortRow[] {
    const monthlyRate = annualRate / 100 / 12;
    const rows: AmortRow[] = [];
    let remaining = balance;
    let month = 0;
    const maxMonths = 600; // 50 year cap

    while (remaining > 0.01 && month < maxMonths) {
      month++;
      const interestCharge = remaining * monthlyRate;
      let payment = Math.min(monthlyPayment, remaining + interestCharge);
      let principal = payment - interestCharge;

      if (principal < 0) {
        // Payment doesn't cover interest
        remaining += (interestCharge - payment);
        rows.push({ month, payment, principal: -(interestCharge - payment), interest: interestCharge, balance: remaining });
        if (month >= maxMonths) break;
        continue;
      }

      remaining -= principal;
      if (remaining < 0.01) remaining = 0;

      rows.push({ month, payment, principal, interest: interestCharge, balance: remaining });
    }

    return rows;
  }

  function calculate() {
    const balance = parseFloat(balanceInput.value) || 0;
    const rate = parseFloat(rateInput.value) || 0;
    const payment = parseFloat(paymentInput.value) || 0;
    const extra = parseFloat(extraInput.value) || 0;

    if (balance <= 0) {
      resultsSection.style.display = 'none';
      errorCard.style.display = 'none';
      return;
    }

    if (payment <= 0) {
      resultsSection.style.display = 'none';
      errorCard.style.display = 'none';
      return;
    }

    // Check if payment covers interest
    const monthlyInterest = balance * (rate / 100 / 12);
    if (payment <= monthlyInterest && rate > 0) {
      resultsSection.style.display = 'none';
      errorCard.style.display = 'block';
      errorText.innerHTML = `Your monthly payment of <strong>${formatCurrency(payment)}</strong> does not cover the monthly interest of <strong>${formatCurrencyCents(monthlyInterest)}</strong>. Your balance will grow over time. Increase your payment to at least <strong>${formatCurrencyCents(monthlyInterest + 1)}</strong>.`;
      return;
    }

    errorCard.style.display = 'none';
    resultsSection.style.display = 'block';

    // Without extra payment
    const baseRows = amortize(balance, rate, payment);
    const baseTotalInterest = baseRows.reduce((s, r) => s + r.interest, 0);
    const baseTotalPaid = baseRows.reduce((s, r) => s + r.payment, 0);
    const baseMonths = baseRows.length;

    // With extra payment
    const totalPayment = payment + extra;
    const rows = amortize(balance, rate, totalPayment);
    const totalInterest = rows.reduce((s, r) => s + r.interest, 0);
    const totalPaid = rows.reduce((s, r) => s + r.payment, 0);
    const months = rows.length;

    // Stats
    const payoffDate = new Date();
    payoffDate.setMonth(payoffDate.getMonth() + months);
    document.getElementById('stat-payoff-date')!.textContent = formatMonth(payoffDate);
    document.getElementById('stat-months')!.textContent = months.toString();
    document.getElementById('stat-total-interest')!.textContent = formatCurrency(totalInterest);
    document.getElementById('stat-total-paid')!.textContent = formatCurrency(totalPaid);

    // Extra payment savings
    const savingsCard = document.getElementById('savings-card')!;
    if (extra > 0) {
      savingsCard.style.display = 'block';
      const monthsSaved = baseMonths - months;
      const interestSaved = baseTotalInterest - totalInterest;

      document.getElementById('savings-months')!.textContent = monthsSaved + ' months';
      document.getElementById('savings-interest')!.textContent = formatCurrency(interestSaved);

      const basePayoffDate = new Date();
      basePayoffDate.setMonth(basePayoffDate.getMonth() + baseMonths);
      document.getElementById('savings-original-date')!.textContent = formatMonth(basePayoffDate);
      document.getElementById('savings-new-date')!.textContent = formatMonth(payoffDate);
    } else {
      savingsCard.style.display = 'none';
    }

    // Principal vs Interest bar
    const principalPct = (balance / totalPaid) * 100;
    (document.getElementById('pie-bar-principal') as HTMLElement).style.width = principalPct + '%';
    document.getElementById('legend-principal')!.textContent = formatCurrency(balance);
    document.getElementById('legend-interest')!.textContent = formatCurrency(totalInterest);

    // Amortization table
    const tbody = document.getElementById('amort-tbody')!;
    let displayRows = rows;

    if (!showFullSchedule && rows.length > 12) {
      // Show first 6, ellipsis, last 6
      const first = rows.slice(0, 6);
      const last = rows.slice(-6);
      tbody.innerHTML = first.map(r =>
        `<tr><td>${r.month}</td><td>${formatCurrencyCents(r.payment)}</td><td>${formatCurrencyCents(r.principal)}</td><td>${formatCurrencyCents(r.interest)}</td><td>${formatCurrencyCents(r.balance)}</td></tr>`
      ).join('') +
      `<tr><td colspan="5" style="text-align:center;color:#999;font-style:italic;padding:0.75rem;">... ${rows.length - 12} more months ...</td></tr>` +
      last.map(r =>
        `<tr><td>${r.month}</td><td>${formatCurrencyCents(r.payment)}</td><td>${formatCurrencyCents(r.principal)}</td><td>${formatCurrencyCents(r.interest)}</td><td>${formatCurrencyCents(r.balance)}</td></tr>`
      ).join('');
    } else {
      tbody.innerHTML = displayRows.map(r =>
        `<tr><td>${r.month}</td><td>${formatCurrencyCents(r.payment)}</td><td>${formatCurrencyCents(r.principal)}</td><td>${formatCurrencyCents(r.interest)}</td><td>${formatCurrencyCents(r.balance)}</td></tr>`
      ).join('');
    }

    // Tip
    const tipCard = document.getElementById('tip-card')!;
    const tipText = document.getElementById('tip-text')!;
    tipCard.style.display = 'flex';

    if (extra === 0 && rate >= 5) {
      const testRows = amortize(balance, rate, payment + 100);
      const testInterest = testRows.reduce((s, r) => s + r.interest, 0);
      const saved = baseTotalInterest - testInterest;
      const monthsSaved = baseMonths - testRows.length;
      tipText.innerHTML = `Try adding just <strong>$100/month</strong> in extra payments. You would save <strong>${formatCurrency(saved)}</strong> in interest and pay off your loan <strong>${monthsSaved} months earlier</strong>. Enter it above to see the full impact.`;
    } else if (extra > 0) {
      const interestSaved = baseTotalInterest - totalInterest;
      tipText.innerHTML = `Your extra payment of <strong>${formatCurrency(extra)}/month</strong> saves you <strong>${formatCurrency(interestSaved)}</strong> in interest. That is a guaranteed return of ${rate}% on every extra dollar — better than most investments at this rate.`;
    } else if (months <= 12) {
      tipText.innerHTML = `You are almost there — just <strong>${months} months</strong> until you are debt-free. Stay the course and start planning what to do with that freed-up ${formatCurrency(payment)}/month.`;
    } else {
      tipText.innerHTML = `At your current rate, you will be debt-free in <strong>${Math.floor(months / 12)} years and ${months % 12} months</strong>. Consider increasing your payment to accelerate the process — even small amounts help.`;
    }
  }

  [balanceInput, rateInput, paymentInput, extraInput].forEach(el => {
    el.addEventListener('input', calculate);
    el.addEventListener('change', calculate);
  });
</script>
