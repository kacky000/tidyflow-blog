      grid-template-columns: 1fr;
    }
    .tax-grid > div:first-child {
      grid-column: auto;
    }
    .annual-grid {
      grid-template-columns: 1fr;
    }
    .cta-card {
      padding: 2rem 1.5rem;
    }
    .expense-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.35rem;
    }
    .input-wrapper-sm {
      max-width: 100%;
    }
    .pie-container {
      flex-direction: column;
    }
