</style>

<script>
  const revenueInput = document.getElementById('revenue-input') as HTMLInputElement;
  const expenseInputs = document.querySelectorAll('.expense-input') as NodeListOf<HTMLInputElement>;
  const hoursInput = document.getElementById('hours-input') as HTMLInputElement;
  const filingSelect = document.getElementById('filing-status') as HTMLSelectElement;
  const primaryIncomeInput = document.getElementById('primary-income') as HTMLInputElement;
  const stateTaxInput = document.getElementById('state-tax') as HTMLInputElement;
  const calcBtn = document.getElementById('calculate-btn') as HTMLButtonElement;
  const resultsSection = document.getElementById('results-section')!;

  function formatCurrency(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function getTotalExpenses(): number {
    let total = 0;
    expenseInputs.forEach(input => {
      total += parseFloat(input.value) || 0;
    });
    return total;
  }

  // Update total expenses display on any expense input change
  expenseInputs.forEach(input => {
    input.addEventListener('input', () => {
      document.getElementById('total-expenses')!.textContent = formatCurrency(getTotalExpenses());
    });
  });

  // 2025 federal tax brackets
  function getFederalMarginalRate(taxableIncome: number, status: string): number {
    if (status === 'married') {
      if (taxableIncome <= 23200) return 0.10;
      if (taxableIncome <= 94300) return 0.12;
      if (taxableIncome <= 201050) return 0.22;
      if (taxableIncome <= 383900) return 0.24;
      if (taxableIncome <= 487450) return 0.32;
      if (taxableIncome <= 731200) return 0.35;
      return 0.37;
    } else {
      if (taxableIncome <= 11600) return 0.10;
      if (taxableIncome <= 47150) return 0.12;
      if (taxableIncome <= 100525) return 0.22;
      if (taxableIncome <= 191950) return 0.24;
      if (taxableIncome <= 243725) return 0.32;
      if (taxableIncome <= 609350) return 0.35;
      return 0.37;
    }
  }

  function calculate(): void {
    const revenue = parseFloat(revenueInput.value) || 0;
    const expenses = getTotalExpenses();
    const hoursPerWeek = parseFloat(hoursInput.value) || 0;
    const primaryIncome = parseFloat(primaryIncomeInput.value) || 0;
    const stateTaxRate = (parseFloat(stateTaxInput.value) || 5) / 100;
    const status = filingSelect.value;

    if (revenue <= 0 || hoursPerWeek <= 0) {
      resultsSection.style.display = 'none';
      return;
    }

    const netMonthlyProfit = revenue - expenses;
    if (netMonthlyProfit <= 0) {
      // Still show results even if unprofitable
    }

    const netAnnualProfit = netMonthlyProfit * 12;

    // Self-employment tax: 15.3% on 92.35% of net profit
    const seBase = Math.max(0, netAnnualProfit * 0.9235);
    const seTaxAnnual = seBase * 0.153;
    const seTaxMonthly = seTaxAnnual / 12;

    // Deduction: half of SE tax from AGI
    const seDeduction = seTaxAnnual / 2;

    // Federal income tax on side hustle at marginal rate
    const combinedIncome = primaryIncome + Math.max(0, netAnnualProfit) - seDeduction;
    const marginalRate = getFederalMarginalRate(combinedIncome, status);
    const fedTaxAnnual = Math.max(0, netAnnualProfit - seDeduction) * marginalRate;
    const fedTaxMonthly = fedTaxAnnual / 12;

    // State tax
    const stateTaxAnnual = Math.max(0, netAnnualProfit) * stateTaxRate;
    const stateTaxMonthly = stateTaxAnnual / 12;

    // Take-home
    const totalTaxMonthly = seTaxMonthly + fedTaxMonthly + stateTaxMonthly;
    const takeHomeMonthly = netMonthlyProfit - totalTaxMonthly;
    const takeHomeAnnual = takeHomeMonthly * 12;

    // Real hourly rate
    const monthlyHours = hoursPerWeek * 4.33;
    const realHourlyRate = monthlyHours > 0 ? takeHomeMonthly / monthlyHours : 0;

    resultsSection.style.display = 'block';

    // Hero stat
    document.getElementById('real-hourly-rate')!.textContent = formatCurrency(Math.round(realHourlyRate * 100) / 100) + '/hr';

    const comparison = document.getElementById('wage-comparison')!;
    if (realHourlyRate >= 7.25) {
      comparison.textContent = `That's ${formatCurrency(Math.round((realHourlyRate - 7.25) * 100) / 100)} above federal minimum wage ($7.25/hr)`;
      comparison.className = 'hero-stat-comparison comparison-above';
    } else {
      comparison.textContent = `That's ${formatCurrency(Math.round((7.25 - realHourlyRate) * 100) / 100)} below federal minimum wage ($7.25/hr)`;
      comparison.className = 'hero-stat-comparison comparison-below';
    }

    // Monthly breakdown
    document.getElementById('res-gross')!.textContent = formatCurrency(revenue);
    document.getElementById('res-expenses')!.textContent = formatCurrency(expenses);
    document.getElementById('res-net')!.textContent = formatCurrency(Math.round(netMonthlyProfit));
    document.getElementById('res-se-tax')!.textContent = formatCurrency(Math.round(seTaxMonthly));
    document.getElementById('res-fed-tax')!.textContent = formatCurrency(Math.round(fedTaxMonthly));
    document.getElementById('res-state-tax')!.textContent = formatCurrency(Math.round(stateTaxMonthly));
    document.getElementById('res-take-home')!.textContent = formatCurrency(Math.round(takeHomeMonthly));

    // Annual
    document.getElementById('annual-gross')!.textContent = formatCurrency(revenue * 12);
    document.getElementById('annual-expenses')!.textContent = formatCurrency(expenses * 12);
    document.getElementById('annual-taxes')!.textContent = formatCurrency(Math.round(seTaxAnnual + fedTaxAnnual + stateTaxAnnual));
    document.getElementById('annual-take-home')!.textContent = formatCurrency(Math.round(takeHomeAnnual));

    // Worth-it assessment
    const worthCard = document.getElementById('worth-card')!;
    const worthMsg = document.getElementById('worth-message')!;
    worthCard.classList.remove('worth-positive', 'worth-neutral', 'worth-negative');

    if (realHourlyRate >= 25) {
      worthCard.classList.add('worth-positive');
      worthMsg.innerHTML = `<strong>Great side hustle!</strong> At ${formatCurrency(Math.round(realHourlyRate * 100) / 100)}/hr after taxes, your time is well-compensated. Consider scaling up — invest in automation, raise your prices, or increase your hours to grow this into a serious income stream.`;
    } else if (realHourlyRate >= 15) {
      worthCard.classList.add('worth-neutral');
      worthMsg.innerHTML = `<strong>Decent earnings.</strong> At ${formatCurrency(Math.round(realHourlyRate * 100) / 100)}/hr after taxes, you are making reasonable money. Look for ways to cut expenses, raise prices, or streamline your workflow to push into the $25+/hr range.`;
    } else {
      worthCard.classList.add('worth-negative');
      worthMsg.innerHTML = `<strong>Time for a reality check.</strong> At ${formatCurrency(Math.round(realHourlyRate * 100) / 100)}/hr after taxes, you may want to consider whether your time could be better invested elsewhere — in a higher-paying hustle, skill development, or overtime at your primary job.`;
    }

    // Pie chart
    const takeHomePct = revenue > 0 ? Math.max(0, takeHomeMonthly / revenue * 100) : 0;
    const expensePct = revenue > 0 ? expenses / revenue * 100 : 0;
    const seTaxPct = revenue > 0 ? seTaxMonthly / revenue * 100 : 0;
    const fedTaxPct = revenue > 0 ? fedTaxMonthly / revenue * 100 : 0;
    const stateTaxPct = revenue > 0 ? stateTaxMonthly / revenue * 100 : 0;

    const pieChart = document.getElementById('pie-chart')!;
    const segments: string[] = [];
    let cumulative = 0;

    const colors = [
      { label: 'Take-Home Profit', color: '#16a34a', pct: takeHomePct },
      { label: 'Expenses', color: '#6b7280', pct: expensePct },
      { label: 'SE Tax', color: '#dc2626', pct: seTaxPct },
      { label: 'Federal Tax', color: '#ea580c', pct: fedTaxPct },
      { label: 'State Tax', color: '#d97706', pct: stateTaxPct },
    ];

    colors.forEach(seg => {
      if (seg.pct > 0) {
        segments.push(`${seg.color} ${cumulative}% ${cumulative + seg.pct}%`);
        cumulative += seg.pct;
      }
    });

    // Fill remainder if percentages don't add up to 100 (negative profit scenarios)
    if (cumulative < 100) {
      segments.push(`#e5e7eb ${cumulative}% 100%`);
    }

    pieChart.style.background = `conic-gradient(${segments.join(', ')})`;

    // Legend
    const legend = document.getElementById('pie-legend')!;
    legend.innerHTML = '';
    colors.forEach(seg => {
      if (seg.pct > 0.5) {
        const item = document.createElement('div');
        item.className = 'legend-item';
        item.innerHTML = `<span class="legend-dot" style="background:${seg.color}"></span><span>${seg.label}: ${Math.round(seg.pct)}%</span>`;
        legend.appendChild(item);
      }
    });

    // Smooth scroll to results
    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  calcBtn.addEventListener('click', calculate);

  // Allow Enter key to trigger calculation
  document.querySelectorAll('input, select').forEach(el => {
    el.addEventListener('keydown', (e: Event) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        calculate();
      }
    });
  });
</script>
