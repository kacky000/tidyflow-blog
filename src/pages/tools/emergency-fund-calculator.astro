<script>
  const expenseIds = [
    'expense-rent', 'expense-utilities', 'expense-groceries',
    'expense-transport', 'expense-insurance', 'expense-debt', 'expense-other'
  ];
  const expenseInputs = expenseIds.map(id => document.getElementById(id) as HTMLInputElement);
  const currentSavingsInput = document.getElementById('current-savings') as HTMLInputElement;
  const monthlySavingsInput = document.getElementById('monthly-savings') as HTMLInputElement;
  const jobStabilitySelect = document.getElementById('job-stability') as HTMLSelectElement;

  const totalEssentialsEl = document.getElementById('total-essentials')!;
  const resultsSection = document.getElementById('results-section')!;
  const alreadyDone = document.getElementById('already-done')!;

  function formatCurrency(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function formatMonth(date: Date): string {
    return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  }

  function getRecommendedMonths(stability: string): number {
    switch (stability) {
      case 'very-stable': return 3;
      case 'somewhat-stable': return 6;
      case 'unstable': return 9;
      case 'self-employed': return 12;
      default: return 6;
    }
  }

  function calculate(): void {
    const totalEssentials = expenseInputs.reduce((sum, input) => sum + (parseFloat(input.value) || 0), 0);
    totalEssentialsEl.textContent = formatCurrency(totalEssentials);

    const currentSavings = parseFloat(currentSavingsInput.value) || 0;
    const monthlySavings = parseFloat(monthlySavingsInput.value) || 0;
    const stability = jobStabilitySelect.value;

    if (totalEssentials <= 0 || !stability) {
      resultsSection.style.display = 'none';
      alreadyDone.style.display = 'none';
      return;
    }

    const recommendedMonths = getRecommendedMonths(stability);
    const target = totalEssentials * recommendedMonths;

    // Tier amounts
    const starterAmount = totalEssentials * 3;
    const solidAmount = totalEssentials * 6;
    const fortressAmount = totalEssentials * 12;

    document.getElementById('tier-starter-amount')!.textContent = formatCurrency(starterAmount);
    document.getElementById('tier-solid-amount')!.textContent = formatCurrency(solidAmount);
    document.getElementById('tier-fortress-amount')!.textContent = formatCurrency(fortressAmount);

    // Highlight recommended tier
    document.getElementById('tier-starter')!.classList.toggle('recommended', recommendedMonths === 3);
    document.getElementById('tier-solid')!.classList.toggle('recommended', recommendedMonths === 6);
    document.getElementById('tier-fortress')!.classList.toggle('recommended', recommendedMonths >= 9);

    if (currentSavings >= target) {
      resultsSection.style.display = 'none';
      alreadyDone.style.display = 'block';
      return;
    }

    alreadyDone.style.display = 'none';
    resultsSection.style.display = 'block';

    // Big number
    document.getElementById('target-amount')!.textContent = formatCurrency(target);
    document.getElementById('target-months-label')!.textContent =
      `in your emergency fund (${recommendedMonths} months of essentials)`;

    // Progress
    const pct = Math.min((currentSavings / target) * 100, 100);
    document.getElementById('progress-pct')!.textContent = pct.toFixed(1) + '%';
    (document.getElementById('progress-fill') as HTMLElement).style.width = pct + '%';
    document.getElementById('progress-current')!.textContent = formatCurrency(currentSavings) + ' saved';
    document.getElementById('progress-goal')!.textContent = formatCurrency(target) + ' goal';

    // Gap
    const gap = target - currentSavings;
    document.getElementById('stat-gap')!.textContent = formatCurrency(gap);

    // Timeline
    const timelineMsg = document.getElementById('timeline-msg')!;
    const timelineText = document.getElementById('timeline-text')!;

    if (monthlySavings > 0) {
      const monthsToGoal = Math.ceil(gap / monthlySavings);
      const targetDate = new Date();
      targetDate.setMonth(targetDate.getMonth() + monthsToGoal);

      document.getElementById('stat-months')!.textContent = monthsToGoal.toString();
      document.getElementById('stat-date')!.textContent = formatMonth(targetDate);

      timelineMsg.style.display = 'block';
      timelineText.innerHTML = `At <strong>${formatCurrency(monthlySavings)}/month</strong>, you will reach your <strong>${formatCurrency(target)}</strong> goal by <strong>${formatMonth(targetDate)}</strong>. That is ${monthsToGoal} months from now.`;

      // Quick win: 10% more savings
      const quickwinCard = document.getElementById('quickwin-card')!;
      const quickwinText = document.getElementById('quickwin-text')!;
      const boostedSavings = monthlySavings * 1.1;
      const boostedMonths = Math.ceil(gap / boostedSavings);
      const monthsSaved = monthsToGoal - boostedMonths;

      if (monthsSaved > 0) {
        quickwinCard.style.display = 'flex';
        quickwinText.innerHTML = `If you increase your monthly savings by just 10% (to ${formatCurrency(boostedSavings)}/month), you will reach your goal <strong>${monthsSaved} month${monthsSaved > 1 ? 's' : ''} sooner</strong> — by ${formatMonth((() => { const d = new Date(); d.setMonth(d.getMonth() + boostedMonths); return d; })())}.`;
      } else {
        quickwinCard.style.display = 'none';
      }
    } else {
      document.getElementById('stat-months')!.textContent = '--';
      document.getElementById('stat-date')!.textContent = '--';
      timelineMsg.style.display = 'none';
      document.getElementById('quickwin-card')!.style.display = 'none';
    }
  }

  // Bind events
  expenseInputs.forEach(input => input.addEventListener('input', calculate));
  currentSavingsInput.addEventListener('input', calculate);
  monthlySavingsInput.addEventListener('input', calculate);
  jobStabilitySelect.addEventListener('change', calculate);
</script>
