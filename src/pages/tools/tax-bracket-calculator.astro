---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Free Tax Bracket Calculator 2026 — See Your Effective Tax Rate';
const description = 'Calculate your 2026 federal income tax bracket, marginal rate, effective tax rate, and estimated tax bill. Free, instant, no signup required.';
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Tax Bracket Calculator 2026",
      "url": "https://gettidyflow.com/tools/tax-bracket-calculator",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": description
    })} />
  </Fragment>

  <section class="tool-hero">
    <div class="tool-hero-inner">
      <span class="tool-badge">Free Tool — No Signup Required</span>
      <h1>Tax Bracket <span class="gradient-text">Calculator 2026</span></h1>
      <p class="tool-subtitle">Enter your income and filing status to instantly see your federal tax bracket, marginal rate, effective tax rate, and estimated 2026 tax bill.</p>
    </div>
  </section>

  <section class="tool-app">
    <div class="tool-container">
      <div class="calc-card">
        <div class="input-grid">
          <div class="input-group">
            <label for="gross-income" class="input-label">Gross Annual Income</label>
            <div class="input-wrapper">
              <span class="currency-symbol">$</span>
              <input type="number" id="gross-income" placeholder="e.g. 75,000" min="0" step="1000" aria-label="Gross annual income" />
            </div>
          </div>
          <div class="input-group">
            <label for="filing-status" class="input-label">Filing Status</label>
            <select id="filing-status" class="status-select">
              <option value="single">Single</option>
              <option value="married_joint">Married Filing Jointly</option>
              <option value="married_separate">Married Filing Separately</option>
              <option value="head">Head of Household</option>
            </select>
          </div>
        </div>
        <div class="deduction-row">
          <label class="input-label">Deduction Type</label>
          <div class="radio-group">
            <label class="radio-label">
              <input type="radio" name="deduction" value="standard" checked /> Standard Deduction
            </label>
            <label class="radio-label">
              <input type="radio" name="deduction" value="itemized" /> Itemized Deductions
            </label>
          </div>
          <div id="itemized-input" style="display:none; margin-top: 0.75rem;">
            <div class="input-wrapper">
              <span class="currency-symbol">$</span>
              <input type="number" id="itemized-amount" placeholder="Total itemized deductions" min="0" step="1000" />
            </div>
          </div>
        </div>
      </div>

      <div class="results-panel" id="results-panel" style="display:none;">
        <div class="results-row">
          <div class="result-box highlight-box">
            <div class="result-label">Estimated Federal Tax</div>
            <div class="result-value" id="tax-owed">$0</div>
          </div>
          <div class="result-box">
            <div class="result-label">Effective Tax Rate</div>
            <div class="result-value secondary" id="effective-rate">0%</div>
          </div>
          <div class="result-box">
            <div class="result-label">Marginal Tax Rate</div>
            <div class="result-value secondary" id="marginal-rate">0%</div>
          </div>
        </div>

        <div class="income-summary">
          <div class="summary-row">
            <span>Gross Income</span>
            <span id="summary-gross">$0</span>
          </div>
          <div class="summary-row">
            <span>Standard/Itemized Deduction</span>
            <span id="summary-deduction">$0</span>
          </div>
          <div class="summary-row bold-row">
            <span>Taxable Income</span>
            <span id="summary-taxable">$0</span>
          </div>
          <div class="summary-row">
            <span>Federal Income Tax</span>
            <span id="summary-tax">$0</span>
          </div>
          <div class="summary-row">
            <span>Est. Take-Home (Monthly)</span>
            <span id="summary-takehome" class="green">$0</span>
          </div>
        </div>

        <div class="bracket-breakdown">
          <h3>Tax Bracket Breakdown</h3>
          <div id="bracket-bars"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="tool-cta">
    <div class="tool-container">
      <div class="cta-card">
        <h2>Budget Around Your Real Take-Home Pay</h2>
        <p>Now that you know your actual take-home, build a budget that works. Our templates use after-tax income to create a realistic spending plan you can stick to.</p>
        <a href="https://gettidyflow.gumroad.com" target="_blank" rel="noopener" class="cta-button">Get the Budget Template &rarr;</a>
      </div>
    </div>
  </section>

  <section class="tool-content">
    <div class="tool-container content-narrow">
      <h2>2026 Federal Tax Brackets</h2>
      <p>The IRS adjusts tax brackets annually for inflation. These are the 2026 federal income tax brackets for single filers and married filing jointly:</p>

      <h3>Single Filers</h3>
      <table class="bracket-table">
        <thead><tr><th>Tax Rate</th><th>Taxable Income Range</th></tr></thead>
        <tbody>
          <tr><td>10%</td><td>$0 – $11,925</td></tr>
          <tr><td>12%</td><td>$11,926 – $48,475</td></tr>
          <tr><td>22%</td><td>$48,476 – $103,350</td></tr>
          <tr><td>24%</td><td>$103,351 – $197,300</td></tr>
          <tr><td>32%</td><td>$197,301 – $250,525</td></tr>
          <tr><td>35%</td><td>$250,526 – $626,350</td></tr>
          <tr><td>37%</td><td>Over $626,350</td></tr>
        </tbody>
      </table>

      <h3>Married Filing Jointly</h3>
      <table class="bracket-table">
        <thead><tr><th>Tax Rate</th><th>Taxable Income Range</th></tr></thead>
        <tbody>
          <tr><td>10%</td><td>$0 – $23,850</td></tr>
          <tr><td>12%</td><td>$23,851 – $96,950</td></tr>
          <tr><td>22%</td><td>$96,951 – $206,700</td></tr>
          <tr><td>24%</td><td>$206,701 – $394,600</td></tr>
          <tr><td>32%</td><td>$394,601 – $501,050</td></tr>
          <tr><td>35%</td><td>$501,051 – $751,600</td></tr>
          <tr><td>37%</td><td>Over $751,600</td></tr>
        </tbody>
      </table>

      <h2>Marginal Rate vs Effective Tax Rate</h2>
      <p>These two terms confuse many people — and the difference is important for budgeting:</p>
      <ul>
        <li><strong>Marginal tax rate:</strong> The rate applied to your last dollar of income. If you're in the 22% bracket, you pay 22% on income above the 12% threshold — not 22% on everything.</li>
        <li><strong>Effective tax rate:</strong> Your total taxes divided by your total income. This is your actual average tax burden, which is always lower than your marginal rate.</li>
      </ul>
      <p>Example: A single filer earning $75,000 pays approximately $10,294 in federal taxes — an effective rate of about 13.7%, even though they're in the 22% marginal bracket.</p>

      <h2>2026 Standard Deductions</h2>
      <ul>
        <li><strong>Single:</strong> $15,000</li>
        <li><strong>Married Filing Jointly:</strong> $30,000</li>
        <li><strong>Married Filing Separately:</strong> $15,000</li>
        <li><strong>Head of Household:</strong> $22,500</li>
      </ul>

      <h2>Related Tools and Resources</h2>
      <ul>
        <li><a href="/tools/budget-calculator">Budget Calculator (50/30/20)</a></li>
        <li><a href="/tools/hourly-to-salary-calculator">Hourly to Salary Calculator</a></li>
        <li><a href="/tools/freelancer-tax-calculator">Freelancer Tax Calculator</a></li>
        <li><a href="/blog/last-minute-tax-filing-budget-tips/">Last-Minute Tax Filing Budget Tips</a></li>
        <li><a href="/blog/tax-refund-budget-plan/">How to Use Your Tax Refund Wisely</a></li>
      </ul>

      <h2>Frequently Asked Questions</h2>
      <details>
        <summary>Does this include Social Security and Medicare taxes?</summary>
        <p>No — this calculator shows federal income tax only. Self-employed workers also owe 15.3% self-employment tax (SS + Medicare). Employees pay 7.65% with employers matching the rest. Add these to your calculations for a complete picture.</p>
      </details>
      <details>
        <summary>Is this calculator accurate?</summary>
        <p>This provides estimates based on 2026 federal tax brackets and the standard deduction. It does not account for state taxes, FICA taxes, tax credits, retirement contributions, or other deductions. Consult a tax professional for your exact tax liability.</p>
      </details>
      <details>
        <summary>Should I take the standard or itemized deduction?</summary>
        <p>Take whichever is larger. Most people (about 90%) benefit from the standard deduction. Itemizing makes sense if your deductible expenses — mortgage interest, charitable contributions, state/local taxes (SALT, capped at $10,000), and medical expenses — exceed the standard deduction amount.</p>
      </details>
      <details>
        <summary>How can I reduce my tax bill legally?</summary>
        <p>Maximize pre-tax retirement contributions (401k: $23,000/year, IRA: $7,000/year). These directly reduce taxable income. HSA contributions ($4,150 individual/$8,300 family) are also triple tax-advantaged. Bunching charitable donations into alternate years can push you over the itemization threshold in those years.</p>
      </details>
    </div>
  </section>
</BaseLayout>

<style>
  .tool-hero {
    background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
    padding: 4rem 1.5rem 3rem;
    text-align: center;
    color: #1a1a2e;
  }
  .tool-hero-inner { max-width: 720px; margin: 0 auto; }
  .tool-badge {
    display: inline-block;
    background: rgba(0,0,0,0.1);
    padding: 0.35rem 1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }
  .tool-hero h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; line-height: 1.15; margin: 0 0 1rem; }
  .gradient-text {
    background: linear-gradient(90deg, #c0392b, #8e44ad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .tool-subtitle { font-size: 1.1rem; opacity: 0.85; line-height: 1.6; margin: 0; }

  .tool-app { padding: 2.5rem 1.5rem; background: #f8f9fb; }
  .tool-container { max-width: 800px; margin: 0 auto; }
  .calc-card { background: #fff; border-radius: 16px; padding: 2rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); margin-bottom: 2rem; }
  .input-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.25rem; }
  .input-group {}
  .input-label { display: block; font-weight: 700; font-size: 0.9rem; margin-bottom: 0.5rem; color: #1a1a2e; }
  .input-wrapper { position: relative; display: flex; align-items: center; }
  .currency-symbol { position: absolute; left: 1rem; font-size: 1.1rem; font-weight: 700; color: #f7971e; }
  .input-wrapper input {
    width: 100%;
    padding: 0.8rem 0.8rem 0.8rem 2.5rem;
    font-size: 1.1rem;
    font-weight: 600;
    border: 2px solid #e2e8f0;
    border-radius: 10px;
    outline: none;
    font-family: inherit;
    color: #1a1a2e;
    transition: border-color 0.2s;
  }
  .input-wrapper input:focus { border-color: #f7971e; box-shadow: 0 0 0 3px rgba(247,151,30,0.15); }
  .input-wrapper input::placeholder { color: #a0aec0; font-weight: 400; }
  .status-select {
    width: 100%;
    padding: 0.8rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    border: 2px solid #e2e8f0;
    border-radius: 10px;
    outline: none;
    font-family: inherit;
    color: #1a1a2e;
    background: #fff;
    cursor: pointer;
  }
  .status-select:focus { border-color: #f7971e; }

  .deduction-row { margin-top: 0; }
  .radio-group { display: flex; gap: 1.5rem; margin-top: 0.5rem; }
  .radio-label { font-size: 0.95rem; font-weight: 500; cursor: pointer; display: flex; align-items: center; gap: 0.4rem; }

  .results-panel { }
  .results-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
  .result-box { background: #fff; border-radius: 14px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); text-align: center; }
  .highlight-box { background: linear-gradient(135deg, #f7971e, #ffd200); }
  .result-label { font-size: 0.85rem; font-weight: 600; color: #888; margin-bottom: 0.5rem; }
  .highlight-box .result-label { color: rgba(0,0,0,0.7); }
  .result-value { font-size: 1.6rem; font-weight: 800; color: #1a1a2e; }
  .highlight-box .result-value { color: #1a1a2e; }
  .result-value.secondary { color: #555; font-size: 1.4rem; }

  .income-summary { background: #fff; border-radius: 14px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); margin-bottom: 1.5rem; }
  .summary-row { display: flex; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px solid #f0f0f5; font-size: 0.95rem; color: #444; }
  .summary-row:last-child { border-bottom: none; }
  .bold-row { font-weight: 700; color: #1a1a2e; }
  .green { color: #11998e; font-weight: 700; }

  .bracket-breakdown { background: #fff; border-radius: 14px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
  .bracket-breakdown h3 { font-size: 1rem; font-weight: 700; margin: 0 0 1rem; color: #1a1a2e; }
  .bracket-row { margin-bottom: 0.75rem; }
  .bracket-info { display: flex; justify-content: space-between; font-size: 0.85rem; color: #555; margin-bottom: 0.3rem; }
  .bracket-bar-bg { background: #f0f0f5; border-radius: 999px; height: 10px; overflow: hidden; }
  .bracket-bar-fill { height: 100%; border-radius: 999px; transition: width 0.4s ease; }

  .tool-cta { padding: 2.5rem 1.5rem; background: #fff; }
  .cta-card { max-width: 800px; margin: 0 auto; background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%); border-radius: 20px; padding: 2.5rem; text-align: center; color: #1a1a2e; }
  .cta-card h2 { margin: 0 0 0.75rem; font-size: 1.5rem; font-weight: 800; }
  .cta-card p { margin: 0 0 1.5rem; opacity: 0.85; line-height: 1.6; }
  .cta-button { display: inline-block; background: #1a1a2e; color: #ffd200; font-weight: 700; padding: 0.85rem 2rem; border-radius: 999px; text-decoration: none; transition: transform 0.2s; }
  .cta-button:hover { transform: translateY(-2px); }

  .tool-content { padding: 3rem 1.5rem 4rem; background: #f8f9fb; }
  .content-narrow { max-width: 720px; margin: 0 auto; }
  .tool-content h2 { font-size: 1.4rem; font-weight: 800; color: #1a1a2e; margin: 2.5rem 0 0.75rem; }
  .tool-content h2:first-child { margin-top: 0; }
  .tool-content h3 { font-size: 1.1rem; font-weight: 700; color: #1a1a2e; margin: 1.5rem 0 0.5rem; }
  .tool-content p, .tool-content li { font-size: 1.02rem; line-height: 1.7; color: #444; }
  .tool-content ul, .tool-content ol { padding-left: 1.25rem; margin: 0.5rem 0 1rem; }
  .tool-content li { margin-bottom: 0.35rem; }
  .tool-content a { color: #c0392b; text-decoration: underline; text-underline-offset: 2px; }
  .bracket-table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; font-size: 0.95rem; }
  .bracket-table th { text-align: left; padding: 0.6rem; background: #f8f9fb; font-weight: 700; color: #1a1a2e; border-bottom: 2px solid #e2e8f0; }
  .bracket-table td { padding: 0.6rem; border-bottom: 1px solid #f0f0f5; color: #444; }
  .tool-content details { background: #fff; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 0.75rem; box-shadow: 0 1px 4px rgba(0,0,0,0.04); }
  .tool-content summary { font-weight: 600; cursor: pointer; color: #1a1a2e; font-size: 1.02rem; }
  .tool-content details p { margin: 0.75rem 0 0; }

  @media (max-width: 640px) {
    .input-grid { grid-template-columns: 1fr; }
    .results-row { grid-template-columns: 1fr; }
    .cta-card { padding: 2rem 1.5rem; }
  }
</style>

<script>
  const BRACKETS = {
    single: [
      { rate: 0.10, min: 0, max: 11925 },
      { rate: 0.12, min: 11925, max: 48475 },
      { rate: 0.22, min: 48475, max: 103350 },
      { rate: 0.24, min: 103350, max: 197300 },
      { rate: 0.32, min: 197300, max: 250525 },
      { rate: 0.35, min: 250525, max: 626350 },
      { rate: 0.37, min: 626350, max: Infinity },
    ],
    married_joint: [
      { rate: 0.10, min: 0, max: 23850 },
      { rate: 0.12, min: 23850, max: 96950 },
      { rate: 0.22, min: 96950, max: 206700 },
      { rate: 0.24, min: 206700, max: 394600 },
      { rate: 0.32, min: 394600, max: 501050 },
      { rate: 0.35, min: 501050, max: 751600 },
      { rate: 0.37, min: 751600, max: Infinity },
    ],
    married_separate: [
      { rate: 0.10, min: 0, max: 11925 },
      { rate: 0.12, min: 11925, max: 48475 },
      { rate: 0.22, min: 48475, max: 103350 },
      { rate: 0.24, min: 103350, max: 197300 },
      { rate: 0.32, min: 197300, max: 250525 },
      { rate: 0.35, min: 250525, max: 375800 },
      { rate: 0.37, min: 375800, max: Infinity },
    ],
    head: [
      { rate: 0.10, min: 0, max: 17000 },
      { rate: 0.12, min: 17000, max: 64850 },
      { rate: 0.22, min: 64850, max: 103350 },
      { rate: 0.24, min: 103350, max: 197300 },
      { rate: 0.32, min: 197300, max: 250500 },
      { rate: 0.35, min: 250500, max: 626350 },
      { rate: 0.37, min: 626350, max: Infinity },
    ],
  };
  const STANDARD_DEDUCTION: Record<string, number> = {
    single: 15000,
    married_joint: 30000,
    married_separate: 15000,
    head: 22500,
  };
  const BRACKET_COLORS = ['#4CAF50','#8BC34A','#CDDC39','#FFC107','#FF9800','#FF5722','#c0392b'];

  function fmt(n: number): string { return '$' + Math.round(n).toLocaleString('en-US'); }

  function calculate() {
    const gross = parseFloat((document.getElementById('gross-income') as HTMLInputElement).value) || 0;
    const status = (document.getElementById('filing-status') as HTMLSelectElement).value;
    const deductionType = (document.querySelector('input[name="deduction"]:checked') as HTMLInputElement).value;
    const itemizedAmt = parseFloat((document.getElementById('itemized-amount') as HTMLInputElement).value) || 0;

    if (gross <= 0) { document.getElementById('results-panel')!.style.display = 'none'; return; }

    const stdDed = STANDARD_DEDUCTION[status];
    const deduction = deductionType === 'standard' ? stdDed : Math.max(itemizedAmt, 0);
    const taxable = Math.max(0, gross - deduction);
    const brackets = BRACKETS[status as keyof typeof BRACKETS];

    let totalTax = 0;
    let marginalRate = brackets[0].rate;
    const bracketDetails: Array<{rate: number; taxable: number; tax: number}> = [];

    for (const b of brackets) {
      if (taxable <= b.min) break;
      const taxableInBracket = Math.min(taxable, b.max) - b.min;
      const taxInBracket = taxableInBracket * b.rate;
      totalTax += taxInBracket;
      marginalRate = b.rate;
      if (taxableInBracket > 0) bracketDetails.push({ rate: b.rate, taxable: taxableInBracket, tax: taxInBracket });
    }

    const effectiveRate = gross > 0 ? totalTax / gross : 0;
    const takeHome = (gross - totalTax) / 12;

    document.getElementById('results-panel')!.style.display = 'block';
    document.getElementById('tax-owed')!.textContent = fmt(totalTax);
    document.getElementById('effective-rate')!.textContent = (effectiveRate * 100).toFixed(1) + '%';
    document.getElementById('marginal-rate')!.textContent = (marginalRate * 100).toFixed(0) + '%';
    document.getElementById('summary-gross')!.textContent = fmt(gross);
    document.getElementById('summary-deduction')!.textContent = '-' + fmt(deduction);
    document.getElementById('summary-taxable')!.textContent = fmt(taxable);
    document.getElementById('summary-tax')!.textContent = '-' + fmt(totalTax);
    document.getElementById('summary-takehome')!.textContent = fmt(takeHome) + '/mo';

    const bracketBarsDiv = document.getElementById('bracket-bars')!;
    bracketBarsDiv.innerHTML = '';
    for (let i = 0; i < bracketDetails.length; i++) {
      const bd = bracketDetails[i];
      const pct = taxable > 0 ? (bd.taxable / taxable) * 100 : 0;
      const color = BRACKET_COLORS[Math.min(i, BRACKET_COLORS.length - 1)];
      const div = document.createElement('div');
      div.className = 'bracket-row';
      div.innerHTML = `
        <div class="bracket-info">
          <span>${(bd.rate * 100).toFixed(0)}% bracket</span>
          <span>${fmt(bd.tax)} on ${fmt(bd.taxable)}</span>
        </div>
        <div class="bracket-bar-bg">
          <div class="bracket-bar-fill" style="width:${pct}%; background:${color};"></div>
        </div>`;
      bracketBarsDiv.appendChild(div);
    }
  }

  document.getElementById('gross-income')!.addEventListener('input', calculate);
  document.getElementById('filing-status')!.addEventListener('change', calculate);
  document.querySelectorAll('input[name="deduction"]').forEach(el => {
    el.addEventListener('change', (e) => {
      const val = (e.target as HTMLInputElement).value;
      document.getElementById('itemized-input')!.style.display = val === 'itemized' ? 'block' : 'none';
      calculate();
    });
  });
  document.getElementById('itemized-amount')?.addEventListener('input', calculate);
</script>
