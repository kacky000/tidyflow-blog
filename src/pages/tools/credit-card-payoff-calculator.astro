<script>
  const balanceInput = document.getElementById('balance-input') as HTMLInputElement;
  const aprInput = document.getElementById('apr-input') as HTMLInputElement;
  const minPctInput = document.getElementById('min-pct-input') as HTMLInputElement;
  const fixedInput = document.getElementById('fixed-input') as HTMLInputElement;
  const resultsSection = document.getElementById('results-section')!;
  const warningCard = document.getElementById('warning-card')!;

  function fmt(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function monthsToText(m: number): string {
    const y = Math.floor(m / 12);
    const mo = m % 12;
    let t = '';
    if (y > 0) t += `${y} yr${y > 1 ? 's' : ''}`;
    if (y > 0 && mo > 0) t += ' ';
    if (mo > 0 || y === 0) t += `${mo} mo`;
    return t;
  }

  interface PayoffResult {
    months: number;
    totalInterest: number;
    totalPaid: number;
    balanceHistory: number[];
  }

  function simulateMinPayment(balance: number, apr: number, minPct: number): PayoffResult {
    const monthlyRate = apr / 100 / 12;
    let bal = balance;
    let totalInterest = 0;
    let months = 0;
    const maxMonths = 1200;
    const history: number[] = [bal];
    const minFloor = 25; // Most cards have a $25 minimum floor

    while (bal > 0.5 && months < maxMonths) {
      const interest = bal * monthlyRate;
      totalInterest += interest;
      bal += interest;
      const minPayment = Math.max(bal * (minPct / 100), minFloor);
      if (bal <= minPayment) {
        months++;
        history.push(0);
        bal = 0;
      } else {
        bal -= minPayment;
        months++;
        history.push(bal);
      }
    }
    return { months, totalInterest, totalPaid: balance + totalInterest, balanceHistory: history };
  }

  function simulateFixedPayment(balance: number, apr: number, payment: number): PayoffResult {
    const monthlyRate = apr / 100 / 12;
    let bal = balance;
    let totalInterest = 0;
    let months = 0;
    const maxMonths = 1200;
    const history: number[] = [bal];

    while (bal > 0.5 && months < maxMonths) {
      const interest = bal * monthlyRate;
      totalInterest += interest;
      bal += interest;
      if (bal <= payment) {
        months++;
        history.push(0);
        bal = 0;
      } else {
        bal -= payment;
        months++;
        history.push(bal);
      }
    }
    return { months, totalInterest, totalPaid: balance + totalInterest, balanceHistory: history };
  }

  function calculate() {
    const balance = parseFloat(balanceInput.value) || 0;
    const apr = parseFloat(aprInput.value) || 0;
    const minPct = parseFloat(minPctInput.value) || 2;
    const fixed = parseFloat(fixedInput.value) || 0;

    if (balance <= 0) {
      resultsSection.style.display = 'none';
      warningCard.style.display = 'none';
      return;
    }

    warningCard.style.display = 'none';

    // Minimum payment simulation
    const minResult = simulateMinPayment(balance, apr, minPct);

    if (minResult.months >= 1200) {
      resultsSection.style.display = 'none';
      warningCard.style.display = 'block';
      document.getElementById('warning-text')!.textContent = 'At minimum payments, this debt would take over 100 years to pay off. You need a higher payment.';
      return;
    }

    resultsSection.style.display = 'block';

    // Trap warning
    const trapText = document.getElementById('trap-text')!;
    const interestRatio = (minResult.totalInterest / balance * 100).toFixed(0);
    trapText.innerHTML = `Paying only the minimum on a <strong>${fmt(balance)}</strong> balance at <strong>${apr}% APR</strong> would take <strong>${monthsToText(minResult.months)}</strong> and cost <strong>${fmt(Math.round(minResult.totalInterest))}</strong> in interest — that's <strong>${interestRatio}%</strong> of your original balance paid in pure interest.`;

    // Min payment results
    document.getElementById('min-pct-display')!.textContent = minPct.toString();
    document.getElementById('min-months')!.textContent = monthsToText(minResult.months);
    document.getElementById('min-interest')!.textContent = fmt(Math.round(minResult.totalInterest));
    document.getElementById('min-total')!.textContent = fmt(Math.round(minResult.totalPaid));

    // Fixed payment results
    const fixedBox = document.getElementById('fixed-box')!;
    const savingsCard = document.getElementById('savings-card')!;

    if (fixed > 0) {
      const monthlyInterest = balance * (apr / 100 / 12);
      if (fixed <= monthlyInterest) {
        fixedBox.style.display = 'none';
        savingsCard.style.display = 'none';
        warningCard.style.display = 'block';
        document.getElementById('warning-text')!.textContent =
          `Your fixed payment ($${fixed}) must exceed the monthly interest (${fmt(Math.round(monthlyInterest))}) to make progress.`;
        return;
      }

      const fixedResult = simulateFixedPayment(balance, apr, fixed);
      fixedBox.style.display = 'block';
      document.getElementById('fixed-display')!.textContent = fmt(fixed);
      document.getElementById('fixed-months')!.textContent = monthsToText(fixedResult.months);
      document.getElementById('fixed-interest')!.textContent = fmt(Math.round(fixedResult.totalInterest));
      document.getElementById('fixed-total')!.textContent = fmt(Math.round(fixedResult.totalPaid));

      // Savings
      const savedMonths = minResult.months - fixedResult.months;
      const savedInterest = minResult.totalInterest - fixedResult.totalInterest;
      if (savedMonths > 0) {
        savingsCard.style.display = 'block';
        document.getElementById('save-interest')!.textContent = fmt(Math.round(savedInterest));
        document.getElementById('save-months')!.textContent = savedMonths.toString();
      } else {
        savingsCard.style.display = 'none';
      }

      drawChart(minResult.balanceHistory, fixedResult.balanceHistory, balance);
    } else {
      fixedBox.style.display = 'none';
      savingsCard.style.display = 'none';
      drawChart(minResult.balanceHistory, [], balance);
    }

    // First payment breakdown
    const firstInterest = balance * (apr / 100 / 12);
    const firstMinPayment = Math.max(balance * (minPct / 100), 25);
    const firstPrincipal = firstMinPayment - firstInterest;
    const interestPct = (firstInterest / firstMinPayment) * 100;
    const principalPct = (firstPrincipal / firstMinPayment) * 100;

    (document.getElementById('bar-interest') as HTMLElement).style.width = `${interestPct}%`;
    (document.getElementById('bar-principal') as HTMLElement).style.width = `${principalPct}%`;
    document.getElementById('first-interest')!.textContent = `${fmt(Math.round(firstInterest))} (${interestPct.toFixed(0)}%)`;
    document.getElementById('first-principal')!.textContent = `${fmt(Math.round(firstPrincipal))} (${principalPct.toFixed(0)}%)`;
  }

  function drawChart(minHistory: number[], fixedHistory: number[], maxBalance: number) {
    const container = document.getElementById('chart-container')!;
    container.innerHTML = '';

    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 800 200');
    svg.setAttribute('preserveAspectRatio', 'none');
    svg.style.width = '100%';
    svg.style.height = '100%';

    const maxMonths = Math.max(minHistory.length, fixedHistory.length);
    const yScale = 190 / maxBalance;
    const xScale = 790 / (maxMonths - 1 || 1);

    // Min payment line
    let minPath = `M 5 ${200 - minHistory[0] * yScale}`;
    for (let i = 1; i < minHistory.length; i++) {
      minPath += ` L ${5 + i * xScale} ${200 - minHistory[i] * yScale}`;
    }
    const minLine = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    minLine.setAttribute('d', minPath);
    minLine.setAttribute('fill', 'none');
    minLine.setAttribute('stroke', '#e53e3e');
    minLine.setAttribute('stroke-width', '3');
    svg.appendChild(minLine);

    // Fixed payment line
    if (fixedHistory.length > 0) {
      let fixedPath = `M 5 ${200 - fixedHistory[0] * yScale}`;
      for (let i = 1; i < fixedHistory.length; i++) {
        fixedPath += ` L ${5 + i * xScale} ${200 - fixedHistory[i] * yScale}`;
      }
      const fixedLine = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      fixedLine.setAttribute('d', fixedPath);
      fixedLine.setAttribute('fill', 'none');
      fixedLine.setAttribute('stroke', '#38a169');
      fixedLine.setAttribute('stroke-width', '3');
      svg.appendChild(fixedLine);
    }

    container.appendChild(svg);
  }

  [balanceInput, aprInput, minPctInput, fixedInput].forEach(el => {
    el.addEventListener('input', calculate);
  });

  // Calculate on load with default APR
  calculate();
</script>
