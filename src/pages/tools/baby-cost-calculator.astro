---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Baby Cost Calculator — First-Year Newborn Expense Estimator';
const description = 'Estimate your first year of baby costs. Enter expenses for diapers, formula, childcare, gear, healthcare, and more to get monthly and annual totals.';
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Baby Cost Calculator",
      "url": "https://gettidyflow.com/tools/baby-cost-calculator",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": description
    })} />
  </Fragment>

  <section class="tool-hero">
    <div class="tool-hero-inner">
      <span class="tool-badge">Free Tool — No Signup Required</span>
      <h1>Baby Cost <span class="gradient-text">Calculator</span></h1>
      <p class="tool-subtitle">Planning for a newborn? Estimate your first-year baby costs across every major category — from diapers and formula to childcare and healthcare. Know what to expect before the baby arrives.</p>
    </div>
  </section>

  <section class="tool-app">
    <div class="tool-container">

      <div class="average-banner">
        <span>According to USDA data, the average first year of a baby costs <strong>$12,000–$16,000+</strong> in the US — not including lost income from parental leave.</span>
      </div>

      <div class="categories-grid">

        <div class="cat-card">
          <div class="cat-header">
            <span class="cat-icon">🍼</span>
            <h2>Feeding</h2>
          </div>
          <div class="input-row">
            <label>Formula (monthly)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="formula" placeholder="150" min="0" step="10" data-default="150" />
            </div>
            <p class="input-hint">$100–$200/mo for formula-fed; $0 if breastfeeding</p>
          </div>
          <div class="input-row">
            <label>Breast pump / accessories (one-time ÷ 12)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="breastpump" placeholder="25" min="0" step="5" data-default="25" />
            </div>
          </div>
          <div class="input-row">
            <label>Solid food / jars (monthly, after 6 months)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="solids" placeholder="50" min="0" step="10" data-default="50" />
            </div>
          </div>
        </div>

        <div class="cat-card">
          <div class="cat-header">
            <span class="cat-icon">👶</span>
            <h2>Diapers & Wipes</h2>
          </div>
          <div class="input-row">
            <label>Diapers (monthly)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="diapers" placeholder="80" min="0" step="10" data-default="80" />
            </div>
            <p class="input-hint">Newborns use ~300 diapers/month. Budget $60–$120/mo.</p>
          </div>
          <div class="input-row">
            <label>Wipes (monthly)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="wipes" placeholder="25" min="0" step="5" data-default="25" />
            </div>
          </div>
          <div class="input-row">
            <label>Diaper cream / hygiene (monthly)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="hygiene" placeholder="20" min="0" step="5" data-default="20" />
            </div>
          </div>
        </div>

        <div class="cat-card">
          <div class="cat-header">
            <span class="cat-icon">🏥</span>
            <h2>Healthcare</h2>
          </div>
          <div class="input-row">
            <label>Health insurance premium increase (monthly)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="insurance" placeholder="150" min="0" step="25" data-default="150" />
            </div>
          </div>
          <div class="input-row">
            <label>Pediatrician / well visits (monthly avg)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="doctor" placeholder="40" min="0" step="10" data-default="40" />
            </div>
            <p class="input-hint">6 well-visits in year 1. Divide annual copays by 12.</p>
          </div>
          <div class="input-row">
            <label>Medications / sick visits (monthly avg)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="meds" placeholder="30" min="0" step="10" data-default="30" />
            </div>
          </div>
        </div>

        <div class="cat-card">
          <div class="cat-header">
            <span class="cat-icon">🏫</span>
            <h2>Childcare</h2>
          </div>
          <div class="input-row">
            <label>Daycare / nursery (monthly)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="daycare" placeholder="1200" min="0" step="50" data-default="1200" />
            </div>
            <p class="input-hint">US average: $700–$2,000/mo. Biggest expense for most families.</p>
          </div>
          <div class="input-row">
            <label>Babysitter / date nights (monthly)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="babysitter" placeholder="100" min="0" step="25" data-default="100" />
            </div>
          </div>
        </div>

        <div class="cat-card">
          <div class="cat-header">
            <span class="cat-icon">👕</span>
            <h2>Clothing & Gear</h2>
          </div>
          <div class="input-row">
            <label>Clothing (monthly avg — babies grow fast)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="clothing" placeholder="50" min="0" step="10" data-default="50" />
            </div>
          </div>
          <div class="input-row">
            <label>Nursery / big gear (one-time ÷ 12)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="gear" placeholder="100" min="0" step="25" data-default="100" />
            </div>
            <p class="input-hint">Crib, stroller, car seat, etc. Spread over the year.</p>
          </div>
          <div class="input-row">
            <label>Toys / books (monthly)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="toys" placeholder="30" min="0" step="10" data-default="30" />
            </div>
          </div>
        </div>

        <div class="cat-card">
          <div class="cat-header">
            <span class="cat-icon">✈️</span>
            <h2>Other Expenses</h2>
          </div>
          <div class="input-row">
            <label>Life / disability insurance increase (monthly)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="lifeins" placeholder="50" min="0" step="10" data-default="50" />
            </div>
          </div>
          <div class="input-row">
            <label>Baby classes / activities (monthly)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="classes" placeholder="40" min="0" step="10" data-default="40" />
            </div>
          </div>
          <div class="input-row">
            <label>Miscellaneous / unexpected (monthly)</label>
            <div class="input-wrapper"><span class="currency-symbol">$</span>
              <input type="number" class="expense-input" id="misc" placeholder="100" min="0" step="25" data-default="100" />
            </div>
          </div>
        </div>

      </div>

      <div class="results-panel" id="results-panel">
        <div class="total-card">
          <div class="total-item">
            <span>Monthly Baby Costs</span>
            <strong id="total-monthly">$0</strong>
          </div>
          <div class="total-divider"></div>
          <div class="total-item total-annual">
            <span>First-Year Total</span>
            <strong id="total-annual">$0</strong>
          </div>
        </div>

        <div class="breakdown-card">
          <h3>Cost Breakdown by Category</h3>
          <div class="breakdown-list" id="breakdown-list"></div>
        </div>

        <div class="tips-card">
          <h3>Money-Saving Tips</h3>
          <ul>
            <li>Buy clothing secondhand — babies outgrow sizes in 2–3 months</li>
            <li>Check if your health insurance covers a free breast pump</li>
            <li>Ask about the Child and Dependent Care FSA ($5,000 tax-free childcare)</li>
            <li>Open a 529 plan early — even $25/month compounds significantly</li>
          </ul>
        </div>
      </div>

      <div class="cta-box">
        <p>Need a complete family budget template to plan for all your new expenses?</p>
        <a href="https://gettidyflow.gumroad.com" class="cta-btn" target="_blank" rel="noopener">Get Free Budget Templates →</a>
      </div>

    </div>
  </section>

  <section class="tool-faq">
    <div class="tool-container">
      <h2>Baby Cost FAQ</h2>
      <div class="faq-item">
        <h3>How much does a baby cost in the first year?</h3>
        <p>The USDA estimates $12,000–$16,000 for the first year, but costs vary widely based on childcare choice (the biggest factor), breastfeeding vs. formula, and your location. NYC and SF families often spend $25,000+.</p>
      </div>
      <div class="faq-item">
        <h3>What is the most expensive baby expense?</h3>
        <p>Childcare is by far the largest cost for most working parents — often $800–$2,000 per month. In some cities, infant daycare exceeds $3,000/month. Many families spend more on childcare than rent.</p>
      </div>
      <div class="faq-item">
        <h3>How can I reduce first-year baby costs?</h3>
        <p>Breastfeed if possible (saves $1,200–$2,400 in formula), buy used gear (strollers, swings hold up well secondhand), and take full advantage of employer FSA benefits for dependent care.</p>
      </div>
    </div>
  </section>

<style>
  .tool-hero { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 3rem 1rem; text-align: center; }
  .tool-hero-inner { max-width: 680px; margin: 0 auto; }
  .tool-badge { background: rgba(251,191,36,0.2); color: #fbbf24; border: 1px solid rgba(251,191,36,0.3); border-radius: 999px; padding: 0.3rem 1rem; font-size: 0.8rem; font-weight: 600; }
  .tool-hero h1 { color: #fff; font-size: clamp(1.8rem,4vw,2.6rem); margin: 0.8rem 0; }
  .gradient-text { background: linear-gradient(90deg, #f59e0b, #f97316); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .tool-subtitle { color: #94a3b8; font-size: 1.05rem; line-height: 1.6; }

  .tool-app { padding: 2.5rem 1rem; background: #f8fafc; }
  .tool-container { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem; }

  .average-banner { background: #fffbeb; border: 1px solid #fcd34d; border-radius: 10px; padding: 1rem 1.25rem; font-size: 0.9rem; color: #78350f; }
  .average-banner strong { color: #92400e; }

  .categories-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1rem; }
  .cat-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; }
  .cat-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
  .cat-icon { font-size: 1.3rem; }
  .cat-header h2 { font-size: 1rem; font-weight: 700; color: #1e293b; margin: 0; }
  .input-row { margin-bottom: 0.9rem; }
  .input-row label { display: block; font-size: 0.82rem; font-weight: 600; color: #475569; margin-bottom: 0.35rem; }
  .input-hint { font-size: 0.76rem; color: #94a3b8; margin: 0.25rem 0 0; }
  .input-wrapper { position: relative; display: flex; align-items: center; }
  .currency-symbol { position: absolute; left: 0.75rem; color: #64748b; font-weight: 600; font-size: 0.9rem; }
  input[type="number"] { width: 100%; padding: 0.55rem 0.75rem 0.55rem 1.9rem; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; box-sizing: border-box; transition: border-color 0.2s; }
  input[type="number"]:focus { outline: none; border-color: #f59e0b; }

  .results-panel { display: flex; flex-direction: column; gap: 1rem; }
  .total-card { background: linear-gradient(135deg, #1e293b, #0f172a); border-radius: 12px; padding: 1.5rem 2rem; display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .total-item { flex: 1; }
  .total-item span { display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 0.3rem; }
  .total-item strong { font-size: 2rem; font-weight: 800; color: #fff; }
  .total-annual strong { color: #fbbf24; }
  .total-divider { width: 1px; height: 60px; background: rgba(255,255,255,0.1); }

  .breakdown-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; }
  .breakdown-card h3 { font-size: 0.95rem; font-weight: 700; color: #334155; margin: 0 0 0.75rem; }
  .breakdown-list { display: flex; flex-direction: column; gap: 0.4rem; }
  .breakdown-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; padding: 0.35rem 0; border-bottom: 1px solid #f1f5f9; }
  .breakdown-row span { color: #475569; }
  .breakdown-row strong { color: #1e293b; }
  .breakdown-row .bar-mini { height: 4px; border-radius: 2px; background: #f59e0b; transition: width 0.3s; min-width: 2px; }

  .tips-card { background: #f0fdf4; border: 1px solid #86efac; border-radius: 12px; padding: 1.25rem; }
  .tips-card h3 { font-size: 0.95rem; font-weight: 700; color: #15803d; margin: 0 0 0.75rem; }
  .tips-card ul { margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .tips-card li { font-size: 0.85rem; color: #166534; line-height: 1.5; }

  .cta-box { background: linear-gradient(135deg, #f59e0b, #f97316); border-radius: 12px; padding: 1.5rem; text-align: center; color: #fff; }
  .cta-box p { margin: 0 0 1rem; font-size: 0.95rem; font-weight: 600; }
  .cta-btn { background: #fff; color: #d97706; padding: 0.65rem 1.5rem; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 0.9rem; display: inline-block; }

  .tool-faq { padding: 2.5rem 1rem; }
  .tool-faq .tool-container { max-width: 800px; }
  .tool-faq h2 { font-size: 1.4rem; font-weight: 700; color: #1e293b; margin: 0 0 1.5rem; }
  .faq-item { margin-bottom: 1.5rem; }
  .faq-item h3 { font-size: 1rem; font-weight: 700; color: #334155; margin: 0 0 0.4rem; }
  .faq-item p { color: #475569; font-size: 0.9rem; line-height: 1.6; margin: 0; }
</style>

<script>
  const categories = [
    { id: 'formula', label: 'Formula & Feeding' },
    { id: 'breastpump', label: 'Breast Pump' },
    { id: 'solids', label: 'Solid Food' },
    { id: 'diapers', label: 'Diapers' },
    { id: 'wipes', label: 'Wipes' },
    { id: 'hygiene', label: 'Hygiene / Cream' },
    { id: 'insurance', label: 'Health Insurance' },
    { id: 'doctor', label: 'Pediatrician' },
    { id: 'meds', label: 'Medications' },
    { id: 'daycare', label: 'Childcare / Daycare' },
    { id: 'babysitter', label: 'Babysitter' },
    { id: 'clothing', label: 'Clothing' },
    { id: 'gear', label: 'Nursery & Gear' },
    { id: 'toys', label: 'Toys & Books' },
    { id: 'lifeins', label: 'Life Insurance' },
    { id: 'classes', label: 'Classes & Activities' },
    { id: 'misc', label: 'Miscellaneous' },
  ];

  function fmt(n: number): string {
    return '$' + n.toLocaleString('en-US', { maximumFractionDigits: 0 });
  }

  function calculate() {
    const values = categories.map(c => ({
      ...c,
      amount: parseFloat((document.getElementById(c.id) as HTMLInputElement).value) || 0
    }));

    const total = values.reduce((s, v) => s + v.amount, 0);
    const annual = total * 12;

    document.getElementById('total-monthly')!.textContent = fmt(total);
    document.getElementById('total-annual')!.textContent = fmt(annual);

    // Breakdown
    const list = document.getElementById('breakdown-list')!;
    const nonZero = values.filter(v => v.amount > 0).sort((a, b) => b.amount - a.amount);
    const max = nonZero[0]?.amount || 1;
    list.innerHTML = nonZero.map(v => `
      <div class="breakdown-row">
        <span>${v.label}</span>
        <div style="display:flex;align-items:center;gap:0.75rem;">
          <div class="bar-mini" style="width:${Math.round((v.amount/max)*80)}px"></div>
          <strong>${fmt(v.amount)}/mo</strong>
        </div>
      </div>
    `).join('');
  }

  // Set placeholder defaults as initial values
  categories.forEach(c => {
    const el = document.getElementById(c.id) as HTMLInputElement;
    if (el) el.addEventListener('input', calculate);
  });

  calculate();
</script>
</BaseLayout>
