    color: #1a1a2e;
    flex-shrink: 0;
  }

  /* Due Dates */
  .due-dates-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    margin-bottom: 1.5rem;
  }
  .due-dates-card h3 {
    margin: 0 0 1.25rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a1a2e;
  }
  .due-dates-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }
  .due-date-item {
    text-align: center;
    padding: 1rem 0.5rem;
