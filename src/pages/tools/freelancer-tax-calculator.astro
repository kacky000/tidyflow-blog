  }
  .due-amount {
    font-size: 1.15rem;
    font-weight: 800;
    color: #1a1a2e;
  }
  .next-due {
    margin: 1rem 0 0;
    padding: 0.75rem 1rem;
    background: linear-gradient(135deg, #ecfdf5, #f0fdfa);
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    color: #0d9488;
