  }
  .chart-card h3 {
    margin: 0 0 1.25rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a1a2e;
  }
  .chart-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .chart-label {
    width: 60px;
    font-size: 0.88rem;
    font-weight: 600;
    color: #555;
    flex-shrink: 0;
  }
  .chart-bar-wrapper {
    flex: 1;
    height: 28px;
    background: #f0f0f5;
    border-radius: 8px;
    overflow: hidden;
  }
  .chart-bar {
    height: 100%;
    border-radius: 8px;
    transition: width 0.6s ease;
    width: 0;
  }
  .chart-bar-se { background: linear-gradient(90deg, #0d9488, #14b8a6); }
  .chart-bar-federal { background: linear-gradient(90deg, #0891b2, #22d3ee); }
  .chart-bar-state { background: linear-gradient(90deg, #6366f1, #818cf8); }
  .chart-value {
    width: 80px;
    text-align: right;
    font-size: 0.9rem;
