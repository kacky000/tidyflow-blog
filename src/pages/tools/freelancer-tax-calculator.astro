  }

  /* CTA */
  .tool-cta {
    padding: 2.5rem 1.5rem;
    background: #fff;
  }
  .cta-card {
    max-width: 800px;
    margin: 0 auto;
    background: linear-gradient(135deg, #0d9488 0%, #0891b2 100%);
    border-radius: 20px;
    padding: 2.5rem;
    text-align: center;
    color: #fff;
  }
  .cta-card h2 {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
    font-weight: 800;
  }
  .cta-card p {
    margin: 0 0 1.5rem;
    opacity: 0.92;
    line-height: 1.6;
  }
  .cta-button {
    display: inline-block;
    background: #fff;
    color: #0d9488;
    font-weight: 700;
    padding: 0.85rem 2rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  /* Content */
  .tool-content {
    padding: 3rem 1.5rem 4rem;
    background: #f8f9fb;
  }
  .content-narrow {
    max-width: 720px;
    margin: 0 auto;
  }
  .tool-content h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #1a1a2e;
    margin: 2.5rem 0 0.75rem;
  }
  .tool-content h2:first-child {
    margin-top: 0;
  }
  .tool-content p,
  .tool-content li {
    font-size: 1.02rem;
    line-height: 1.7;
    color: #444;
  }
  .tool-content ul,
  .tool-content ol {
    padding-left: 1.25rem;
    margin: 0.5rem 0 1rem;
  }
  .tool-content li {
    margin-bottom: 0.35rem;
  }
  .tool-content a {
    color: #0d9488;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .tool-content details {
    background: #fff;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
  }
  .tool-content summary {
    font-weight: 600;
    cursor: pointer;
    color: #1a1a2e;
    font-size: 1.02rem;
  }
  .tool-content details p {
    margin: 0.75rem 0 0;
  }

  @media (max-width: 640px) {
    .input-row {
      grid-template-columns: 1fr;
    }
    .summary-header {
      flex-direction: column;
      gap: 1rem;
    }
    .summary-amount {
      font-size: 2rem;
    }
    .due-dates-grid {
      grid-template-columns: 1fr 1fr;
    }
    .cta-card {
      padding: 2rem 1.5rem;
    }
    .se-split {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>

<script>
  const STATE_TAX_RATES: Record<string, number> = {
    AL: 0.05, AK: 0, AZ: 0.025, AR: 0.044, CA: 0.093,
    CO: 0.044, CT: 0.05, DE: 0.066, DC: 0.0895, FL: 0,
    GA: 0.055, HI: 0.079, ID: 0.058, IL: 0.0495, IN: 0.0315,
    IA: 0.044, KS: 0.057, KY: 0.04, LA: 0.0425, ME: 0.0715,
    MD: 0.0575, MA: 0.05, MI: 0.0425, MN: 0.0785, MS: 0.05,
    MO: 0.048, MT: 0.059, NE: 0.0564, NV: 0, NH: 0,
    NJ: 0.0637, NM: 0.049, NY: 0.0685, NC: 0.045, ND: 0.0195,
    OH: 0.035, OK: 0.0475, OR: 0.09, PA: 0.0307, RI: 0.0599,
    SC: 0.065, SD: 0, TN: 0, TX: 0, UT: 0.0465,
    VT: 0.066, VA: 0.0575, WA: 0, WV: 0.055, WI: 0.0653, WY: 0
  };

  const BRACKETS_SINGLE = [
    { limit: 11925, rate: 0.10 },
    { limit: 48475, rate: 0.12 },
    { limit: 103350, rate: 0.22 },
    { limit: 197300, rate: 0.24 },
    { limit: 250525, rate: 0.32 },
    { limit: 626350, rate: 0.35 },
    { limit: Infinity, rate: 0.37 }
  ];
  const BRACKETS_MFJ = [
    { limit: 23850, rate: 0.10 },
    { limit: 96950, rate: 0.12 },
    { limit: 206700, rate: 0.22 },
    { limit: 394600, rate: 0.24 },
    { limit: 501050, rate: 0.32 },
    { limit: 752800, rate: 0.35 },
    { limit: Infinity, rate: 0.37 }
  ];
  const BRACKETS_HOH = [
    { limit: 17000, rate: 0.10 },
    { limit: 64850, rate: 0.12 },
    { limit: 103350, rate: 0.22 },
    { limit: 197300, rate: 0.24 },
    { limit: 250500, rate: 0.32 },
    { limit: 626350, rate: 0.35 },
    { limit: Infinity, rate: 0.37 }
  ];

  const STANDARD_DEDUCTIONS: Record<string, number> = {
    single: 15000,
    mfj: 30000,
    hoh: 22500
  };

  const SS_WAGE_CAP = 168600;

  function getBrackets(status: string) {
    if (status === 'mfj') return BRACKETS_MFJ;
    if (status === 'hoh') return BRACKETS_HOH;
    return BRACKETS_SINGLE;
  }

  function calcFederalIncomeTax(taxableIncome: number, status: string): number {
    if (taxableIncome <= 0) return 0;
    const brackets = getBrackets(status);
    let tax = 0;
    let prev = 0;
    for (const b of brackets) {
      if (taxableIncome <= prev) break;
      const taxable = Math.min(taxableIncome, b.limit) - prev;
      tax += taxable * b.rate;
      prev = b.limit;
    }
    return tax;
  }

  function formatCurrency(n: number): string {
    return '$' + Math.round(n).toLocaleString('en-US');
  }

  function getNextDueDate(): { label: string; date: string } {
    const now = new Date();
    const dues = [
      { label: 'Q1', date: 'April 15, 2026', d: new Date(2026, 3, 15) },
      { label: 'Q2', date: 'June 16, 2026', d: new Date(2026, 5, 16) },
      { label: 'Q3', date: 'September 15, 2026', d: new Date(2026, 8, 15) },
      { label: 'Q4', date: 'January 15, 2027', d: new Date(2027, 0, 15) }
    ];
    for (const due of dues) {
      if (now <= due.d) return { label: due.label, date: due.date };
    }
    return { label: 'Q1 (2027)', date: 'April 15, 2027' };
  }

  function calculate() {
    const income1099 = parseFloat((document.getElementById('income-input') as HTMLInputElement).value) || 0;
    const expenses = parseFloat((document.getElementById('expenses-input') as HTMLInputElement).value) || 0;
    const filingStatus = (document.getElementById('filing-status') as HTMLSelectElement).value;
    const state = (document.getElementById('state-select') as HTMLSelectElement).value;
    const w2Income = parseFloat((document.getElementById('w2-input') as HTMLInputElement).value) || 0;

    if (income1099 <= 0) {
      document.getElementById('summary-card')!.style.display = 'none';
      document.getElementById('results-grid')!.style.display = 'none';
      document.getElementById('chart-card')!.style.display = 'none';
      document.getElementById('due-dates-card')!.style.display = 'none';
      return;
    }

    // Net self-employment income
    const netSEIncome = Math.max(income1099 - expenses, 0);

    // Self-employment tax
    const seTaxableIncome = netSEIncome * 0.9235;
    const ssIncome = Math.min(seTaxableIncome, SS_WAGE_CAP);
    const ssTax = ssIncome * 0.124;
    const medicareTax = seTaxableIncome * 0.029;
    const seTax = ssTax + medicareTax;

    // SE tax deduction (50%)
    const seTaxDeduction = seTax * 0.5;

    // AGI
    const agi = netSEIncome - seTaxDeduction + w2Income;

    // Taxable income after standard deduction
    const standardDeduction = STANDARD_DEDUCTIONS[filingStatus] || 15000;
    const taxableIncome = Math.max(agi - standardDeduction, 0);

    // Federal income tax
    const federalTax = calcFederalIncomeTax(taxableIncome, filingStatus);

    // State income tax
    const stateRate = STATE_TAX_RATES[state] || 0;
    const stateTax = agi * stateRate;

    // Totals
    const totalAnnualTax = seTax + federalTax + stateTax;
    const quarterlyPayment = totalAnnualTax / 4;
    const effectiveRate = netSEIncome + w2Income > 0 ? (totalAnnualTax / (netSEIncome + w2Income)) * 100 : 0;

    // Show cards
    document.getElementById('summary-card')!.style.display = 'block';
    document.getElementById('results-grid')!.style.display = 'grid';
    document.getElementById('chart-card')!.style.display = 'block';
    document.getElementById('due-dates-card')!.style.display = 'block';

    // Summary
    document.getElementById('quarterly-amount')!.textContent = formatCurrency(quarterlyPayment);
    document.getElementById('annual-tax')!.textContent = formatCurrency(totalAnnualTax);
    document.getElementById('effective-rate')!.textContent = effectiveRate.toFixed(1) + '%';

    // Breakdown
    document.getElementById('se-tax-amount')!.textContent = formatCurrency(seTax);
    document.getElementById('ss-amount')!.textContent = formatCurrency(ssTax);
    document.getElementById('medicare-amount')!.textContent = formatCurrency(medicareTax);
    document.getElementById('federal-tax-amount')!.textContent = formatCurrency(federalTax);
    document.getElementById('state-tax-amount')!.textContent = formatCurrency(stateTax);

    if (stateRate === 0) {
      document.getElementById('state-tip')!.textContent = 'Your state has no income tax. Lucky you!';
    } else {
      document.getElementById('state-tip')!.textContent = `Estimated using ${state}'s approximate effective rate of ${(stateRate * 100).toFixed(1)}%.`;
    }

    // Bars (proportional to total)
    const maxTax = Math.max(seTax, federalTax, stateTax, 1);
    (document.getElementById('bar-se') as HTMLElement).style.width = ((seTax / maxTax) * 100) + '%';
    (document.getElementById('bar-federal') as HTMLElement).style.width = ((federalTax / maxTax) * 100) + '%';
    (document.getElementById('bar-state') as HTMLElement).style.width = ((stateTax / maxTax) * 100) + '%';

    // Chart bars
    const chartMax = Math.max(seTax + federalTax + stateTax, 1);
    (document.getElementById('chart-bar-se') as HTMLElement).style.width = ((seTax / chartMax) * 100) + '%';
    (document.getElementById('chart-bar-federal') as HTMLElement).style.width = ((federalTax / chartMax) * 100) + '%';
    (document.getElementById('chart-bar-state') as HTMLElement).style.width = ((stateTax / chartMax) * 100) + '%';
    document.getElementById('chart-val-se')!.textContent = formatCurrency(seTax);
    document.getElementById('chart-val-federal')!.textContent = formatCurrency(federalTax);
    document.getElementById('chart-val-state')!.textContent = formatCurrency(stateTax);

    // Due dates
    const qAmt = formatCurrency(quarterlyPayment);
    document.getElementById('q1-amount')!.textContent = qAmt;
    document.getElementById('q2-amount')!.textContent = qAmt;
    document.getElementById('q3-amount')!.textContent = qAmt;
    document.getElementById('q4-amount')!.textContent = qAmt;

    const nextDue = getNextDueDate();
    document.getElementById('next-due')!.textContent = `Next quarterly payment due: ${nextDue.date} (${nextDue.label})`;

    // Highlight next due date
    const qMap: Record<string, string> = { Q1: 'q1-due', Q2: 'q2-due', Q3: 'q3-due', Q4: 'q4-due' };
    ['q1-due','q2-due','q3-due','q4-due'].forEach(id => {
      (document.getElementById(id) as HTMLElement).style.background = '#f8f9fb';
    });
    const nextId = qMap[nextDue.label];
    if (nextId) {
      (document.getElementById(nextId) as HTMLElement).style.background = 'linear-gradient(135deg, #ecfdf5, #f0fdfa)';
    }
  }

  document.getElementById('calc-button')!.addEventListener('click', calculate);

  // Also calculate on Enter key
  document.querySelectorAll('.calc-card input, .calc-card select').forEach(el => {
    el.addEventListener('keydown', (e: Event) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        e.preventDefault();
        calculate();
      }
    });
  });
</script>
