  }
  .tool-content summary {
    font-weight: 600;
    cursor: pointer;
    color: #1a1a2e;
    font-size: 1.02rem;
  }
  .tool-content details p {
    margin: 0.75rem 0 0;
  }

  @media (max-width: 700px) {
    .comparison-grid {
      grid-template-columns: 1fr;
    }
    .debt-row {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
    .debt-row .debt-field:first-child {
      grid-column: 1 / -1;
    }
    .remove-debt-btn {
      grid-column: 1 / -1;
      justify-self: end;
    }
    .cta-card {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  interface Debt {
    name: string;
    balance: number;
    rate: number;
    minPayment: number;
  }

  interface SimDebt {
    name: string;
    balance: number;
    rate: number;
    minPayment: number;
    originalBalance: number;
  }

  interface MonthRow {
    month: number;
    balances: number[];
    payment: number;
    interest: number;
    principal: number;
    paidOff: string | null;
  }

  interface SimResult {
    totalInterest: number;
    totalPaid: number;
    months: number;
    payoffOrder: string[];
    schedule: MonthRow[];
  }

  const debtListEl = document.getElementById('debt-list')!;
  const addDebtBtn = document.getElementById('add-debt-btn') as HTMLButtonElement;
  const limitNote = document.getElementById('debt-limit-note')!;
  const calcBtn = document.getElementById('calculate-btn')!;
  const resultsSection = document.getElementById('results-section')!;
  const extraPaymentInput = document.getElementById('extra-payment-input') as HTMLInputElement;

  let debtCount = 0;

  function createDebtRow(): void {
    if (debtCount >= 10) return;
    debtCount++;
    const id = debtCount;
    const row = document.createElement('div');
    row.className = 'debt-row';
    row.setAttribute('role', 'listitem');
    row.dataset.debtId = String(id);
    row.innerHTML = `
      <div class="debt-field">
        <label for="debt-name-${id}">Debt Name</label>
        <input type="text" id="debt-name-${id}" placeholder="e.g. Chase Visa" aria-label="Debt name" />
      </div>
      <div class="debt-field">
        <label for="debt-balance-${id}">Balance ($)</label>
        <input type="number" id="debt-balance-${id}" placeholder="5,000" min="0" step="100" aria-label="Debt balance in dollars" />
      </div>
      <div class="debt-field">
        <label for="debt-rate-${id}">APR (%)</label>
        <input type="number" id="debt-rate-${id}" placeholder="19.9" min="0" max="100" step="0.1" aria-label="Annual percentage rate" />
      </div>
      <div class="debt-field">
        <label for="debt-min-${id}">Min Payment ($)</label>
        <input type="number" id="debt-min-${id}" placeholder="100" min="0" step="10" aria-label="Minimum monthly payment in dollars" />
      </div>
      <button type="button" class="remove-debt-btn" aria-label="Remove this debt" data-remove="${id}">&times;</button>
    `;
    debtListEl.appendChild(row);
    updateDebtUI();
  }

  function updateDebtUI(): void {
    const rows = debtListEl.querySelectorAll('.debt-row');
    debtCount = rows.length;
    addDebtBtn.disabled = debtCount >= 10;
    limitNote.style.display = debtCount >= 10 ? 'block' : 'none';
    rows.forEach(row => {
      const btn = row.querySelector('.remove-debt-btn') as HTMLButtonElement;
      if (btn) btn.style.display = rows.length <= 1 ? 'none' : 'block';
    });
  }

  debtListEl.addEventListener('click', (e: Event) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('remove-debt-btn')) {
      target.closest('.debt-row')?.remove();
      updateDebtUI();
    }
  });

  addDebtBtn.addEventListener('click', createDebtRow);

  createDebtRow();
  createDebtRow();

  function getDebts(): Debt[] {
    const rows = debtListEl.querySelectorAll('.debt-row');
    const debts: Debt[] = [];
    rows.forEach(row => {
      const id = (row as HTMLElement).dataset.debtId!;
      const name = (document.getElementById(`debt-name-${id}`) as HTMLInputElement).value.trim() || `Debt ${id}`;
      const balance = parseFloat((document.getElementById(`debt-balance-${id}`) as HTMLInputElement).value) || 0;
      const rate = parseFloat((document.getElementById(`debt-rate-${id}`) as HTMLInputElement).value) || 0;
      const minPayment = parseFloat((document.getElementById(`debt-min-${id}`) as HTMLInputElement).value) || 0;
      if (balance > 0 && minPayment > 0) {
        debts.push({ name, balance, rate, minPayment });
      }
    });
    return debts;
  }

  function simulate(debts: Debt[], extra: number, method: 'avalanche' | 'snowball'): SimResult {
    const simDebts: SimDebt[] = debts.map(d => ({
      name: d.name,
      balance: d.balance,
      rate: d.rate,
      minPayment: d.minPayment,
      originalBalance: d.balance,
    }));

    let totalInterest = 0;
    let totalPaid = 0;
    let months = 0;
    const payoffOrder: string[] = [];
    const schedule: MonthRow[] = [];
    const maxMonths = 600;
    let currentExtra = extra;

    while (simDebts.some(d => d.balance > 0.01) && months < maxMonths) {
      months++;
      let monthInterest = 0;
      let monthPrincipal = 0;
      let monthPayment = 0;

      for (const d of simDebts) {
        if (d.balance <= 0) continue;
        const interest = d.balance * (d.rate / 100 / 12);
        d.balance += interest;
        monthInterest += interest;
        totalInterest += interest;
      }

      for (const d of simDebts) {
        if (d.balance <= 0) continue;
        const payment = Math.min(d.minPayment, d.balance);
        d.balance -= payment;
        monthPayment += payment;
        totalPaid += payment;
        monthPrincipal += payment;
      }

      let remaining = currentExtra;
      while (remaining > 0.01) {
        const active = simDebts.filter(d => d.balance > 0.01);
        if (active.length === 0) break;

        let target: SimDebt;
        if (method === 'avalanche') {
          target = active.reduce((a, b) => b.rate > a.rate ? b : a);
        } else {
          target = active.reduce((a, b) => b.balance < a.balance ? b : a);
        }
        const payment = Math.min(remaining, target.balance);
        target.balance -= payment;
        remaining -= payment;
        monthPayment += payment;
        totalPaid += payment;
        monthPrincipal += payment;
      }

      let paidOffThisMonth: string | null = null;
      for (const d of simDebts) {
        if (d.balance <= 0.01 && d.balance >= -0.01 && d.minPayment > 0) {
          d.balance = 0;
          if (!payoffOrder.includes(d.name)) {
            payoffOrder.push(d.name);
            paidOffThisMonth = d.name;
          }
          currentExtra += d.minPayment;
          d.minPayment = 0;
        }
      }

      schedule.push({
        month: months,
        balances: simDebts.map(d => Math.max(0, d.balance)),
        payment: monthPayment,
        interest: monthInterest,
        principal: monthPrincipal - monthInterest,
        paidOff: paidOffThisMonth,
      });
    }

    return { totalInterest, totalPaid, months, payoffOrder, schedule };
  }

  function formatMoney(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function getPayoffDate(months: number): string {
    const d = new Date();
    d.setMonth(d.getMonth() + months);
    return d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  }

  let avSchedule: MonthRow[] = [];
  let sbSchedule: MonthRow[] = [];
  let debtNames: string[] = [];
  let currentTab: 'avalanche' | 'snowball' = 'avalanche';

  calcBtn.addEventListener('click', () => {
    const debts = getDebts();
    if (debts.length === 0) {
      resultsSection.style.display = 'none';
      return;
    }

    const extra = parseFloat(extraPaymentInput.value) || 0;

    const avResult = simulate(debts, extra, 'avalanche');
    const sbResult = simulate(debts, extra, 'snowball');

    avSchedule = avResult.schedule;
    sbSchedule = sbResult.schedule;
    debtNames = debts.map(d => d.name);

    document.getElementById('av-interest')!.textContent = formatMoney(avResult.totalInterest);
    document.getElementById('av-total')!.textContent = formatMoney(avResult.totalPaid);
    document.getElementById('av-months')!.textContent = String(avResult.months);
    document.getElementById('av-date')!.textContent = getPayoffDate(avResult.months);

    document.getElementById('sb-interest')!.textContent = formatMoney(sbResult.totalInterest);
    document.getElementById('sb-total')!.textContent = formatMoney(sbResult.totalPaid);
    document.getElementById('sb-months')!.textContent = String(sbResult.months);
    document.getElementById('sb-date')!.textContent = getPayoffDate(sbResult.months);

    const avOrderEl = document.getElementById('av-order')!;
    const sbOrderEl = document.getElementById('sb-order')!;
    avOrderEl.innerHTML = avResult.payoffOrder.map(n => `<li>${n}</li>`).join('');
    sbOrderEl.innerHTML = sbResult.payoffOrder.map(n => `<li>${n}</li>`).join('');

    const interestDiff = Math.abs(sbResult.totalInterest - avResult.totalInterest);
    const monthsDiff = Math.abs(sbResult.months - avResult.months);
    const highlightEl = document.getElementById('highlight-text')!;

    if (interestDiff < 1 && monthsDiff === 0) {
      highlightEl.textContent = `Both methods cost the same! You'll be debt-free in ${avResult.months} months (${getPayoffDate(avResult.months)}).`;
    } else if (avResult.totalInterest <= sbResult.totalInterest) {
      highlightEl.textContent = `Avalanche saves you ${formatMoney(interestDiff)} in interest${monthsDiff > 0 ? ` and ${monthsDiff} month${monthsDiff > 1 ? 's' : ''}` : ''}! Debt-free by ${getPayoffDate(avResult.months)}.`;
    } else {
      highlightEl.textContent = `Snowball saves you ${formatMoney(interestDiff)} in interest${monthsDiff > 0 ? ` and ${monthsDiff} month${monthsDiff > 1 ? 's' : ''}` : ''}! Debt-free by ${getPayoffDate(sbResult.months)}.`;
    }

    const extraTipCard = document.getElementById('extra-tip-card')!;
    if (extra === 0) {
      const tipResult = simulate(debts, 100, 'avalanche');
      const savedMonths = avResult.months - tipResult.months;
      const savedInterest = avResult.totalInterest - tipResult.totalInterest;
      if (savedMonths > 0) {
        document.getElementById('extra-tip-text')!.textContent =
          `Add just $100 extra/month to be debt-free ${savedMonths} month${savedMonths > 1 ? 's' : ''} sooner and save ${formatMoney(savedInterest)} in interest!`;
        extraTipCard.style.display = 'block';
      } else {
        extraTipCard.style.display = 'none';
      }
    } else {
      extraTipCard.style.display = 'none';
    }

    resultsSection.style.display = 'block';
    document.getElementById('schedule-section')!.style.display = 'none';
    (document.getElementById('toggle-schedule-btn') as HTMLButtonElement).textContent = 'Show Month-by-Month Schedule';

    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  document.getElementById('toggle-schedule-btn')!.addEventListener('click', () => {
    const section = document.getElementById('schedule-section')!;
    const btn = document.getElementById('toggle-schedule-btn')!;
    if (section.style.display === 'none') {
      section.style.display = 'block';
      btn.textContent = 'Hide Month-by-Month Schedule';
      renderSchedule(currentTab);
    } else {
      section.style.display = 'none';
      btn.textContent = 'Show Month-by-Month Schedule';
    }
  });

  document.querySelectorAll('.schedule-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.schedule-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentTab = (tab as HTMLElement).dataset.tab as 'avalanche' | 'snowball';
      renderSchedule(currentTab);
    });
  });

  function renderSchedule(method: 'avalanche' | 'snowball'): void {
    const schedule = method === 'avalanche' ? avSchedule : sbSchedule;
    const thead = document.getElementById('schedule-thead')!;
    const tbody = document.getElementById('schedule-tbody')!;

    thead.innerHTML = `<tr>
      <th>Month</th>
      <th>Payment</th>
      <th>Interest</th>
      ${debtNames.map(n => `<th>${n}</th>`).join('')}
      <th>Event</th>
    </tr>`;

    tbody.innerHTML = schedule.map(row => {
      const isPaidOff = row.paidOff !== null;
      return `<tr class="${isPaidOff ? 'paid-off-row' : ''}">
        <td>${row.month}</td>
        <td>${formatMoney(row.payment)}</td>
        <td>${formatMoney(row.interest)}</td>
        ${row.balances.map(b => `<td>${b > 0 ? formatMoney(b) : 'PAID'}</td>`).join('')}
        <td>${row.paidOff ? `${row.paidOff} paid off!` : ''}</td>
      </tr>`;
    }).join('');
  }
</script>
