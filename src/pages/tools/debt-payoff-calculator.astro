<script>
  const debtInput = document.getElementById('debt-input') as HTMLInputElement;
  const aprInput = document.getElementById('apr-input') as HTMLInputElement;
  const paymentInput = document.getElementById('payment-input') as HTMLInputElement;
  const resultsSection = document.getElementById('results-section')!;
  const warningCard = document.getElementById('warning-card')!;

  function formatCurrency(n: number): string {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function calculate() {
    const debt = parseFloat(debtInput.value) || 0;
    const apr = parseFloat(aprInput.value) || 0;
    const payment = parseFloat(paymentInput.value) || 0;
    const monthlyRate = apr / 100 / 12;

    if (debt <= 0 || payment <= 0) {
      resultsSection.style.display = 'none';
      warningCard.style.display = 'none';
      return;
    }

    // Check if payment covers monthly interest
    const firstMonthInterest = debt * monthlyRate;
    if (payment <= firstMonthInterest) {
      resultsSection.style.display = 'none';
      warningCard.style.display = 'block';
      document.getElementById('warning-text')!.textContent =
        `Your monthly payment ($${payment}) must exceed the monthly interest ($${firstMonthInterest.toFixed(2)}) to make progress on your debt.`;
      return;
    }

    warningCard.style.display = 'none';

    // Calculate month by month
    let balance = debt;
    let totalInterest = 0;
    let months = 0;
    const maxMonths = 1200;
    const monthlyData: { balance: number; totalInterest: number }[] = [];
    monthlyData.push({ balance, totalInterest: 0 });

    while (balance > 0 && months < maxMonths) {
      const interestThisMonth = balance * monthlyRate;
      totalInterest += interestThisMonth;
      balance += interestThisMonth;

      if (balance <= payment) {
        // Final payment
        months++;
        monthlyData.push({ balance: 0, totalInterest });
        balance = 0;
      } else {
        balance -= payment;
        months++;
        monthlyData.push({ balance, totalInterest });
      }
    }

    if (months >= maxMonths) {
      resultsSection.style.display = 'none';
      warningCard.style.display = 'block';
      document.getElementById('warning-text')!.textContent = 'At this rate, payoff would take over 100 years. Try increasing your monthly payment.';
      return;
    }

    const totalPaid = debt + totalInterest;

    // Show results
    resultsSection.style.display = 'block';

    document.getElementById('months-result')!.textContent = months.toString();
    const years = Math.floor(months / 12);
    const remainingMonths = months % 12;
    let timeText = '';
    if (years > 0) timeText += `${years} year${years > 1 ? 's' : ''}`;
    if (years > 0 && remainingMonths > 0) timeText += ' and ';
    if (remainingMonths > 0 || years === 0) timeText += `${remainingMonths} month${remainingMonths !== 1 ? 's' : ''}`;
    document.getElementById('months-tip')!.textContent = `That's about ${timeText}.`;

    document.getElementById('interest-result')!.textContent = formatCurrency(Math.round(totalInterest));
    document.getElementById('total-paid-tip')!.textContent = `Total amount paid: ${formatCurrency(Math.round(totalPaid))}`;

    const debtFreeDate = new Date();
    debtFreeDate.setMonth(debtFreeDate.getMonth() + months);
    document.getElementById('date-result')!.textContent = debtFreeDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

    // Avalanche vs Snowball (with single debt they're the same)
    document.getElementById('av-interest')!.textContent = formatCurrency(Math.round(totalInterest));
    document.getElementById('av-months')!.textContent = months.toString();
    document.getElementById('sb-interest')!.textContent = formatCurrency(Math.round(totalInterest));
    document.getElementById('sb-months')!.textContent = months.toString();

    // Extra payment impact calculation
    const extraCard = document.getElementById('extra-card')!;
    const extraPayment = payment + 100;
    if (extraPayment > payment) {
      let extraBalance = debt;
      let extraTotalInterest = 0;
      let extraMonths = 0;
      while (extraBalance > 0 && extraMonths < maxMonths) {
        const intThisMonth = extraBalance * monthlyRate;
        extraTotalInterest += intThisMonth;
        extraBalance += intThisMonth;
        if (extraBalance <= extraPayment) {
          extraMonths++;
          extraBalance = 0;
        } else {
          extraBalance -= extraPayment;
          extraMonths++;
        }
      }
      const monthsSaved = months - extraMonths;
      const interestSaved = totalInterest - extraTotalInterest;
      if (monthsSaved > 0) {
        extraCard.style.display = 'block';
        document.getElementById('extra-text')!.textContent =
          `If you paid $100 more per month ($${extraPayment.toLocaleString()}), you'd be debt-free ${monthsSaved} month${monthsSaved > 1 ? 's' : ''} sooner and save ${formatCurrency(Math.round(interestSaved))} in interest.`;
      } else {
        extraCard.style.display = 'none';
      }
    }

    // Draw chart
    const chartContainer = document.getElementById('chart-container')!;
    chartContainer.innerHTML = '';
    const maxBars = 60;
    const step = months <= maxBars ? 1 : Math.ceil(months / maxBars);
    const displayData = monthlyData.filter((_, i) => i % step === 0 || i === months);
    const maxVal = debt + totalInterest;

    displayData.forEach(d => {
      const bar = document.createElement('div');
      bar.className = 'chart-bar';
      const balanceHeight = (d.balance / maxVal) * 100;
      const interestHeight = (d.totalInterest / maxVal) * 100;

      const principalDiv = document.createElement('div');
      principalDiv.className = 'bar-principal';
      principalDiv.style.height = `${balanceHeight}%`;

      const interestDiv = document.createElement('div');
      interestDiv.className = 'bar-accum-interest';
      interestDiv.style.height = `${interestHeight}%`;

      bar.appendChild(interestDiv);
      bar.appendChild(principalDiv);
      chartContainer.appendChild(bar);
    });
  }

  [debtInput, aprInput, paymentInput].forEach(el => {
    el.addEventListener('input', calculate);
  });
</script>
